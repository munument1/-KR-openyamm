msgctxt "engine:quests.txt:512:text"
msgid "0"
msgstr "0"

#. assets_dev/engine/data_tables/english/quests.txt record=513 field=text status=translated
msgctxt "engine:quests.txt:513:text"
msgid "Return a red potion to the Judge on Emerald Island."
msgstr "붉은 물약을 에메랄드 섬의 심판관에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=514 field=text status=translated
msgctxt "engine:quests.txt:514:text"
msgid "Return a seashell to the Judge on Emerald Island."
msgstr "조개껍데기를 에메랄드 섬의 심판관에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=515 field=text status=translated
msgctxt "engine:quests.txt:515:text"
msgid "Return a longbow to the Judge on Emerald Island."
msgstr "장궁을 에메랄드 섬의 심판관에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=516 field=text status=translated
msgctxt "engine:quests.txt:516:text"
msgid "Return a floor tile to the Judge on Emerald Island."
msgstr "바닥 타일을 에메랄드 섬의 심판관에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=517 field=text status=translated
msgctxt "engine:quests.txt:517:text"
msgid "Return a musical instrument to the Judge on Emerald Island."
msgstr "악기를 에메랄드 섬의 심판관에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=518 field=text status=translated
msgctxt "engine:quests.txt:518:text"
msgid "Return a wealthy hat to the Judge on Emerald Island."
msgstr "고급 모자를 에메랄드 섬의 심판관에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=528 field=text status=translated
msgctxt "engine:quests.txt:528:text"
msgid "Find the missing contestants on Emerald Island and bring back proof to Lord Markham."
msgstr "에메랄드 섬에서 실종된 참가자들을 찾아 증거를 마크햄 경에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=52 field=text status=translated
msgctxt "engine:quests.txt:52:text"
msgid "Rescue Acwalander, Lord of Water."
msgstr "물의 군주 아크왈랜더를 구출하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=530 field=text status=translated
msgctxt "engine:quests.txt:530:text"
msgid "Go to Lord Markham's estate in Tatalia, steal the vase there, and return it to William Lasker in the Erathian Sewers."
msgstr "타탈리아의 마크햄 경 저택에 들어가 꽃병을 훔친 뒤, 에라시아 하수도의 윌리엄 래스커에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=531 field=text status=translated
msgctxt "engine:quests.txt:531:text"
msgid "Go to Watchtower 6 in the Deyja Moors, and move the weight from the top of the tower to the bottom of the tower.  Then return to William Lasker in the Erathian Sewers."
msgstr "데이자 황무지의 제6 감시탑에서 탑 꼭대기의 추를 아래층으로 옮긴 뒤, 에라시아 하수도의 윌리엄 래스커에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=533 field=text status=translated
msgctxt "engine:quests.txt:533:text"
msgid "Go to the Celestial Court in Celeste and kill Lady Eleanor Carmine.  Return with proof to Seknit Undershadow in the Deyja Moors."
msgstr "셀레스트의 천상 법정으로 가서 엘리너 카마인 부인을 처치한 뒤, 증거를 데이자 황무지의 세크닛 언더섀도에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=534 field=text status=translated
msgctxt "engine:quests.txt:534:text"
msgid "Kill Wromthrax the Heartless in his cave in Tatalia, then talk to Sir Charles Quixote."
msgstr "타탈리아의 동굴에 있는 무정한 웜스랙스를 처치한 뒤 찰스 키호테 경과 대화하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=536 field=text status=translated
msgctxt "engine:quests.txt:536:text"
msgid "Rescue Alice Hargreaves from William's Tower in the Deyja Moors then talk to Sir Charles Quixote."
msgstr "데이자 황무지의 윌리엄의 탑에서 앨리스 하그리브스를 구출한 뒤 찰스 키호테 경과 대화하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=538 field=text status=translated
msgctxt "engine:quests.txt:538:text"
msgid "Capture Alice Hargreaves from her residence in Castle Gryphonheart and return her to William's Tower in the Deyja Moors."
msgstr "그리폰하트 성의 거처에서 앨리스 하그리브스를 붙잡아 데이자 황무지의 윌리엄의 탑으로 데려가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=539 field=text status=translated
msgctxt "engine:quests.txt:539:text"
msgid "Find the lost meditation spot in the Dwarven Barrows."
msgstr "드워프 고분에서 잊힌 명상 장소를 찾으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=540 field=text status=translated
msgctxt "engine:quests.txt:540:text"
msgid "Go to the Temple of Baa in Avlee and kill the High Priest of Baa, then return to Bartholomew Hume in Harmondale."
msgstr "아블리의 바 신전으로 가서 바의 대사제를 처치한 뒤, 하몬데일의 바솔로뮤 흄에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=541 field=text status=translated
msgctxt "engine:quests.txt:541:text"
msgid "Crack the code in the School of Sorcery in the Bracada Desert to reveal the location of the Tomb of Ashwar Nog'Nogoth.  Discover the tomb's location, enter it, and then return it to Stephan Sand in the Pit."
msgstr "브라카다 사막의 마법 학교에서 암호를 풀어 아슈와르 노그노고스의 무덤 위치를 밝혀내십시오. 무덤에 들어간 뒤 구덩이의 스테판 샌드에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=542 field=text status=translated
msgctxt "engine:quests.txt:542:text"
msgid "Retrieve the Perfect Bow from the Titans' Stronghold in Avlee and return it to Lawrence Mark in Harmondale."
msgstr "아블리의 타이탄 요새에서 완벽한 활을 되찾아 하몬데일의 로렌스 마크에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=543 field=text status=translated
msgctxt "engine:quests.txt:543:text"
msgid "Sabotage the lift in the Red Dwarf Mines in the Bracada Desert then return to Steagal Snick in Avlee."
msgstr "브라카다 사막의 레드 드워프 광산에서 승강기를 파괴한 뒤 아블리의 스티걸 스닉에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=544 field=text status=translated
msgctxt "engine:quests.txt:544:text"
msgid "Retrieve the Perfect Bow from the Titans' Stronghold in Avlee and return it to Steagal Snick in Avlee."
msgstr "아블리의 타이탄 요새에서 완벽한 활을 되찾아 아블리의 스티걸 스닉에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=545 field=text status=translated
msgctxt "engine:quests.txt:545:text"
msgid "Win five arena challenges then return to Leda Rowan in the Bracada Desert."
msgstr "투기장 도전에서 다섯 번 승리한 뒤 브라카다 사막의 레다 로언에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=546 field=text status=translated
msgctxt "engine:quests.txt:546:text"
msgid "Destroy all the undead in the Haunted House in the Barrow Downs and return to Frederick Org in Erathia."
msgstr "배로우 다운스의 유령의 집에서 모든 언데드를 처치한 뒤 에라시아의 프레더릭 오그에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=547 field=text status=translated
msgctxt "engine:quests.txt:547:text"
msgid "Raid the Elven Treasury at Castle Navan in the Tularean Forest and return to Frederick Org in Erathia."
msgstr "툴라리안 숲의 나반 성에 있는 엘프 보물고를 약탈한 뒤 에라시아의 프레더릭 오그에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=548 field=text status=translated
msgctxt "engine:quests.txt:548:text"
msgid "Calm the trees in the Tularean Forest by speaking to the Oldest Tree then return to Lysander Sweet in the Bracada Desert."
msgstr "최고령 나무와 대화하여 툴라리안 숲의 나무들을 진정시킨 뒤 브라카다 사막의 라이샌더 스위트에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=549 field=text status=translated
msgctxt "engine:quests.txt:549:text"
msgid "Solve the secret to the entrance of the Faerie Mound in Avlee and speak to the Faerie King."
msgstr "아블리의 요정 언덕으로 들어가는 비밀을 풀고 요정 왕과 대화하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=54 field=text status=translated
msgctxt "engine:quests.txt:54:text"
msgid "Rescue Shalwend, Lord of Air."
msgstr "공기의 군주 샬웬드를 구출하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=550 field=text status=translated
msgctxt "engine:quests.txt:550:text"
msgid "Collect 10,000 gold worth of bounties from the Bounty Hunts in the town halls, then return to Ebednezer Sower in the Tularean Forest."
msgstr "마을 회관의 현상금 사냥으로 총 10,000골드의 현상금을 받은 뒤 툴라리안 숲의 에브니저 소어에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=551 field=text status=translated
msgctxt "engine:quests.txt:551:text"
msgid "Find the Heart of the Forest in the Mercenary Guild in Tatalia and return it to the Oldest Tree in the Tularean Forest."
msgstr "타탈리아의 용병 길드에서 숲의 심장을 찾아 툴라리안 숲의 최고령 나무에게 돌려주십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=554 field=text status=translated
msgctxt "engine:quests.txt:554:text"
msgid "Purify the Altar of Evil in the Temple of the Moon on Evenmorn Isle then return to Rebecca Devine in Celeste."
msgstr "이븐모른 섬 달의 신전에 있는 악의 제단을 정화한 뒤 셀레스트의 레베카 디바인에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=555 field=text status=translated
msgctxt "engine:quests.txt:555:text"
msgid "Find the lost pirate map in the Tidewater Caverns in Tatalia and return to Daedalus Falk in the Deyja Moors."
msgstr "타탈리아의 타이드워터 동굴에서 잃어버린 해적 지도를 찾아 데이자 황무지의 다이달로스 포크에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=556 field=text status=translated
msgctxt "engine:quests.txt:556:text"
msgid "Deface the Altar of Good in the Temple of the Sun on Evenmorn Isle then return to Daedalus Falk in the Deyja Moors."
msgstr "이븐모른 섬 태양의 신전에 있는 선의 제단을 훼손한 뒤 데이자 황무지의 다이달로스 포크에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=557 field=text status=translated
msgctxt "engine:quests.txt:557:text"
msgid "Collect the six golem pieces and construct a complete golem, then return to Thomas Grey in the School of Sorcery."
msgstr "골렘 부품 여섯 개를 모아 완전한 골렘을 제작한 뒤 마법 학교의 토머스 그레이에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=559 field=text status=translated
msgctxt "engine:quests.txt:559:text"
msgid "Find the Book of Divine Intervention in the Breeding Zone in the Pit and return it to Thomas Grey in the School of Sorcery."
msgstr "구덩이의 번식 구역에서 신성한 개입의 책을 찾아 마법 학교의 토머스 그레이에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=560 field=text status=translated
msgctxt "engine:quests.txt:560:text"
msgid "Retrieve the lich jars from the Proving Grounds in Celeste and bring them back to Halfgild Wynac in the Pit."
msgstr "셀레스트의 시험장에서 리치의 단지들을 되찾아 구덩이의 하프길드 위낙에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=561 field=text status=translated
msgctxt "engine:quests.txt:561:text"
msgid "Visit the three stonehenge monoliths in Tatalia, the Evenmorn Islands, and Avlee, then return to Anthony Green in the Tularean Forest."
msgstr "타탈리아, 이븐모른 제도, 아블리에 있는 세 곳의 스톤헨지 거석을 방문한 뒤 툴라리안 숲의 앤서니 그린에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=566 field=text status=translated
msgctxt "engine:quests.txt:566:text"
msgid "Retrieve the bones of the Dwarf King from the tunnels between Stone City and Nighon and place them in their proper resting place in the Barrow Downs, then return to Anthony Green in the Tularean Forest."
msgstr "스톤 시티와 나이혼 사이의 터널에서 드워프 왕의 유골을 되찾아 배로우 다운스의 올바른 안식처에 안치한 뒤 툴라리안 숲의 앤서니 그린에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=567 field=text status=translated
msgctxt "engine:quests.txt:567:text"
msgid "Retrieve the dragon egg from the Dragon Cave in the Land of the Giants and return it to Tor Anwyn in Mount Nighon."
msgstr "거인들의 땅에 있는 드래곤 동굴에서 드래곤 알을 되찾아 나이혼 산의 토르 앤윈에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=587 field=text status=translated
msgctxt "engine:quests.txt:587:text"
msgid "Clean out Castle Harmondale and return to the Butler in the tavern, On the House, in Harmondale."
msgstr "하몬데일 성을 소탕한 뒤 하몬데일의 '온 더 하우스' 선술집에 있는 집사에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=588 field=text status=translated
msgctxt "engine:quests.txt:588:text"
msgid "Rescue the dwarves from the Red Dwarf Mines and return to the Dwarf King in Stone City in the Barrow Downs."
msgstr "레드 드워프 광산에서 드워프들을 구출한 뒤 배로우 다운스의 스톤 시티에 있는 드워프 왕에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=589 field=text status=translated
msgctxt "engine:quests.txt:589:text"
msgid "Retrieve plans from Fort Riverstride and return them to Eldrich Parson in Castle Navan in the Tularean Forest."
msgstr "리버스트라이드 요새에서 작전 계획서를 되찾아 툴라리안 숲 나반 성의 엘드리치 파슨에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=590 field=text status=translated
msgctxt "engine:quests.txt:590:text"
msgid "Rescue Loren Steel from the Tularean Caves in the Tularean Forest and return him to Queen Catherine."
msgstr "툴라리안 숲의 툴라리안 동굴에서 로렌 스틸을 구출해 캐서린 여왕에게 데려가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=591 field=text status=translated
msgctxt "engine:quests.txt:591:text"
msgid "Retrieve Gryphonheart's Trumpet from the battle in the Tularean Forest and return it to whichever side you choose."
msgstr "툴라리안 숲의 전장에서 그리폰하트의 나팔을 되찾아 원하는 진영에 전달하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=5 field=text status=translated
msgctxt "engine:quests.txt:5:text"
msgid "Kill the leader of the Regnan Pirate outpost at Dagger Wound."
msgstr "대거 운드의 레그나 해적 전초기지 우두머리를 처치하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=606 field=text status=translated
msgctxt "engine:quests.txt:606:text"
msgid "Give false Riverstride plans to Eldrich Parson in Castle Navan in the Tularean Forest."
msgstr "가짜 리버스트라이드 작전 계획서를 툴라리안 숲 나반 성의 엘드리치 파슨에게 전달하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=607 field=text status=translated
msgctxt "engine:quests.txt:607:text"
msgid "Return the Loren imposter to Queen Catherine in Castle Gryphonheart in Erathia."
msgstr "가짜 로렌을 에라시아 그리폰하트 성의 캐서린 여왕에게 데려가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=613 field=text status=translated
msgctxt "engine:quests.txt:613:text"
msgid "Complete the Walls of Mist without killing a single opponent and return to Gavin Magnus in Castle Lambent in Celeste."
msgstr "단 한 명의 적도 죽이지 않고 안개의 장벽을 완료한 뒤 셀레스트 램번트 성의 개빈 매그너스에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=615 field=text status=translated
msgctxt "engine:quests.txt:615:text"
msgid "Retrieve the altar piece from the Temple of Light in Celeste and the Temple of Dark in the Pit and return them to Resurectra in Castle Lambent in Celeste."
msgstr "셀레스트의 빛의 신전과 구덩이의 어둠의 신전에서 제단 조각을 되찾아 셀레스트 램번트 성의 리저렉트라에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=616 field=text status=translated
msgctxt "engine:quests.txt:616:text"
msgid "Go to Colony Zod in the Land of the Giants and slay Xenofex then return to Resurectra in Castle Lambent in Celeste."
msgstr "거인들의 땅에 있는 조드 식민지로 가서 제노펙스를 처치한 뒤 셀레스트 램번트 성의 리저렉트라에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=618 field=text status=translated
msgctxt "engine:quests.txt:618:text"
msgid "Investigate the Wine Cellar in Tatalia and return to Crag Hack in Castle Lambent in Celeste."
msgstr "타탈리아의 와인 저장고를 조사한 뒤 셀레스트 램번트 성의 크랙 핵에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=61 field=text status=translated
msgctxt "engine:quests.txt:61:text"
msgid "Put Vilebite's ashes in the Dust village tomb then return to Overdune."
msgstr "바일바이트의 재를 더스트 마을의 무덤에 안치한 뒤 오버듄에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=620 field=text status=translated
msgctxt "engine:quests.txt:620:text"
msgid "Retrieve the Case of Soul Jars from Castle Gloaming in the Pit and return to Sir Caneghem in Celeste."
msgstr "구덩이의 글로밍 성에서 영혼 단지 상자를 되찾아 셀레스트의 캐니검 경에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=621 field=text status=translated
msgctxt "engine:quests.txt:621:text"
msgid "Assassinate Tolberti in his house in the Pit and return his control cube to Robert the Wise in Celeste."
msgstr "구덩이에 있는 톨베르티의 집에서 그를 암살하고, 제어 큐브를 셀레스트의 현자 로버트에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=634 field=text status=translated
msgctxt "engine:quests.txt:634:text"
msgid "Retrieve the altar piece from the Temple of Light in Celeste and the Temple of Dark in the Pit and return them to Kastore in the Pit."
msgstr "셀레스트의 빛의 신전과 구덩이의 어둠의 신전에서 제단 조각을 되찾아 구덩이의 카스토어에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=635 field=text status=translated
msgctxt "engine:quests.txt:635:text"
msgid "Go to Colony Zod in the Land of the Giants and slay Xenofex then return to Kastore in the Pit."
msgstr "거인들의 땅에 있는 조드 식민지로 가서 제노펙스를 처치한 뒤 구덩이의 카스토어에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=636 field=text status=translated
msgctxt "engine:quests.txt:636:text"
msgid "Retrieve the Case of Soul Jars from the Warlocks in Thunderfist Mountain and bring them to Maximus in the Pit."
msgstr "썬더피스트 산의 흑마법사들에게서 영혼 단지 상자를 되찾아 구덩이의 막시무스에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=637 field=text status=translated
msgctxt "engine:quests.txt:637:text"
msgid "Destroy the magical defenses inside Clanker's Laboratory and return to Dark Shade in the Pit."
msgstr "클랭커의 연구소 내부에 있는 마법 방어 장치를 파괴한 뒤 구덩이의 다크 셰이드에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=639 field=text status=translated
msgctxt "engine:quests.txt:639:text"
msgid "Assassinate Robert the Wise in his house in Celeste and return to Tolberti in the Pit."
msgstr "셀레스트에 있는 현자 로버트의 집에서 그를 암살한 뒤 구덩이의 톨베르티에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=640 field=text status=translated
msgctxt "engine:quests.txt:640:text"
msgid "Complete the Breeding Zone and return to Archibald in the Pit."
msgstr "번식 구역을 완료한 뒤 구덩이의 아치볼드에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=642 field=text status=translated
msgctxt "engine:quests.txt:642:text"
msgid "Go to the Lincoln in the sea west of Avlee and retrieve the Oscillation Overthruster and return it to Resurectra in Celeste."
msgstr "아블리 서쪽 바다의 링컨호로 가서 오실레이션 오버스러스터를 되찾아 셀레스트의 리저렉트라에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=643 field=text status=translated
msgctxt "engine:quests.txt:643:text"
msgid "Go to the Lincoln in the sea west of Avlee and retrieve the Oscillation Overthruster and return it to Kastore in the Pit."
msgstr "아블리 서쪽 바다의 링컨호로 가서 오실레이션 오버스러스터를 되찾아 구덩이의 카스토어에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=658 field=text status=translated
msgctxt "engine:quests.txt:658:text"
msgid "Talk to the Dwarves in Stone City in the Barrow Downs to find a way to repair Castle Harmondale."
msgstr "하몬데일 성을 수리할 방법을 찾기 위해 배로우 다운스의 스톤 시티에 있는 드워프들과 대화하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=663 field=text status=translated
msgctxt "engine:quests.txt:663:text"
msgid "Enter the Pit from the Hall of the Pit in the Deyja Moors, then talk to Archibald in Castle Gloaming in the Pit."
msgstr "데이자 황무지의 구덩이 전당에서 구덩이로 들어간 뒤, 구덩이 글로밍 성의 아치볼드와 대화하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=664 field=text status=translated
msgctxt "engine:quests.txt:664:text"
msgid "Enter Celeste from the grand teleporter in the Bracada Desert, then talk to Gavin Magnus in Castle Lambent in Celeste."
msgstr "브라카다 사막의 대형 순간이동 장치로 셀레스트에 들어간 뒤, 셀레스트 램번트 성의 개빈 매그너스와 대화하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=665 field=text status=translated
msgctxt "engine:quests.txt:665:text"
msgid "Choose a judge to succeed Judge Grey as Arbiter in Harmondale."
msgstr "그레이 판관의 뒤를 이어 하몬데일의 중재자가 될 판관을 선택하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=667 field=text status=translated
msgctxt "engine:quests.txt:667:text"
msgid "Retrieve the Lantern of Light from the Barrow Downs and return it to Tarin Withern in Harmondale."
msgstr "배로우 다운스에서 빛의 등불을 되찾아 하몬데일의 타린 위던에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=668 field=text status=translated
msgctxt "engine:quests.txt:668:text"
msgid "Retrieve Haldar's Remains from the Maze in Nighon and return them to Mazim Dusk in Nighon."
msgstr "나이혼의 미궁에서 할다르의 유해를 되찾아 나이혼의 마짐 더스크에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=669 field=text status=translated
msgctxt "engine:quests.txt:669:text"
msgid "Retrieve Davrik's Signet ring from the Bandit Caves in the northeast of Erathia and return it to Davrik Peladium in Harmondale."
msgstr "에라시아 북동부 산적 동굴에서 다브릭의 인장 반지를 되찾아 하몬데일의 다브릭 펠라디움에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=670 field=text status=translated
msgctxt "engine:quests.txt:670:text"
msgid "Take Sealed Letter to Lord Markham in Lord Markham's Manor in Tatalia for collector Norbert Thrush."
msgstr "수집가 노버트 스러시를 위해 봉인된 편지를 타탈리아 마크햄 경 저택의 마크햄 경에게 전달하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=671 field=text status=translated
msgctxt "engine:quests.txt:671:text"
msgid "Return Parson's Quill to Norbert Thrush in Erathia."
msgstr "파슨의 깃펜을 에라시아의 노버트 스러시에게 돌려주십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=68 field=text status=translated
msgctxt "engine:quests.txt:68:text"
msgid "Find the Ancient Troll Homeland and return to Volog Sandwind in the Ironsand Desert."
msgstr "고대 트롤의 고향을 찾아 아이언샌드 사막의 볼로그 샌드윈드에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=691 field=text status=translated
msgctxt "engine:quests.txt:691:text"
msgid "Take the sealed letter to the Faerie King in the Hall under the Hill in Avlee."
msgstr "봉인된 편지를 아블리 언덕 아래 전당의 요정 왕에게 전달하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=692 field=text status=translated
msgctxt "engine:quests.txt:692:text"
msgid "Take the Faerie Pipes to Johann Kerrid in the Tularean Forest."
msgstr "요정의 피리를 툴라리안 숲의 요한 케리드에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=693 field=text status=translated
msgctxt "engine:quests.txt:693:text"
msgid "Go to the Mercenary Guild in Tatalia and talk to Niles Stantley within two weeks."
msgstr "2주 안에 타탈리아의 용병 길드로 가서 나일스 스탠틀리와 대화하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=694 field=text status=translated
msgctxt "engine:quests.txt:694:text"
msgid "Steal the Tapestry from your associate's Castle and return it to Niles Stantley in the Mercenary Guild in Tatalia."
msgstr "동료의 성에서 태피스트리를 훔쳐 타탈리아 용병 길드의 나일스 스탠틀리에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=698 field=text status=translated
msgctxt "engine:quests.txt:698:text"
msgid "Kill all the Troglodytes underneath Stone City and return to Spark Burnkindle in Stone City."
msgstr "스톤 시티 아래의 모든 트로글로다이트를 처치한 뒤 스톤 시티의 스파크 번킨들에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=699 field=text status=translated
msgctxt "engine:quests.txt:699:text"
msgid "Kill all the Griffins in Erathia and the Bracada Desert and return to Seth Drakkson in the Deyja Moors."
msgstr "에라시아와 브라카다 사막의 모든 그리핀을 처치한 뒤 데이자 황무지의 세스 드랙슨에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=706 field=text status=translated
msgctxt "engine:quests.txt:706:text"
msgid "Find the fate of Darron's brother in the White Cliff Caves, then return to Darron Temper in Harmondale."
msgstr "화이트 클리프 동굴에서 대런의 형제에게 무슨 일이 있었는지 알아낸 뒤 하몬데일의 대런 템퍼에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=707 field=text status=translated
msgctxt "engine:quests.txt:707:text"
msgid "Retrieve the Seasons' Stole from the Hall of the Pit and return it to Gary Zimm in the Bracada Desert."
msgstr "구덩이 전당에서 사계절의 영대를 되찾아 브라카다 사막의 게리 짐에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=70 field=text status=translated
msgctxt "engine:quests.txt:70:text"
msgid "Find Blazen Stormlance and recover the spear Ebonest. Return to Leane Stormlance in Garrote Gorge and deliver Ebonest to Charles Quixote."
msgstr "블레이즌 스톰랜스를 찾아 창 에보니스트를 되찾으십시오. 가로트 협곡의 리앤 스톰랜스에게 돌아간 뒤 에보니스트를 찰스 키호테에게 전달하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=712 field=text status=translated
msgctxt "engine:quests.txt:712:text"
msgid "Retrieve the three statuettes and place them on the shrines in the Bracada Desert, Tatalia, and Avlee, then return to Thom Lumbra in the Tularean Forest."
msgstr "조각상 세 개를 되찾아 브라카다 사막, 타탈리아, 아블리의 성소에 각각 놓은 뒤 툴라리안 숲의 톰 럼브라에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=716 field=text status=translated
msgctxt "engine:quests.txt:716:text"
msgid "Retrieve the three paintings and return them to Ferdinand Visconti in Tatalia."
msgstr "그림 세 점을 되찾아 타탈리아의 페르디난드 비스콘티에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=717 field=text status=translated
msgctxt "engine:quests.txt:717:text"
msgid "Win a game of Arcomage in all thirteen taverns, then return to Gina Barnes in Erathia."
msgstr "열세 곳의 선술집에서 모두 아르코메이지에 승리한 뒤 에라시아의 지나 반스에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=72 field=text status=translated
msgctxt "engine:quests.txt:72:text"
msgid "Inquire about a cure for Blazen Stormlance from Dervish Chevron in Ravenshore."
msgstr "레이븐쇼어의 더비시 셰브론에게 블레이즌 스톰랜스의 치료법을 물어보십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=74 field=text status=translated
msgctxt "engine:quests.txt:74:text"
msgid "Kill all Dragon Slayers and return the Sword of Whistlebone the Slayer to Deftclaw Redreaver in Garrote Gorge."
msgstr "모든 드래곤 슬레이어를 처치하고 휘슬본 슬레이어의 검을 가로트 협곡의 데프트클로 레드리버에게 돌려주십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=757 field=text status=translated
msgctxt "engine:quests.txt:757:text"
msgid "Congratulations"
msgstr "축하합니다"

#. assets_dev/engine/data_tables/english/quests.txt record=76 field=text status=translated
msgctxt "engine:quests.txt:76:text"
msgid "Find the Axe of Balthazar, in the Dark Dwarf Mines.  Have the Axe authenticated by Dadeross.  Return the axe to Tessalar, heir to the leadership of the Minotaur Herd."
msgstr "다크 드워프 광산에서 발타자르의 도끼를 찾으십시오. 다데로스에게 도끼의 진품 여부를 확인받은 뒤 미노타우로스 무리의 후계자 테살라에게 돌려주십시오."

