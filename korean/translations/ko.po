#. assets_dev/engine/data_tables/items.txt record=602 field=Name status=translated
msgctxt "engine:items.txt:602:Name"
msgid "False Report"
msgstr "허위 보고서"

#. assets_dev/engine/data_tables/items.txt record=602 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:602:NotIdentifiedName"
msgid "Report"
msgstr "보고서"

#. assets_dev/engine/data_tables/items.txt record=602 field=Notes status=translated
msgctxt "engine:items.txt:602:Notes"
msgid "Quest Item: A letter given to you by Arion Hunter for delivery to the Dread Pirate Stanley on Regna."
msgstr "퀘스트 아이템: 아리온 헌터가 레그나에 있는 드레드 해적 스탠리에게 전달해 달라고 준 편지."

#. assets_dev/engine/data_tables/items.txt record=603 field=Name status=translated
msgctxt "engine:items.txt:603:Name"
msgid "Urn of Ashes"
msgstr "유골 항아리"

#. assets_dev/engine/data_tables/items.txt record=603 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:603:NotIdentifiedName"
msgid "Urn"
msgstr "유골함"

#. assets_dev/engine/data_tables/items.txt record=603 field=Notes status=translated
msgctxt "engine:items.txt:603:Notes"
msgid "Quest Item: A funerary urn entrusted to your care by the Troll, Overdune Snapfinger. It contains the ashes of his brother, Vilebite."
msgstr "퀘스트 아이템: 트롤 오버듄 스냅핑거가 당신에게 맡긴 장례용 항아리. 그 안에는 그의 형제인 바일바이트의 유골이 들어 있습니다."

#. assets_dev/engine/data_tables/items.txt record=604 field=Name status=translated
msgctxt "engine:items.txt:604:Name"
msgid "Nightshade Brazier"
msgstr "나이트셰이드 화로"

#. assets_dev/engine/data_tables/items.txt record=604 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:604:NotIdentifiedName"
msgid "Brazier"
msgstr "화로"

#. assets_dev/engine/data_tables/items.txt record=604 field=Notes status=translated
msgctxt "engine:items.txt:604:Notes"
msgid "Quest Item: This brazier emanates the unsettling vibrancy of dark magic. It smells strongly of pitch and sulfur."
msgstr "퀘스트 아이템: 이 화로는 어둠의 마법이 지닌 섬뜩한 기운을 내뿜고 있다. 역청과 유황 냄새가 강하게 난다."

#. assets_dev/engine/data_tables/items.txt record=605 field=Name status=translated
msgctxt "engine:items.txt:605:Name"
msgid "Dragon Leader's Egg"
msgstr "드래곤 우두머리의 알"

#. assets_dev/engine/data_tables/items.txt record=605 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:605:NotIdentifiedName"
msgid "Egg"
msgstr "알"

#. assets_dev/engine/data_tables/items.txt record=605 field=Notes status=translated
msgctxt "engine:items.txt:605:Notes"
msgid "Quest Item: This Dragon egg is nearly ready to hatch. The small life inside makes its presence known with an occasional rustle."
msgstr "퀘스트 아이템: 이 드래곤의 알은 곧 부화할 것 같습니다. 알 속의 작은 생명체가 가끔 바스락거리는 소리로 존재를 알립니다."

#. assets_dev/engine/data_tables/items.txt record=606 field=Name status=translated
msgctxt "engine:items.txt:606:Name"
msgid "Heart of Fire"
msgstr "불의 심장"

#. assets_dev/engine/data_tables/items.txt record=606 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:606:NotIdentifiedName"
msgid "Heartstone"
msgstr "심장석"

#. assets_dev/engine/data_tables/items.txt record=606 field=Notes status=translated
msgctxt "engine:items.txt:606:Notes"
msgid "Quest Item: The Heart of Fire is a gem of pure elemental force clear of imperfections and weighing at least a hundred carets. No doubt, a magic item made from it would be incredibly potent."
msgstr "퀘스트 아이템: 불의 심장은 순수한 원소의 힘으로 이루어진 보석으로, 흠집 하나 없이 깨끗하며 무게는 최소 100캐럿에 달합니다. 이 보석으로 만든 마법 아이템은 틀림없이 엄청난 위력을 지닐 것입니다."

#. assets_dev/engine/data_tables/items.txt record=607 field=Name status=translated
msgctxt "engine:items.txt:607:Name"
msgid "Heart of Water"
msgstr "물의 심장"

