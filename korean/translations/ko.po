msgstr "더 빠른 회복 속도, 전기 불꽃 7개"

#. assets_dev/engine/data_tables/spells.txt record=15 field=Normal status=translated
msgctxt "engine:spells.txt:15:Normal"
msgid "Moderate recovery rate, 3 sparks"
msgstr "보통 회복 속도, 전기 불꽃 3개"

