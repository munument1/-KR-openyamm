msgstr "허리띠"

#. assets_dev/engine/data_tables/items.txt record=1451 field=Notes status=translated
msgctxt "engine:items.txt:1451:Notes"
msgid "Quest Item:  This belt is worn to the point where it should only last about an hour.  Hopefully, that will be long enough."
msgstr "퀘스트 아이템: 이 벨트는 너무 닳아서 이제 한 시간 정도밖에 못 버틸 것 같습니다. 그 정도면 충분하겠죠."

#. assets_dev/engine/data_tables/items.txt record=1452 field=Name status=translated
