#. assets_dev/engine/data_tables/english/skill_des.txt record=Mace field=Description status=translated
msgctxt "engine:english/skill_des.txt:Mace:Description"
msgid "Mace skill covers all kinds of blunt trauma weapons ranging from large clubs to flails.  Expert mace swingers do extra damage with their weapons. Masters and grandmasters can stun or paralyze their opponents."
msgstr "메이스 기술은 큰 곤봉부터 철퇴까지 다양한 둔기류를 다룹니다. 전문가는 무기로 추가 피해를 주며, 마스터와 그랜드마스터는 적을 기절시키거나 마비시킬 수 있습니다."

#. assets_dev/engine/data_tables/english/skill_des.txt record=Mace field=DisplayName status=translated
msgctxt "engine:english/skill_des.txt:Mace:DisplayName"
msgid "Mace"
msgstr "메이스"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Mace field=Expert status=translated
msgctxt "engine:english/skill_des.txt:Mace:Expert"
msgid "Skill added to Attack Damage"
msgstr "공격 피해에 기술 수치 추가"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Mace field=GrandMaster status=translated
msgctxt "engine:english/skill_des.txt:Mace:GrandMaster"
msgid "Chance to paralyze equal to skill."
msgstr "기술 수치만큼 마비 확률 증가"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Mace field=Master status=translated
msgctxt "engine:english/skill_des.txt:Mace:Master"
msgid "Chance to stun equal to skill"
msgstr "기술 수치만큼 기절 확률 증가"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Mace field=Normal status=translated
msgctxt "engine:english/skill_des.txt:Mace:Normal"
msgid "Skill added to Attack Bonus"
msgstr "공격 보너스에 기술 수치 추가"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Meditation field=Description status=translated
msgctxt "engine:english/skill_des.txt:Meditation:Description"
msgid "Meditation skill adds spell points directly to your characters' spell point totals.  Spell points gained are equal to a character's Base Spell Points/Level times skill. Expert ranking doubles this total and master triples it."
msgstr "명상 기술은 캐릭터의 총 주문력에 직접 주문력을 더합니다. 증가량은 캐릭터의 '레벨당 기본 주문력 × 기술 수치'와 같습니다. 전문가가 되면 이 증가량이 두 배, 마스터는 세 배가 됩니다."

#. assets_dev/engine/data_tables/english/skill_des.txt record=Meditation field=DisplayName status=translated
msgctxt "engine:english/skill_des.txt:Meditation:DisplayName"
msgid "Meditation"
msgstr "명상"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Meditation field=Expert status=translated
msgctxt "engine:english/skill_des.txt:Meditation:Expert"
msgid "Double effect of skill"
msgstr "기술 효과 2배"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Meditation field=GrandMaster status=translated
msgctxt "engine:english/skill_des.txt:Meditation:GrandMaster"
msgid "Quintuple effect of skill"
msgstr "기술 효과 5배"

