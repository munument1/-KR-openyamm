#. assets_dev/engine/data_tables/items.txt record=1403 field=Name status=translated
msgctxt "engine:items.txt:1403:Name"
msgid "Lich Jar"
msgstr "리치 항아리"

#. assets_dev/engine/data_tables/items.txt record=1403 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1403:NotIdentifiedName"
msgid "Jar"
msgstr "항아리"

#. assets_dev/engine/data_tables/items.txt record=1403 field=Notes status=translated
msgctxt "engine:items.txt:1403:Notes"
msgid "Quest Item:  A jar holding your physical and spiritual essence.  Don't lose the jar."
msgstr "퀘스트 아이템: 당신의 육체적, 정신적 정수를 담은 항아리. 항아리를 잃어버리지 마세요."

#. assets_dev/engine/data_tables/items.txt record=1404 field=Name status=translated
msgctxt "engine:items.txt:1404:Name"
msgid "Case of Soul Jars"
msgstr "영혼 항아리 상자"

#. assets_dev/engine/data_tables/items.txt record=1404 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1404:NotIdentifiedName"
msgid "Case of Jars"
msgstr "항아리 상자"

#. assets_dev/engine/data_tables/items.txt record=1404 field=Notes status=translated
msgctxt "engine:items.txt:1404:Notes"
msgid "Quest Item:  A rosewood case lovingly crafted to contain a set of Lich Jars.  This case appears to be full."
msgstr "퀘스트 아이템: 리치 항아리 세트를 담기 위해 정성스럽게 제작된 장미목 케이스. 케이스는 가득 차 있는 것으로 보입니다."

#. assets_dev/engine/data_tables/items.txt record=1405 field=Name status=translated
msgctxt "engine:items.txt:1405:Name"
msgid "Parson's Quill"
msgstr "파슨의 깃펜"

#. assets_dev/engine/data_tables/items.txt record=1405 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1405:NotIdentifiedName"
msgid "Quill"
msgstr "깃펜"

#. assets_dev/engine/data_tables/items.txt record=1405 field=Notes status=translated
msgctxt "engine:items.txt:1405:Notes"
msgid "Quest Item:  King Parson's hand employed this quill to sign the treaty ending the first Timber War."
msgstr "퀘스트 아이템: 파슨 왕은 이 깃펜으로 제1차 목재 전쟁을 종식시키는 조약에 서명했습니다."

#. assets_dev/engine/data_tables/items.txt record=1406 field=Name status=translated
msgctxt "engine:items.txt:1406:Name"
msgid "Wetsuit"
msgstr "잠수복"

#. assets_dev/engine/data_tables/items.txt record=1406 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1406:NotIdentifiedName"
msgid "Strange Suit"
msgstr "기묘한 의복"

#. assets_dev/engine/data_tables/items.txt record=1406 field=Notes status=translated
msgctxt "engine:items.txt:1406:Notes"
msgid "Quest Item:  This environmental suit handles not only respiration, but protection from the extreme pressure of deep sea diving.  It does not look like any other items may be worn while wearing the suit.  You must remove ALL equipment to wear the suit."
msgstr "퀘스트 아이템: 이 환경 보호복은 호흡뿐만 아니라 심해 잠수의 극한 압력으로부터 몸을 보호해줍니다. 보호복 착용 시에는 다른 장비를 착용할 수 없어 보입니다. 보호복을 착용하려면 모든 장비를 벗어야 합니다."

#. assets_dev/engine/data_tables/items.txt record=1407 field=Name status=translated
msgctxt "engine:items.txt:1407:Name"
msgid "Oscillation Overthruster"
msgstr "오실레이션 오버스러스터"

#. assets_dev/engine/data_tables/items.txt record=1407 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1407:NotIdentifiedName"
msgid "Ancient Part"
msgstr "고대 부품"

#. assets_dev/engine/data_tables/items.txt record=1407 field=Notes status=translated
msgctxt "engine:items.txt:1407:Notes"
msgid "Quest Item:  This device has no visible symbols or parts.  Why it is so valuable is beyond your comprehension."
msgstr "퀘스트 아이템: 이 장치에는 눈에 보이는 기호나 부품이 없습니다. 왜 이것이 그토록 귀중한지는 당신이 이해할 수 없습니다."

#. assets_dev/engine/data_tables/items.txt record=1408 field=Name status=translated
msgctxt "engine:items.txt:1408:Name"
msgid "Signet Ring"
msgstr "인장 반지"

#. assets_dev/engine/data_tables/items.txt record=1408 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1408:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=1408 field=Notes status=translated
msgctxt "engine:items.txt:1408:Notes"
msgid "Quest Item:  A highly stylized 'D' and 'P' intertwined by a snake with a crown above its head are engraved into the face of this ring.  This must certainly be Davrick's."
msgstr "퀘스트 아이템: 왕관을 쓴 뱀이 얽혀 있는 매우 양식화된 'D'와 'P'가 이 반지 표면에 새겨져 있습니다. 이것은 분명 데이브릭의 것일 겁니다."

#. assets_dev/engine/data_tables/items.txt record=1409 field=Name status=translated
msgctxt "engine:items.txt:1409:Name"
msgid "Letter from Johann Kerrid to the Faerie King"
msgstr "요한 케리드가 요정 왕에게 보낸 편지"

#. assets_dev/engine/data_tables/items.txt record=1409 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1409:NotIdentifiedName"
