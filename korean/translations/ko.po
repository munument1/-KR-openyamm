#. assets_dev/engine/data_tables/items.txt record=1418 field=Notes status=translated
msgctxt "engine:items.txt:1418:Notes"
msgid "The genies captured in these lamps will usually reward those who set them free, though sometimes they take cruel delight in punishing the first living beings they encounter.  To use the genie lamp, pick the lamp up and left-click over the picture of your character in the inventory screen."
msgstr "이 램프에 갇힌 지니들은 보통 자신들을 풀어준 사람에게 보상을 주지만, 때로는 처음 마주친 생명체를 잔인하게 벌주는 것을 즐기기도 합니다. 지니 램프를 사용하려면 램프를 집어 들고 인벤토리 화면에서 캐릭터 그림을 왼쪽 클릭하십시오."

#. assets_dev/engine/data_tables/items.txt record=1419 field=Name status=translated
msgctxt "engine:items.txt:1419:Name"
msgid "Knight Statuette"
msgstr "기사 조각상"

#. assets_dev/engine/data_tables/items.txt record=1419 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1419:NotIdentifiedName"
msgid "Statuette"
msgstr "조각상"

#. assets_dev/engine/data_tables/items.txt record=1419 field=Notes status=translated
msgctxt "engine:items.txt:1419:Notes"
msgid "Quest Item:  A small statuette of a knightly figure.  The statuette seems to radiate a faint magic."
msgstr "퀘스트 아이템: 기사 형상의 작은 조각상. 조각상에서는 희미한 마법의 기운이 뿜어져 나오는 듯하다."

#. assets_dev/engine/data_tables/items.txt record=141 field=Name status=translated
msgctxt "engine:items.txt:141:Name"
msgid "Amethyst Ring"
msgstr "자수정 반지"

#. assets_dev/engine/data_tables/items.txt record=141 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:141:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=141 field=Notes status=translated
msgctxt "engine:items.txt:141:Notes"
msgid "A ring set with three amethysts. The largest is an excellent stone - richly and evenly purple with a perfect cut."
msgstr "자수정 세 개가 세팅된 반지입니다. 가장 큰 자수정은 훌륭한 품질을 자랑하며, 풍부하고 균일한 보라색을 띠고 완벽한 커팅을 보여줍니다."

#. assets_dev/engine/data_tables/items.txt record=1420 field=Name status=translated
msgctxt "engine:items.txt:1420:Name"
msgid "Eagle Statuette"
msgstr "독수리 조각상"

#. assets_dev/engine/data_tables/items.txt record=1420 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1420:NotIdentifiedName"
msgid "Statuette"
msgstr "조각상"

#. assets_dev/engine/data_tables/items.txt record=1420 field=Notes status=translated
msgctxt "engine:items.txt:1420:Notes"
msgid "Quest Item:  A small statuette of a proud eagle.  The statuette seems to radiate a faint magic."
msgstr "퀘스트 아이템: 위풍당당한 독수리 모양의 작은 조각상. 조각상에서는 희미한 마법의 기운이 뿜어져 나오는 듯하다."

#. assets_dev/engine/data_tables/items.txt record=1421 field=Name status=translated
msgctxt "engine:items.txt:1421:Name"
msgid "Angel Statuette"
msgstr "천사 조각상"

#. assets_dev/engine/data_tables/items.txt record=1421 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1421:NotIdentifiedName"
msgid "Statuette"
msgstr "조각상"

#. assets_dev/engine/data_tables/items.txt record=1421 field=Notes status=translated
msgctxt "engine:items.txt:1421:Notes"
msgid "Quest Item:  A small statuette of an angel.  The statuette seems to radiate a faint magic."
msgstr "퀘스트 아이템: 작은 천사 조각상. 조각상에서 희미한 마법의 기운이 뿜어져 나오는 듯하다."

#. assets_dev/engine/data_tables/items.txt record=1422 field=Name status=translated
msgctxt "engine:items.txt:1422:Name"
msgid "Big Tapestry"
msgstr "대형 태피스트리"

#. assets_dev/engine/data_tables/items.txt record=1422 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1422:NotIdentifiedName"
msgid "Tapestry"
msgstr "태피스트리"

#. assets_dev/engine/data_tables/items.txt record=1422 field=Notes status=translated
msgctxt "engine:items.txt:1422:Notes"
msgid "A large tapestry, suitable for hanging in castles."
msgstr "성에 걸기에 적합한 대형 태피스트리."

#. assets_dev/engine/data_tables/items.txt record=1423 field=Name status=translated
msgctxt "engine:items.txt:1423:Name"
msgid "Angel Statue Painting"
msgstr "천사상 그림"

#. assets_dev/engine/data_tables/items.txt record=1423 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1423:NotIdentifiedName"
msgid "Painting"
msgstr "그림"

#. assets_dev/engine/data_tables/items.txt record=1423 field=Notes status=translated
msgctxt "engine:items.txt:1423:Notes"
msgid "Quest Item:  A painting of the angel fountain in the courtyard of Castle Ironfist."
msgstr "퀘스트 아이템: 아이언피스트 성 안뜰에 있는 천사 분수 그림."

#. assets_dev/engine/data_tables/items.txt record=1424 field=Name status=translated
msgctxt "engine:items.txt:1424:Name"
msgid "Archibald Ironfist Painting"
msgstr "아치볼드 아이언피스트의 초상화"

#. assets_dev/engine/data_tables/items.txt record=1424 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1424:NotIdentifiedName"
msgid "Painting"
msgstr "그림"

#. assets_dev/engine/data_tables/items.txt record=1424 field=Notes status=translated
msgctxt "engine:items.txt:1424:Notes"
msgid "Quest Item:  A painting of Archibald Ironfist just prior to his War of Succession in Enroth."
msgstr "퀘스트 아이템: 엔로스에서 왕위 계승 전쟁 직전의 아치볼드 아이언피스트의 초상화."

#. assets_dev/engine/data_tables/items.txt record=1425 field=Name status=translated
msgctxt "engine:items.txt:1425:Name"
msgid "Roland Ironfist Painting"
msgstr "롤랜드 아이언피스트의 초상화"

#. assets_dev/engine/data_tables/items.txt record=1425 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1425:NotIdentifiedName"
msgid "Painting"
msgstr "그림"

#. assets_dev/engine/data_tables/items.txt record=1425 field=Notes status=translated
msgctxt "engine:items.txt:1425:Notes"
msgid "Quest Item:  A painting of Roland Ironfist just prior to the War of Succession in Enroth."
msgstr "퀘스트 아이템: 엔로스에서 왕위 계승 전쟁 직전의 롤랜드 아이언피스트의 초상화."

#. assets_dev/engine/data_tables/items.txt record=1426 field=Name status=translated
msgctxt "engine:items.txt:1426:Name"
msgid "Vase"
msgstr "꽃병"

#. assets_dev/engine/data_tables/items.txt record=1426 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1426:NotIdentifiedName"
msgid "Vase"
msgstr "꽃병"

#. assets_dev/engine/data_tables/items.txt record=1426 field=Notes status=translated
msgctxt "engine:items.txt:1426:Notes"
msgid "Quest Item:  This small, porcelain vase has been etched with the inscription, \"To Lord Markham, for a great job in the war, Queen Catherine.\""
msgstr "퀘스트 아이템: 이 작은 자기 꽃병에는 \"전쟁에서 큰 공을 세운 마크햄 경에게, 캐서린 여왕이 바칩니다.\"라는 글귀가 새겨져 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1427 field=Name status=translated
msgctxt "engine:items.txt:1427:Name"
msgid "Flower (Rose)"
msgstr "꽃(장미)"

#. assets_dev/engine/data_tables/items.txt record=1427 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1427:NotIdentifiedName"
msgid "Flower"
msgstr "꽃"

#. assets_dev/engine/data_tables/items.txt record=1427 field=Notes status=translated
msgctxt "engine:items.txt:1427:Notes"
msgid "A red, red, rose."
msgstr "아주 새빨간 장미 한 송이."

#. assets_dev/engine/data_tables/items.txt record=1428 field=Name status=translated
msgctxt "engine:items.txt:1428:Name"
msgid "Zokarr IV's Skull"
msgstr "조카르 4세의 두개골"

#. assets_dev/engine/data_tables/items.txt record=1428 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1428:NotIdentifiedName"
msgid "Skull"
msgstr "두개골"

#. assets_dev/engine/data_tables/items.txt record=1428 field=Notes status=translated
msgctxt "engine:items.txt:1428:Notes"
msgid "Quest Item:  The skull of the old Dwarf King, Zokarr IV.  It doesn't look particularly impressive."
msgstr "퀘스트 아이템: 옛 드워프 왕 조카르 4세의 해골. 그다지 위풍당당해 보이지는 않는다."

#. assets_dev/engine/data_tables/items.txt record=1429 field=Name status=translated
msgctxt "engine:items.txt:1429:Name"
msgid "Thigh Bone"
msgstr "대퇴골"

#. assets_dev/engine/data_tables/items.txt record=1429 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1429:NotIdentifiedName"
msgid "Bone"
msgstr "뼈"

#. assets_dev/engine/data_tables/items.txt record=1429 field=Notes status=translated
msgctxt "engine:items.txt:1429:Notes"
msgid "A human(?) thigh bone."
msgstr "사람의 허벅지 뼈(?)."

#. assets_dev/engine/data_tables/items.txt record=142 field=Name status=translated
msgctxt "engine:items.txt:142:Name"
msgid "Necromatic Ring"
msgstr "강령술 반지"

#. assets_dev/engine/data_tables/items.txt record=142 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:142:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=142 field=Notes status=translated
msgctxt "engine:items.txt:142:Notes"
msgid "Though made of semi-precious silver, this ring is highly valuable because it is well suited to holding enchantments of medium power."
msgstr "이 반지는 준보석인 은으로 만들어졌지만, 중간 정도의 위력을 가진 마법을 담기에 적합하기 때문에 매우 귀중한 가치를 지닙니다."

#. assets_dev/engine/data_tables/items.txt record=1430 field=Name status=translated
msgctxt "engine:items.txt:1430:Name"
msgid "Haldar's Remains"
msgstr "할다르의 유해"

#. assets_dev/engine/data_tables/items.txt record=1430 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1430:NotIdentifiedName"
msgid "Jar"
msgstr "항아리"

#. assets_dev/engine/data_tables/items.txt record=1430 field=Notes status=translated
msgctxt "engine:items.txt:1430:Notes"
msgid "Quest Item:  This strangely shaped jar resists all attempts to open or break.  Haldar apparently doesn't like to be disturbed. "
msgstr "퀘스트 아이템: 이 기묘한 모양의 항아리는 열거나 깨뜨리려는 모든 시도에 저항합니다. 할다르는 방해받는 것을 싫어하는 것 같습니다. "

#. assets_dev/engine/data_tables/items.txt record=1431 field=Name status=translated
msgctxt "engine:items.txt:1431:Name"
msgid "Elixir"
msgstr "영약"

#. assets_dev/engine/data_tables/items.txt record=1431 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1431:NotIdentifiedName"
msgid "Bottle"
msgstr "병"

#. assets_dev/engine/data_tables/items.txt record=1431 field=Notes status=translated
msgctxt "engine:items.txt:1431:Notes"
msgid "Quest Item:  A glowing elixir of obviously magical properties."
msgstr "퀘스트 아이템: 명백히 마법적인 효능을 지닌 빛나는 영약."

#. assets_dev/engine/data_tables/items.txt record=1432 field=Name status=translated
msgctxt "engine:items.txt:1432:Name"
msgid "Red Apple"
msgstr "빨간 사과"

#. assets_dev/engine/data_tables/items.txt record=1432 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1432:NotIdentifiedName"
msgid "Apple"
msgstr "사과"

#. assets_dev/engine/data_tables/items.txt record=1432 field=Notes status=translated
msgctxt "engine:items.txt:1432:Notes"
msgid "Apples like these are produced by trees saturated by magic-- usually in the elven lands of Avlee and the Tularean Forest, though not restricted to these areas.  To use the apple, pick the apple up and left-click over the picture of your character in the inventory screen."
msgstr "이런 사과는 마법으로 가득 찬 나무에서 열립니다. 주로 엘프의 땅인 아블리와 툴라레안 숲에서 자라지만, 꼭 이 지역에만 국한된 것은 아닙니다. 사과를 사용하려면 사과를 주운 다음 인벤토리 화면에서 캐릭터 사진을 왼쪽 클릭하십시오."

#. assets_dev/engine/data_tables/items.txt record=1433 field=Name status=translated
msgctxt "engine:items.txt:1433:Name"
msgid "Wealthy Hat"
msgstr "부자의 모자"

#. assets_dev/engine/data_tables/items.txt record=1433 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1433:NotIdentifiedName"
msgid "Hat"
msgstr "모자"

#. assets_dev/engine/data_tables/items.txt record=1433 field=Notes status=translated
msgctxt "engine:items.txt:1433:Notes"
msgid "Quest Item: This hat appears to belong to a more affluent member of society, the feather is genuine and the construction is solid.  Unfortunately, it doesn't seem to fit."
msgstr "퀘스트 아이템: 이 모자는 부유한 집안 사람의 것으로 보이며, 깃털은 진짜이고 만듦새도 튼튼해 보입니다. 하지만 아쉽게도 제게는 맞지 않는 것 같습니다."

#. assets_dev/engine/data_tables/items.txt record=1434 field=Name status=translated
msgctxt "engine:items.txt:1434:Name"
msgid "Lute"
msgstr "류트"

#. assets_dev/engine/data_tables/items.txt record=1434 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1434:NotIdentifiedName"
msgid "Instrument"
msgstr "악기"

#. assets_dev/engine/data_tables/items.txt record=1434 field=Notes status=translated
msgctxt "engine:items.txt:1434:Notes"
msgid "Quest Item: This lute has been masterfully crafted and lovingly maintained.  This instrument clearly belongs to a Bard."
msgstr "퀘스트 아이템: 이 류트는 장인의 솜씨로 제작되었고 정성스럽게 관리되어 왔습니다. 이 악기는 분명 음유시인의 것입니다."

#. assets_dev/engine/data_tables/items.txt record=1435 field=Name status=translated
msgctxt "engine:items.txt:1435:Name"
msgid "Faerie Pipes"
msgstr "요정의 피리"

#. assets_dev/engine/data_tables/items.txt record=1435 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1435:NotIdentifiedName"
msgid "Instrument"
msgstr "악기"

#. assets_dev/engine/data_tables/items.txt record=1435 field=Notes status=translated
msgctxt "engine:items.txt:1435:Notes"
msgid "Quest Item:  Though finely crafted and deceptively simple-looking, these Pipes are quite difficult to play; they seem to have a mind of their own."
msgstr "퀘스트 아이템: 정교하게 만들어졌고 겉보기엔 단순해 보이지만, 이 파이프는 연주하기가 상당히 어렵습니다. 마치 스스로 생각하는 듯한 느낌을 줍니다."

#. assets_dev/engine/data_tables/items.txt record=1436 field=Name status=translated
msgctxt "engine:items.txt:1436:Name"
msgid "Gryphonheart's Trumpet"
msgstr "그리폰하트의 나팔"

#. assets_dev/engine/data_tables/items.txt record=1436 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1436:NotIdentifiedName"
msgid "Instrument"
msgstr "악기"

#. assets_dev/engine/data_tables/items.txt record=1436 field=Notes status=translated
msgctxt "engine:items.txt:1436:Notes"
msgid "Quest Item:  An artifact from a previous Elf/Human dispute, lost by Terrance Gryphonheart in a daring night-time raid by Elvish forces.  Rumor has it that no army that has fought on the side of this trumpet's music has ever been defeated.  Even if the rumor is false, it will certainly boost morale on either side."
msgstr "퀘스트 아이템: 과거 엘프와 인간 사이의 분쟁에서 나온 유물로, 테런스 그리폰하트가 엘프 군대의 대담한 야간 습격 중에 잃어버린 것입니다. 전해지는 이야기에 따르면 이 나팔 소리에 이끌려 싸운 군대는 결코 패배하지 않았다고 합니다. 설령 그 소문이 사실이라 할지라도, 분명 양측의 사기를 북돋아 줄 것입니다."

#. assets_dev/engine/data_tables/items.txt record=1437 field=Name status=translated
msgctxt "engine:items.txt:1437:Name"
msgid "Seashell"
msgstr "조개껍데기"

#. assets_dev/engine/data_tables/items.txt record=1437 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1437:NotIdentifiedName"
msgid "Seashell"
msgstr "조개껍데기"

#. assets_dev/engine/data_tables/items.txt record=1437 field=Notes status=translated
msgctxt "engine:items.txt:1437:Notes"
msgid "Quest Item: Seashells this large are only found on the beaches of Emerald Island.  One of these might make a nice souvenir of your time here."
msgstr "퀘스트 아이템: 이렇게 큰 조개껍데기는 에메랄드 섬의 해변에서만 찾을 수 있습니다. 이 조개껍데기 하나를 기념품으로 간직하면 좋을 거예요."

#. assets_dev/engine/data_tables/items.txt record=1438 field=Name status=translated
msgctxt "engine:items.txt:1438:Name"
msgid "Floor Tile (w/ moon insignia)"
msgstr "바닥 타일(달 문양)"

#. assets_dev/engine/data_tables/items.txt record=1438 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1438:NotIdentifiedName"
msgid "Tile"
msgstr "타일"

#. assets_dev/engine/data_tables/items.txt record=1438 field=Notes status=translated
msgctxt "engine:items.txt:1438:Notes"
msgid "Quest Item: This tile was apparently part of the library in a Temple of the Moon."
msgstr "퀘스트 아이템: 이 타일은 달의 신전에 있는 도서관의 일부였던 것으로 보입니다."

#. assets_dev/engine/data_tables/items.txt record=1439 field=Name status=translated
msgctxt "engine:items.txt:1439:Name"
msgid "Winged Sandals"
msgstr "날개 달린 샌들"

#. assets_dev/engine/data_tables/items.txt record=1439 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1439:NotIdentifiedName"
msgid "Sandals"
msgstr "샌들"

#. assets_dev/engine/data_tables/items.txt record=1439 field=Notes status=translated
msgctxt "engine:items.txt:1439:Notes"
msgid "(+100 Speed, +50 Accuracy, +50 Air Resistance, Regenerate SP and HP over time, and Feather Falling) Rumored to be the footwear of a god, the winged sandals confer enormous power on the wearer."
msgstr "(+100 속도, +50 적중률, +50 공기 저항, 시간에 따른 주문력과 생명력 회복, 깃털 낙하) 신의 신발이라는 소문이 있는 이 날개 달린 샌들은 착용자에게 엄청난 힘을 부여합니다."

#. assets_dev/engine/data_tables/items.txt record=143 field=Name status=translated
msgctxt "engine:items.txt:143:Name"
msgid "Ruby Ring"
msgstr "루비 반지"

#. assets_dev/engine/data_tables/items.txt record=143 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:143:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=143 field=Notes status=translated
msgctxt "engine:items.txt:143:Notes"
msgid "This simply elegant ring is set with a single, oval ruby of high quality - pigeon blood red, perfectly cut and clear of imperfections."
msgstr "이 심플하면서도 우아한 반지는 최고급 품질의 타원형 루비 한 개가 세팅되어 있습니다. 비둘기 피처럼 붉은색을 띠는 이 루비는 완벽하게 커팅되었으며 흠집이 전혀 없습니다."

#. assets_dev/engine/data_tables/items.txt record=1440 field=Name status=translated
msgctxt "engine:items.txt:1440:Name"
msgid "Season's Stole"
msgstr "계절의 스톨"

#. assets_dev/engine/data_tables/items.txt record=1440 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1440:NotIdentifiedName"
msgid "Scarf"
msgstr "스카프"

#. assets_dev/engine/data_tables/items.txt record=1440 field=Notes status=translated
msgctxt "engine:items.txt:1440:Notes"
msgid "Quest Item: The Seasons' Stole is worn by priests during seasonal festivities.  Though it doesn't have any direct power, most commonfolk believe it grants luck in the planting or harvest."
msgstr "퀘스트 아이템: 계절의 스톨은 사제들이 계절 축제 기간 동안 착용하는 장신구입니다. 직접적인 효능은 없지만, 일반 사람들은 이 장신구가 파종이나 수확에 행운을 가져다준다고 믿습니다."

