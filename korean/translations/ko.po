msgstr "스킬 포인트당 4의 저항"

#. assets_dev/engine/data_tables/spells.txt record=14 field=Master status=translated
msgctxt "engine:spells.txt:14:Master"
msgid "3 points resistance per point of skill"
msgstr "기술 포인트당 저항 3 증가"

