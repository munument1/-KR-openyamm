#. assets_dev/engine/data_tables/spells.txt record=93 field=Description status=translated
msgctxt "engine:spells.txt:93:Description"
msgid "Fires a blast of hot, jagged metal in front of the caster, striking any creature that gets in the way.  Each piece inflicts 1-6 points of damage per point of skill in Dark Magic."
msgstr "시전자 전방으로 뜨겁고 날카로운 금속 파편을 발사하여 경로에 있는 모든 생명체에게 피해를 줍니다. 각 파편은 어둠 마법 기술 레벨당 1-6의 피해를 입힙니다."

#. assets_dev/engine/data_tables/spells.txt record=93 field=Expert status=translated
msgctxt "engine:spells.txt:93:Expert"
msgid "Faster recovery rate and 5 fragments"
msgstr "회복 속도 증가 및 파편 5개"

