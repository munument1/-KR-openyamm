#. assets_dev/engine/data_tables/items.txt record=1450 field=Notes status=translated
msgctxt "engine:items.txt:1450:Notes"
msgid "Quest Item:  This lantern shines with a faint, holy light, though no flame appears to be lit inside."
msgstr "퀘스트 아이템: 이 등불은 희미하고 신성한 빛을 발하지만, 안에는 불꽃이 타오르는 것처럼 보이지 않습니다."

#. assets_dev/engine/data_tables/items.txt record=1451 field=Name status=translated
msgctxt "engine:items.txt:1451:Name"
