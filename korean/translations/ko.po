msgctxt "engine:items.txt:1603:Name"
msgid "Longsword"
msgstr "장검"

#. assets_dev/engine/data_tables/items.txt record=1603 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1603:NotIdentifiedName"
msgid "Longsword"
msgstr "장검"

#. assets_dev/engine/data_tables/items.txt record=1603 field=Notes status=translated
msgctxt "engine:items.txt:1603:Notes"
msgid "Of simple make and design, this longsword is deadly nonetheless."
msgstr "단순한 구조와 디자인을 가졌지만, 이 장검은 그 자체로 치명적입니다."

#. assets_dev/engine/data_tables/items.txt record=1604 field=Name status=translated
msgctxt "engine:items.txt:1604:Name"
msgid "Warrior Sword"
msgstr "전사의 검"

#. assets_dev/engine/data_tables/items.txt record=1604 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1604:NotIdentifiedName"
msgid "Longsword"
msgstr "장검"

#. assets_dev/engine/data_tables/items.txt record=1604 field=Notes status=translated
msgctxt "engine:items.txt:1604:Notes"
msgid "A longsword of superior strength and edge."
msgstr "뛰어난 강도와 날카로움을 지닌 장검."

#. assets_dev/engine/data_tables/items.txt record=1605 field=Name status=translated
msgctxt "engine:items.txt:1605:Name"
msgid "Crusader Sword"
msgstr "십자군의 검"

#. assets_dev/engine/data_tables/items.txt record=1605 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1605:NotIdentifiedName"
msgid "Longsword"
msgstr "장검"

#. assets_dev/engine/data_tables/items.txt record=1605 field=Notes status=translated
msgctxt "engine:items.txt:1605:Notes"
msgid "Hammered metal patterns on the blade of this longsword suggest high quality Dwarven manufacture."
msgstr "이 장검의 칼날에 새겨진 두드린 듯한 금속 무늬는 드워프 장인의 뛰어난 솜씨를 보여줍니다."

#. assets_dev/engine/data_tables/items.txt record=1606 field=Name status=translated
msgctxt "engine:items.txt:1606:Name"
msgid "Conqueror Sword"
msgstr "정복자의 검"

#. assets_dev/engine/data_tables/items.txt record=1606 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1606:NotIdentifiedName"
msgid "Longsword"
msgstr "장검"

#. assets_dev/engine/data_tables/items.txt record=1606 field=Notes status=translated
msgctxt "engine:items.txt:1606:Notes"
msgid "An extremely high quality longsword, this weapon is one of no more than one thousand of its kind forged by master weaponsmith Mekorig the Blind circa 780-800."
msgstr "이 검은 최고급 품질의 장검으로, 780년에서 800년경에 명장 무기 제작자 장님 메코리그가 만든 1,000점 미만의 희귀한 작품 중 하나입니다."

#. assets_dev/engine/data_tables/items.txt record=1607 field=Name status=translated
msgctxt "engine:items.txt:1607:Name"
msgid "Lionheart Sword"
msgstr "라이온하트 검"

#. assets_dev/engine/data_tables/items.txt record=1607 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1607:NotIdentifiedName"
msgid "Longsword"
msgstr "장검"

#. assets_dev/engine/data_tables/items.txt record=1607 field=Notes status=translated
msgctxt "engine:items.txt:1607:Notes"
msgid "A weapon as rare as it is ancient, this longsword was forged during the Time of Wonders.  The process used to forge steel of this quality was lost sometime just after the Silence."
msgstr "이 장검은 희귀할 뿐만 아니라 매우 오래된 무기로, 경이의 시대에 만들어졌습니다. 이처럼 뛰어난 품질의 강철을 만드는 데 사용된 제조법은 침묵의 시대 직후에 사라졌습니다."

#. assets_dev/engine/data_tables/items.txt record=1608 field=Name status=translated
msgctxt "engine:items.txt:1608:Name"
msgid "Claymore"
msgstr "클레이모어"

#. assets_dev/engine/data_tables/items.txt record=1608 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1608:NotIdentifiedName"
msgid "Two-Handed Sword"
msgstr "양손검"

#. assets_dev/engine/data_tables/items.txt record=1608 field=Notes status=translated
msgctxt "engine:items.txt:1608:Notes"
msgid "A basic two-handed sword.  Thousands of these low quality weapons can be found throughout Enroth."
msgstr "기본적인 양손검. 엔로스 전역에서 이처럼 질이 낮은 무기를 수천 개나 찾아볼 수 있다."

#. assets_dev/engine/data_tables/items.txt record=1609 field=Name status=translated
msgctxt "engine:items.txt:1609:Name"
msgid "Barbarian Flamberge"
msgstr "야만인의 플랑베르주"

#. assets_dev/engine/data_tables/items.txt record=1609 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1609:NotIdentifiedName"
msgid "Two-Handed Sword"
msgstr "양손검"

#. assets_dev/engine/data_tables/items.txt record=1609 field=Notes status=translated
msgctxt "engine:items.txt:1609:Notes"
msgid "Yet another simple two-handed sword, this barbarian's weapon sports a wavy blade and an extra cross piece.  Its construction is sturdy and the blade is sharp."
msgstr "이 야만인의 무기는 또 다른 단순한 양손검으로, 물결 모양의 날과 추가적인 가로대가 특징입니다. 견고한 구조와 날카로운 날을 자랑합니다."

#. assets_dev/engine/data_tables/items.txt record=160 field=Name status=translated
msgctxt "engine:items.txt:160:Name"
msgid "Shaman's Wand of Mind"
msgstr "주술사의 정신 마법봉"

#. assets_dev/engine/data_tables/items.txt record=160 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:160:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=160 field=Notes status=translated
msgctxt "engine:items.txt:160:Notes"
msgid "Something rattles ominously within the gog skull topping this wand - product of Ogre mage magic. To use it, you must equip it like a weapon."
msgstr "이 지팡이 꼭대기에 있는 고그 해골 안에서 무언가가 불길하게 덜그럭거린다. 오우거 마법사의 마법으로 만들어진 이 지팡이를 사용하려면 무기처럼 장착해야 한다."

#. assets_dev/engine/data_tables/items.txt record=1610 field=Name status=translated
msgctxt "engine:items.txt:1610:Name"
msgid "Vanquisher Sword"
msgstr "정복자의 검"

#. assets_dev/engine/data_tables/items.txt record=1610 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1610:NotIdentifiedName"
msgid "Two-Handed Sword"
msgstr "양손검"

#. assets_dev/engine/data_tables/items.txt record=1610 field=Notes status=translated
msgctxt "engine:items.txt:1610:Notes"
msgid "An unusually high quality two-handed sword, this blade is both strong and reliable."
msgstr "이 검은 매우 뛰어난 품질의 양손검으로, 강하고 믿음직스럽습니다."

#. assets_dev/engine/data_tables/items.txt record=1611 field=Name status=translated
msgctxt "engine:items.txt:1611:Name"
msgid "Fine Broadsword"
msgstr "고급 브로드소드"

#. assets_dev/engine/data_tables/items.txt record=1611 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1611:NotIdentifiedName"
msgid "Broadsword"
msgstr "브로드소드"

#. assets_dev/engine/data_tables/items.txt record=1611 field=Notes status=translated
msgctxt "engine:items.txt:1611:Notes"
msgid "A common broadsword.  These blades can be found throughout the land in the hands of both heroes and villains."
msgstr "흔히 볼 수 있는 브로드소드. 이 검은 영웅과 악당 모두의 손에서 이 땅 곳곳에서 찾아볼 수 있다."

#. assets_dev/engine/data_tables/items.txt record=1612 field=Name status=translated
msgctxt "engine:items.txt:1612:Name"
msgid "Massive Steel Broadsword"
msgstr "거대한 강철 브로드소드"

#. assets_dev/engine/data_tables/items.txt record=1612 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1612:NotIdentifiedName"
msgid "Broadsword"
msgstr "브로드소드"

#. assets_dev/engine/data_tables/items.txt record=1612 field=Notes status=translated
msgctxt "engine:items.txt:1612:Notes"
msgid "A larger variety of the Erathian steel broadsword, not a bit inferior in quality to its smaller counterpart. The increased size requires more strength to wield, but it's guaranteed to leave a mark."
msgstr "에라티아 강철 브로드소드의 대형 버전으로, 소형 버전과 비교해도 품질은 전혀 떨어지지 않습니다. 크기가 커진 만큼 휘두르려면 더 많은 힘이 필요하지만, 그만큼 강력한 위력을 자랑합니다."

#. assets_dev/engine/data_tables/items.txt record=1613 field=Name status=translated
msgctxt "engine:items.txt:1613:Name"
msgid "Mighty Broadsword"
msgstr "강력한 브로드소드"

#. assets_dev/engine/data_tables/items.txt record=1613 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1613:NotIdentifiedName"
msgid "Broadsword"
msgstr "브로드소드"

#. assets_dev/engine/data_tables/items.txt record=1613 field=Notes status=translated
msgctxt "engine:items.txt:1613:Notes"
msgid "This broadsword's edge and beauty are enchanted and untouched by time.  The blade looks as though it was forged yesterday."
msgstr "이 대검의 날카로움과 아름다움은 세월의 흐름에도 변함없이 그대로입니다. 마치 어제 벼려낸 듯한 모습입니다."

#. assets_dev/engine/data_tables/items.txt record=1614 field=Name status=translated
msgctxt "engine:items.txt:1614:Name"
msgid "Cutlass"
msgstr "커틀러스"

#. assets_dev/engine/data_tables/items.txt record=1614 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1614:NotIdentifiedName"
msgid "Cutlass"
msgstr "커틀러스"

#. assets_dev/engine/data_tables/items.txt record=1614 field=Notes status=translated
msgctxt "engine:items.txt:1614:Notes"
msgid "A cutlass of Goblin manufacture, this blade is as deadly as it is ugly."
msgstr "고블린이 만든 이 커틀러스는 흉측한 외모만큼이나 치명적이다."

#. assets_dev/engine/data_tables/items.txt record=1615 field=Name status=translated
msgctxt "engine:items.txt:1615:Name"
msgid "Pirate Cutlass"
msgstr "해적 단검"

#. assets_dev/engine/data_tables/items.txt record=1615 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1615:NotIdentifiedName"
msgid "Cutlass"
msgstr "커틀러스"

#. assets_dev/engine/data_tables/items.txt record=1615 field=Notes status=translated
msgctxt "engine:items.txt:1615:Notes"
msgid "The traditional back-up weapon of the Regnan pirates living on the countless islands east of the island of Mist.  These cutlasses were forged by one of a long line of smiths native to those islands."
msgstr "안개의 섬 동쪽에 있는 수많은 섬들에 거주하는 레그나 해적들의 전통적인 보조 무기입니다. 이 커틀러스는 그 섬들에 뿌리를 둔 오랜 대장장이 가문의 일원이 제작했습니다."

#. assets_dev/engine/data_tables/items.txt record=1616 field=Name status=translated
msgctxt "engine:items.txt:1616:Name"
msgid "Master Cutlass"
msgstr "마스터 커틀러스"

#. assets_dev/engine/data_tables/items.txt record=1616 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1616:NotIdentifiedName"
msgid "Cutlass"
msgstr "커틀러스"

#. assets_dev/engine/data_tables/items.txt record=1616 field=Notes status=translated
msgctxt "engine:items.txt:1616:Notes"
msgid "These splendid cutlasses were created in limited numbers by Alec Teling, master armorer to Hareck IX, and were issued only to admirals of Regnan fleets as a symbol of station. You are not likely to set your eyes upon a finer cutlass in your lifetime."
msgstr "이 훌륭한 커틀러스는 하렉 9세의 수석 무기 제작자인 알렉 텔링이 한정된 수량으로 제작했으며, 레그나 함대의 제독들에게만 지위의 상징으로 지급되었습니다. 당신은 평생 이보다 더 훌륭한 커틀러스를 다시 보기 어려울 것입니다."

#. assets_dev/engine/data_tables/items.txt record=1617 field=Name status=translated
msgctxt "engine:items.txt:1617:Name"
msgid "Dagger"
msgstr "단검"

#. assets_dev/engine/data_tables/items.txt record=1617 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1617:NotIdentifiedName"
msgid "Dagger"
msgstr "단검"

#. assets_dev/engine/data_tables/items.txt record=1617 field=Notes status=translated
msgctxt "engine:items.txt:1617:Notes"
msgid "A common dagger, favorite of thieves and assassins the world over."
msgstr "흔한 단검으로, 전 세계 도둑과 암살자들이 즐겨 찾는 무기입니다."

#. assets_dev/engine/data_tables/items.txt record=1618 field=Name status=translated
msgctxt "engine:items.txt:1618:Name"
msgid "Blood Dagger"
msgstr "피의 단검"

#. assets_dev/engine/data_tables/items.txt record=1618 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1618:NotIdentifiedName"
msgid "Dagger"
msgstr "단검"

#. assets_dev/engine/data_tables/items.txt record=1618 field=Notes status=translated
msgctxt "engine:items.txt:1618:Notes"
msgid "Blood Daggers are ceremonial weapons worn by the nobility of Regna.  Their popularity has spread in recent years to the nobility of Enroth, and now they can be found throughout the land.  Though ceremonial, they are sharp and reliable blades."
msgstr "블러드 대거는 레그나 귀족들이 착용하는 의식용 무기입니다. 최근 몇 년 동안 엔로스 귀족들 사이에서도 인기가 높아져 이제는 엔로스 전역에서 찾아볼 수 있습니다. 의식용 무기이긴 하지만, 날카롭고 믿음직한 칼날이기도 합니다."

#. assets_dev/engine/data_tables/items.txt record=1619 field=Name status=translated
msgctxt "engine:items.txt:1619:Name"
msgid "Shadow Dagger"
msgstr "그림자 단검"

#. assets_dev/engine/data_tables/items.txt record=1619 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1619:NotIdentifiedName"
msgid "Dagger"
msgstr "단검"

#. assets_dev/engine/data_tables/items.txt record=1619 field=Notes status=translated
msgctxt "engine:items.txt:1619:Notes"
msgid "Commissioned by Ethric the Mad while still a human, it is said these daggers have a link to the Land of the Dead.  They are used in certain magical rituals designed to extend life to unnatural lengths."
msgstr "미치광이 에스릭이 인간 시절에 의뢰하여 제작된 이 단검들은 저승과 연관이 있다고 전해집니다. 이 단검들은 수명을 비정상적으로 연장하는 특정 마법 의식에 사용됩니다."

#. assets_dev/engine/data_tables/items.txt record=161 field=Name status=translated
msgctxt "engine:items.txt:161:Name"
msgid "Shaman's Wand of Swarms"
msgstr "주술사의 벌떼 마법봉"

#. assets_dev/engine/data_tables/items.txt record=161 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:161:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=161 field=Notes status=translated
msgctxt "engine:items.txt:161:Notes"
msgid "Something rattles ominously within the gog skull topping this wand - product of Ogre mage magic. To use it, you must equip it like a weapon."
msgstr "이 지팡이 꼭대기에 있는 고그 해골 안에서 무언가가 불길하게 덜그럭거린다. 오우거 마법사의 마법으로 만들어진 이 지팡이를 사용하려면 무기처럼 장착해야 한다."

#. assets_dev/engine/data_tables/items.txt record=1620 field=Name status=translated
msgctxt "engine:items.txt:1620:Name"
msgid "Mage Dagger"
msgstr "마법사의 단검"

#. assets_dev/engine/data_tables/items.txt record=1620 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1620:NotIdentifiedName"
msgid "Dagger"
msgstr "단검"

#. assets_dev/engine/data_tables/items.txt record=1620 field=Notes status=translated
msgctxt "engine:items.txt:1620:Notes"
msgid "One of less than a hundred such blades, Mage daggers were carried and forged by members of the Alchemical Alliance roughly 300 years ago in the fires beneath Castle Alamos.  It is no longer possible to make a finer blade than a Mage dagger."
msgstr "백 자루도 채 되지 않는 마법사 단검은 약 300년 전, 알라모스 성 지하의 불길 속에서 연금술 동맹의 일원들이 직접 제작하고 휴대했던 검입니다. 이제는 마법사 단검보다 더 정교한 검을 만들 수 있는 기술은 없습니다."

#. assets_dev/engine/data_tables/items.txt record=1621 field=Name status=translated
msgctxt "engine:items.txt:1621:Name"
msgid "Jeweled Dagger"
msgstr "보석 박힌 단검"

#. assets_dev/engine/data_tables/items.txt record=1621 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1621:NotIdentifiedName"
msgid "Dagger"
msgstr "단검"

#. assets_dev/engine/data_tables/items.txt record=1621 field=Notes status=translated
msgctxt "engine:items.txt:1621:Notes"
msgid "A weapon from the Time of Wonders, this blade is of both extreme age and quality."
msgstr "경이의 시대에 만들어진 무기인 이 검은 매우 오래되었고 품질 또한 뛰어납니다."

#. assets_dev/engine/data_tables/items.txt record=1622 field=Name status=translated
msgctxt "engine:items.txt:1622:Name"
msgid "Fine Long Dagger"
msgstr "고급 장단검"

#. assets_dev/engine/data_tables/items.txt record=1622 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1622:NotIdentifiedName"
msgid "Long Dagger"
msgstr "장단검"

#. assets_dev/engine/data_tables/items.txt record=1622 field=Notes status=translated
msgctxt "engine:items.txt:1622:Notes"
msgid "The common long dagger.  Bordering on swords, these long daggers are favored by assassins who want a weapon that is both concealable yet has a longer reach than the traditional dagger."
msgstr "흔히 볼 수 있는 긴 단검. 검에 가까운 이 긴 단검은 휴대하기 편리하면서도 전통적인 단검보다 사거리가 긴 무기를 원하는 암살자들에게 인기가 많다."

#. assets_dev/engine/data_tables/items.txt record=1623 field=Name status=translated
msgctxt "engine:items.txt:1623:Name"
msgid "Piercing Dagger"
msgstr "관통 단검"

#. assets_dev/engine/data_tables/items.txt record=1623 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1623:NotIdentifiedName"
msgid "Long Dagger"
msgstr "장단검"

#. assets_dev/engine/data_tables/items.txt record=1623 field=Notes status=translated
msgctxt "engine:items.txt:1623:Notes"
msgid "Really more of a short sword than a dagger, the narrow blade belies an unusual strength and a possibly enchanted edge."
msgstr "단검이라기보다는 짧은 검에 더 가까운 이 무기는 좁은 날 속에 비범한 강도와 어쩌면 마법이 깃든 듯한 날카로움을 숨기고 있다."

#. assets_dev/engine/data_tables/items.txt record=1624 field=Name status=translated
msgctxt "engine:items.txt:1624:Name"
msgid "Divine Dagger"
msgstr "신성한 단검"

#. assets_dev/engine/data_tables/items.txt record=1624 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1624:NotIdentifiedName"
msgid "Long Dagger"
msgstr "장단검"

#. assets_dev/engine/data_tables/items.txt record=1624 field=Notes status=translated
msgctxt "engine:items.txt:1624:Notes"
msgid "A 'Weapon of the Gods', this weapon was one of the last created before the great forges fell to the Silence in the year 113 A.S (After the Silence)."
msgstr "'신들의 무기'라 불리는 이 무기는 서기 113년(침묵의 시대 이후)에 침묵의 시대가 닥쳐 거대한 대장간들이 무너지기 직전에 만들어진 마지막 무기 중 하나입니다."

#. assets_dev/engine/data_tables/items.txt record=1625 field=Name status=translated
msgctxt "engine:items.txt:1625:Name"
msgid "Hand Axe"
msgstr "손도끼"

#. assets_dev/engine/data_tables/items.txt record=1625 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1625:NotIdentifiedName"
msgid "Axe"
msgstr "도끼"

#. assets_dev/engine/data_tables/items.txt record=1625 field=Notes status=translated
msgctxt "engine:items.txt:1625:Notes"
msgid "More of a tool than a weapon, this simple axe will work in a pinch.  But don't expect much."
msgstr "무기라기보다는 도구에 가까운 이 단순한 도끼는 급할 때 쓸만합니다. 하지만 큰 기대는 하지 마세요."

#. assets_dev/engine/data_tables/items.txt record=1626 field=Name status=translated
msgctxt "engine:items.txt:1626:Name"
msgid "Barbarian Axe"
msgstr "야만인의 도끼"

#. assets_dev/engine/data_tables/items.txt record=1626 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1626:NotIdentifiedName"
msgid "Axe"
msgstr "도끼"

#. assets_dev/engine/data_tables/items.txt record=1626 field=Notes status=translated
msgctxt "engine:items.txt:1626:Notes"
msgid "Made as a weapon of war instead of a tool, this  battle axe is usually employed by barbarians and undisciplined armies."
msgstr "이 전투 도끼는 도구가 아닌 전쟁 무기로 만들어졌으며, 주로 야만인이나 규율이 없는 군대에서 사용되었습니다."

#. assets_dev/engine/data_tables/items.txt record=1627 field=Name status=translated
msgctxt "engine:items.txt:1627:Name"
msgid "War Axe"
msgstr "전투 도끼"

#. assets_dev/engine/data_tables/items.txt record=1627 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1627:NotIdentifiedName"
msgid "Axe"
msgstr "도끼"

#. assets_dev/engine/data_tables/items.txt record=1627 field=Notes status=translated
msgctxt "engine:items.txt:1627:Notes"
msgid "This War Axe appears to be one of a large shipment of such axes seized by Roland during the Succession War.  It was manufactured in Karigor by order of Archibald Ironfist to be used against his brother in their struggle for the throne of Enroth."
msgstr "이 전투 도끼는 계승 전쟁 중 롤랜드가 압수한 대량의 전투 도끼 중 하나인 것으로 보인다. 이 도끼는 아치볼드 아이언피스트의 명령으로 카리고르에서 제작되었으며, 엔로스 왕좌를 놓고 벌이는 그의 형제와의 싸움에서 사용하기 위한 것이었다."

#. assets_dev/engine/data_tables/items.txt record=1628 field=Name status=translated
msgctxt "engine:items.txt:1628:Name"
msgid "Dwarven Noble Axe"
msgstr "드워프 귀족의 도끼"

#. assets_dev/engine/data_tables/items.txt record=1628 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1628:NotIdentifiedName"
msgid "Axe"
msgstr "도끼"

#. assets_dev/engine/data_tables/items.txt record=1628 field=Notes status=translated
msgctxt "engine:items.txt:1628:Notes"
msgid "An example of the high quality work done by the dwarves of the Red Mountains, the blade is sharp and the balance perfect."
msgstr "붉은 산맥 드워프들이 만들어낸 뛰어난 품질의 한 예로, 칼날은 날카롭고 균형은 완벽합니다."

#. assets_dev/engine/data_tables/items.txt record=1629 field=Name status=translated
msgctxt "engine:items.txt:1629:Name"
msgid "Supreme Axe"
msgstr "최상급 도끼"

#. assets_dev/engine/data_tables/items.txt record=1629 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1629:NotIdentifiedName"
msgid "Axe"
msgstr "도끼"

#. assets_dev/engine/data_tables/items.txt record=1629 field=Notes status=translated
msgctxt "engine:items.txt:1629:Notes"
msgid "This weapon surely has a dark history.  An axe of this quality is only forged as the personal weapon of a noble Dwarf, and it is never sold or traded away…"
msgstr "이 무기는 분명 어두운 역사를 지니고 있을 것이다. 이처럼 뛰어난 품질의 도끼는 오직 고귀한 드워프의 개인 무기로만 제작되며, 절대 팔거나 교환해서는 안 된다…"

#. assets_dev/engine/data_tables/items.txt record=162 field=Name status=translated
msgctxt "engine:items.txt:162:Name"
msgid "Wizard Wand of Fireballs"
msgstr "마법사의 화염구 마법봉"

#. assets_dev/engine/data_tables/items.txt record=162 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:162:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=162 field=Notes status=translated
msgctxt "engine:items.txt:162:Notes"
msgid "A wand of highly polished thornbark wrapped with platinum wire. To use it, you must equip it like a weapon."
msgstr "매끄럽게 광택 처리된 가시나무 껍질에 백금선을 감싼 지팡이. 사용하려면 무기처럼 장착해야 한다."

#. assets_dev/engine/data_tables/items.txt record=1630 field=Name status=translated
msgctxt "engine:items.txt:1630:Name"
msgid "Light Poleaxe"
msgstr "경량 장대도끼"

#. assets_dev/engine/data_tables/items.txt record=1630 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1630:NotIdentifiedName"
msgid "Two-Handed Axe"
msgstr "양손 도끼"

#. assets_dev/engine/data_tables/items.txt record=1630 field=Notes status=translated
msgctxt "engine:items.txt:1630:Notes"
msgid "This style of long hafted axe is typically used to deadly effect by Eastern tribes and the elite guard of some members of the nobility."
msgstr "이처럼 자루가 긴 도끼는 동양 부족이나 일부 귀족의 정예 경호대가 치명적인 효과를 내는 데 주로 사용합니다."

#. assets_dev/engine/data_tables/items.txt record=1631 field=Name status=translated
msgctxt "engine:items.txt:1631:Name"
msgid "Heavy Poleaxe"
msgstr "중량 장대도끼"

#. assets_dev/engine/data_tables/items.txt record=1631 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1631:NotIdentifiedName"
msgid "Two-Handed Axe"
msgstr "양손 도끼"

#. assets_dev/engine/data_tables/items.txt record=1631 field=Notes status=translated
msgctxt "engine:items.txt:1631:Notes"
msgid "A stronger version of the basic Poleaxe, this weapon is frequently used by city guards and other fighters who don't expect to do battle in large, coordinated groups (like armies)."
msgstr "기본 폴액스보다 강화된 버전인 이 무기는 대규모의 조직적인 전투(예: 군대)를 예상하지 않는 도시 경비대나 기타 전투원들이 자주 사용합니다."

#. assets_dev/engine/data_tables/items.txt record=1632 field=Name status=translated
msgctxt "engine:items.txt:1632:Name"
msgid "Grand Poleaxe"
msgstr "대형 장대도끼"

#. assets_dev/engine/data_tables/items.txt record=1632 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1632:NotIdentifiedName"
msgid "Two-Handed Axe"
msgstr "양손 도끼"

#. assets_dev/engine/data_tables/items.txt record=1632 field=Notes status=translated
msgctxt "engine:items.txt:1632:Notes"
msgid "The blade head of this weapon was obviously created with the aid of magic.  It is both unusually sharp and light at the same time."
msgstr "이 무기의 칼날 끝은 분명 마법의 도움을 받아 만들어진 것이다. 놀라울 정도로 날카로우면서도 동시에 가볍다."

#. assets_dev/engine/data_tables/items.txt record=1633 field=Name status=translated
msgctxt "engine:items.txt:1633:Name"
msgid "Spear"
msgstr "창"

#. assets_dev/engine/data_tables/items.txt record=1633 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1633:NotIdentifiedName"
msgid "Spear"
msgstr "창"

#. assets_dev/engine/data_tables/items.txt record=1633 field=Notes status=translated
msgctxt "engine:items.txt:1633:Notes"
msgid "Barely more than a sharpened stick, this spear is still quite deadly.  Like all spears, it can be used in one or both hands (+1D9 if used two-handed)."
msgstr "날카롭게 다듬은 막대기에 불과하지만, 이 창은 상당히 치명적입니다. 모든 창과 마찬가지로 한 손 또는 양손으로 사용할 수 있으며, 양손으로 사용할 경우 +1D9의 추가 피해를 입힙니다."

#. assets_dev/engine/data_tables/items.txt record=1634 field=Name status=translated
msgctxt "engine:items.txt:1634:Name"
msgid "Stout Spear"
msgstr "튼튼한 창"

#. assets_dev/engine/data_tables/items.txt record=1634 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1634:NotIdentifiedName"
msgid "Spear"
msgstr "창"

#. assets_dev/engine/data_tables/items.txt record=1634 field=Notes status=translated
msgctxt "engine:items.txt:1634:Notes"
msgid "This spear has a reinforced steel tip to help it penetrate tough armor and hides.  Like all spears, it can be used in one or both hands (+1D9 if used two-handed)."
msgstr "이 창은 단단한 갑옷과 가죽을 뚫을 수 있도록 강화된 강철 끝을 가지고 있습니다. 모든 창과 마찬가지로 한 손 또는 양손으로 사용할 수 있으며, 양손으로 사용할 경우 +1D9의 추가 피해를 입힙니다."

#. assets_dev/engine/data_tables/items.txt record=1635 field=Name status=translated
msgctxt "engine:items.txt:1635:Name"
msgid "Serpent Spear"
msgstr "뱀 창"

#. assets_dev/engine/data_tables/items.txt record=1635 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1635:NotIdentifiedName"
msgid "Spear"
msgstr "창"

#. assets_dev/engine/data_tables/items.txt record=1635 field=Notes status=translated
msgctxt "engine:items.txt:1635:Notes"
msgid "Decorated with carved serpents running along the shaft, this spear comes equipped with a cross piece designed to prevent impaled foes from sliding along the shaft of the spear and striking a blow at you as they die.  Like all spears, it can be used in one or both hands (+1D9 if used two-handed)."
msgstr "자루를 따라 뱀이 조각되어 장식된 이 창에는 적이 꽂히면 자루를 따라 미끄러져 내려가면서 죽어가는 동안 당신을 공격하는 것을 방지하는 가로대가 달려 있습니다. 모든 창과 마찬가지로 한 손 또는 양손으로 사용할 수 있으며, 양손으로 사용할 경우 +1D9의 추가 피해를 입힙니다."

#. assets_dev/engine/data_tables/items.txt record=1636 field=Name status=translated
msgctxt "engine:items.txt:1636:Name"
msgid "Savage Spear"
msgstr "야만적인 창"

#. assets_dev/engine/data_tables/items.txt record=1636 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1636:NotIdentifiedName"
msgid "Spear"
msgstr "창"

#. assets_dev/engine/data_tables/items.txt record=1636 field=Notes status=translated
msgctxt "engine:items.txt:1636:Notes"
msgid "Composed entirely of a rare, bluish metal, the lower half of this spear is wrapped in an expensive leather.  A collector's item!  Like all spears, it can be used in one or both hands (+1D9 if used two-handed)."
msgstr "희귀한 푸른빛 금속으로 전체가 만들어진 이 창의 아랫부분은 값비싼 가죽으로 감싸져 있습니다. 소장 가치가 있는 물건입니다! 모든 창과 마찬가지로 한 손 또는 양손으로 사용할 수 있습니다(+1D9, 양손 사용 시)."

#. assets_dev/engine/data_tables/items.txt record=1637 field=Name status=translated
msgctxt "engine:items.txt:1637:Name"
msgid "Sacred Spear"
msgstr "신성한 창"

#. assets_dev/engine/data_tables/items.txt record=1637 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1637:NotIdentifiedName"
msgid "Spear"
msgstr "창"

#. assets_dev/engine/data_tables/items.txt record=1637 field=Notes status=translated
msgctxt "engine:items.txt:1637:Notes"
msgid "This spear bears characteristics of equipment from the Time of Wonders - beautiful, in perfect condition and lethal. This model was already produced centuries before the Silence and remained in production almost towards the end of the Heavenly Forges, in that period serving ceremonial and representative purposes. Later combat models are the only mass-produced spears that surpass these in any capacity (+1D9 if used two-handed)."
msgstr "이 창은 경이의 시대에 만들어진 장비가 지닌 특징, 즉 아름다움과 완벽한 상태, 그리고 치명적인 위력을 지니고 있습니다. 이 모델은 침묵의 시대보다 수 세기 전에 이미 제작되었으며, 천상의 대장간이 거의 끝날 무렵까지 생산되어 의식용 및 상징적인 용도로 사용되었습니다. 이후에 생산된 전투용 모델만이 모든 면에서 이 창을 능가합니다(+1D9, 양손 사용 시)."

#. assets_dev/engine/data_tables/items.txt record=1638 field=Name status=translated
msgctxt "engine:items.txt:1638:Name"
msgid "Common Halberd"
msgstr "일반 미늘창"

#. assets_dev/engine/data_tables/items.txt record=1638 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1638:NotIdentifiedName"
msgid "Halberd"
msgstr "미늘창"

#. assets_dev/engine/data_tables/items.txt record=1638 field=Notes status=translated
msgctxt "engine:items.txt:1638:Notes"
msgid "Combination poleax and spear, the halberd can inflict terrible wounds, but recovers slowly from swings.  This one is of average quality and workmanship (+1D6 if used two-handed)."
msgstr "도끼와 창이 결합된 형태의 할버드는 끔찍한 상처를 입힐 수 있지만, 휘두른 후에는 회복 속도가 느립니다. 이 할버드는 평균적인 품질과 솜씨를 지니고 있습니다(+1D6, 양손으로 사용 시)."

#. assets_dev/engine/data_tables/items.txt record=1639 field=Name status=translated
msgctxt "engine:items.txt:1639:Name"
msgid "Massive Halberd"
msgstr "거대한 미늘창"

#. assets_dev/engine/data_tables/items.txt record=1639 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1639:NotIdentifiedName"
msgid "Halberd"
msgstr "미늘창"

#. assets_dev/engine/data_tables/items.txt record=1639 field=Notes status=translated
msgctxt "engine:items.txt:1639:Notes"
msgid "Of solid construction, this halberd has a particularly heavy blade.  Wielded by a mighty warrior, it could surely be used to slay the toughest of monsters (+1D6 if used two-handed)."
msgstr "견고한 구조로 만들어진 이 할버드는 특히 무거운 날을 가지고 있습니다. 용맹한 전사가 휘두른다면, 가장 강력한 괴물도 쓰러뜨릴 수 있을 것입니다(+1D6, 양손으로 사용 시)."

#. assets_dev/engine/data_tables/items.txt record=163 field=Name status=translated
msgctxt "engine:items.txt:163:Name"
msgid "Wizard Wand of Acid"
msgstr "마법사의 산성 마법봉"

#. assets_dev/engine/data_tables/items.txt record=163 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:163:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=163 field=Notes status=translated
msgctxt "engine:items.txt:163:Notes"
msgid "A wand of highly polished thornbark wrapped with platinum wire. To use it, you must equip it like a weapon."
msgstr "매끄럽게 광택 처리된 가시나무 껍질에 백금선을 감싼 지팡이. 사용하려면 무기처럼 장착해야 한다."

#. assets_dev/engine/data_tables/items.txt record=1640 field=Name status=translated
msgctxt "engine:items.txt:1640:Name"
msgid "Elite Halberd"
msgstr "정예 미늘창"

#. assets_dev/engine/data_tables/items.txt record=1640 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1640:NotIdentifiedName"
msgid "Halberd"
msgstr "미늘창"

#. assets_dev/engine/data_tables/items.txt record=1640 field=Notes status=translated
msgctxt "engine:items.txt:1640:Notes"
msgid "That this magnificent halberd is a product of the Mekorig Foundry comes as no surprise to you. From the intricate shape of the head to the sturdiness of the construction -- everything about this weapon screams quality (+1D6 if used two-handed)."
msgstr "이 웅장한 할버드가 메코리그 주조소의 산물이라는 사실은 당신에게 전혀 놀라운 일이 아닙니다. 정교한 날끝 모양부터 견고한 구조까지, 이 무기의 모든 면은 최고급 품질을 자랑합니다(+1D6, 양손 사용 시)."

#. assets_dev/engine/data_tables/items.txt record=1641 field=Name status=translated
msgctxt "engine:items.txt:1641:Name"
msgid "Trident"
msgstr "삼지창"

#. assets_dev/engine/data_tables/items.txt record=1641 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1641:NotIdentifiedName"
msgid "Trident"
msgstr "삼지창"

#. assets_dev/engine/data_tables/items.txt record=1641 field=Notes status=translated
msgctxt "engine:items.txt:1641:Notes"
msgid "Common war tridents, like this one, are good quality weapons issued by the Imperial Regnan Navy to facilitate the collection of Imperial tariffs on the high seas.  Most merchants and other governments refer to this activity as piracy…(+1D6 if used two-handed)."
msgstr "이와 같은 일반적인 전쟁용 삼지창은 제국 해군이 공해상에서 제국 관세를 징수하기 위해 지급하는 품질 좋은 무기입니다. 대부분의 상인과 다른 정부들은 이러한 행위를 해적 행위로 간주합니다…(+1D6, 양손으로 사용 시)."

#. assets_dev/engine/data_tables/items.txt record=1642 field=Name status=translated
msgctxt "engine:items.txt:1642:Name"
msgid "Ornate Trident"
msgstr "화려한 삼지창"

#. assets_dev/engine/data_tables/items.txt record=1642 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1642:NotIdentifiedName"
msgid "Trident"
msgstr "삼지창"

#. assets_dev/engine/data_tables/items.txt record=1642 field=Notes status=translated
msgctxt "engine:items.txt:1642:Notes"
msgid "A high quality war trident of the style given to officers of the Imperial Regnan Navy.  This one was probably taken from the officer during an Imperial Taxation battle that went poorly for the Navy (+1D6 if used two-handed)."
msgstr "제국 해군 장교들에게 지급되던 양식의 고급 전투 삼지창입니다. 이 삼지창은 아마도 해군에게 불리하게 돌아간 제국 세금 징수 전투 중에 장교에게서 빼앗은 것으로 추정됩니다(+1D6 보너스, 양손으로 사용 시)."

#. assets_dev/engine/data_tables/items.txt record=1643 field=Name status=translated
msgctxt "engine:items.txt:1643:Name"
msgid "Titanic Trident"
msgstr "거대한 삼지창"

#. assets_dev/engine/data_tables/items.txt record=1643 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1643:NotIdentifiedName"
msgid "Trident"
msgstr "삼지창"

#. assets_dev/engine/data_tables/items.txt record=1643 field=Notes status=translated
msgctxt "engine:items.txt:1643:Notes"
msgid "This beautiful trident is mostly made of Kergar, a rare, bluish metal that does not rust or lose its edge over time (+1D6 if used two-handed)."
msgstr "이 아름다운 삼지창은 대부분 케르가르라는 희귀한 푸른빛 금속으로 만들어졌으며, 녹슬거나 시간이 지나도 날이 무뎌지지 않습니다(+1D6, 양손으로 사용 시)."

#. assets_dev/engine/data_tables/items.txt record=1644 field=Name status=translated
msgctxt "engine:items.txt:1644:Name"
msgid "Crude Longbow"
msgstr "조잡한 장궁"

#. assets_dev/engine/data_tables/items.txt record=1644 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1644:NotIdentifiedName"
msgid "Longbow"
msgstr "장궁"

#. assets_dev/engine/data_tables/items.txt record=1644 field=Notes status=translated
msgctxt "engine:items.txt:1644:Notes"
msgid "A simple longbow constructed of common materials and uninspired design."
msgstr "흔한 재료로 만들어졌고 디자인이 평범한 단순한 장궁."

#. assets_dev/engine/data_tables/items.txt record=1645 field=Name status=translated
msgctxt "engine:items.txt:1645:Name"
msgid "Elven Bow"
msgstr "엘프 활"

#. assets_dev/engine/data_tables/items.txt record=1645 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1645:NotIdentifiedName"
msgid "Longbow"
msgstr "장궁"

#. assets_dev/engine/data_tables/items.txt record=1645 field=Notes status=translated
msgctxt "engine:items.txt:1645:Notes"
msgid "A weapon only made by the Elves of the great Erathian forests.  This one reflects the same high quality workmanship found in all Elvish artifacts."
msgstr "이 무기는 에라티아의 광활한 숲에 사는 엘프들만이 만들 수 있는 것입니다. 모든 엘프 유물에서 볼 수 있는 뛰어난 장인 정신이 고스란히 담겨 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1646 field=Name status=translated
msgctxt "engine:items.txt:1646:Name"
msgid "Precision Bow"
msgstr "정밀 활"

#. assets_dev/engine/data_tables/items.txt record=1646 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1646:NotIdentifiedName"
msgid "Longbow"
msgstr "장궁"

#. assets_dev/engine/data_tables/items.txt record=1646 field=Notes status=translated
msgctxt "engine:items.txt:1646:Notes"
msgid "Etched initials at the base of the bow indicate this bow was made by master bowyer Ivan Selving's workshop during the Timber Wars against the Elves of Erathia in the late 600's."
msgstr "활 밑부분에 새겨진 이니셜은 이 활이 600년대 후반 에라시아의 엘프족과의 목재 전쟁 당시 명장 활 제작자 이반 셀빙의 작업장에서 만들어졌음을 나타냅니다."

#. assets_dev/engine/data_tables/items.txt record=1647 field=Name status=translated
msgctxt "engine:items.txt:1647:Name"
msgid "Magic Bow"
msgstr "마법 활"

#. assets_dev/engine/data_tables/items.txt record=1647 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1647:NotIdentifiedName"
msgid "Longbow"
msgstr "장궁"

#. assets_dev/engine/data_tables/items.txt record=1647 field=Notes status=translated
msgctxt "engine:items.txt:1647:Notes"
msgid "This bow is composed of strange materials and bound together by subtle enchantments.  It is extremely light and accurate."
msgstr "이 활은 기묘한 재료들로 만들어졌고, 미묘한 마법으로 결속되어 있다. 매우 가볍고 정확하다."

#. assets_dev/engine/data_tables/items.txt record=1648 field=Name status=translated
msgctxt "engine:items.txt:1648:Name"
msgid "Stellar Bow"
msgstr "별빛 활"

#. assets_dev/engine/data_tables/items.txt record=1648 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1648:NotIdentifiedName"
msgid "Longbow"
msgstr "장궁"

#. assets_dev/engine/data_tables/items.txt record=1648 field=Notes status=translated
msgctxt "engine:items.txt:1648:Notes"
msgid "Created by stripping the Heavenly Forges of their enchanted parts when they became useless some years after the Silence, very few of these bows have survived the passage of time.  What few remain are hoarded by the Elves and individual collectors."
msgstr "침묵의 시대 이후 수년이 지나 천상의 대장간에서 마법이 걸린 부품들이 쓸모없게 되자, 그것들을 제거하여 만들어진 이 활들은 세월의 흐름 속에서 극소수만이 살아남았습니다. 현재 남아 있는 몇 안 되는 활들은 엘프들과 개인 수집가들에 의해 보관되고 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1649 field=Name status=translated
msgctxt "engine:items.txt:1649:Name"
msgid "Crossbow"
msgstr "석궁"

#. assets_dev/engine/data_tables/items.txt record=1649 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1649:NotIdentifiedName"
msgid "Crossbow"
msgstr "석궁"

#. assets_dev/engine/data_tables/items.txt record=1649 field=Notes status=translated
msgctxt "engine:items.txt:1649:Notes"
msgid "Crossbows are the deadliest ranged weapons made since the Time of Wonders.  This crossbow is made of stout Yew wood and metal fixtures, but is otherwise rather ordinary."
msgstr "석궁은 경이의 시대 이후로 만들어진 가장 치명적인 원거리 무기입니다. 이 석궁은 튼튼한 주목나무와 금속 부품으로 만들어졌지만, 그 외에는 꽤 평범합니다."

#. assets_dev/engine/data_tables/items.txt record=164 field=Name status=translated
msgctxt "engine:items.txt:164:Name"
msgid "Wizard Wand of Lightning"
msgstr "마법사의 번개 마법봉"

#. assets_dev/engine/data_tables/items.txt record=164 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:164:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=164 field=Notes status=translated
msgctxt "engine:items.txt:164:Notes"
msgid "A wand of highly polished thornbark wrapped with platinum wire. To use it, you must equip it like a weapon."
msgstr "매끄럽게 광택 처리된 가시나무 껍질에 백금선을 감싼 지팡이. 사용하려면 무기처럼 장착해야 한다."

#. assets_dev/engine/data_tables/items.txt record=1650 field=Name status=translated
msgctxt "engine:items.txt:1650:Name"
msgid "Accurate Crossbow"
msgstr "정확한 석궁"

#. assets_dev/engine/data_tables/items.txt record=1650 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1650:NotIdentifiedName"
msgid "Crossbow"
msgstr "석궁"

#. assets_dev/engine/data_tables/items.txt record=1650 field=Notes status=translated
msgctxt "engine:items.txt:1650:Notes"
msgid "These crossbows feature a section of curved wood next to the bowstaves, which helps prevent recoil, increasing their accuracy. It comes at the cost of a greater weight than that of lighter crossbows."
msgstr "이 석궁들은 활대 옆에 곡선형 나무 부분이 있어 반동을 줄여 적중률을 높여줍니다. 하지만 이로 인해 가벼운 석궁보다 무게가 더 나갑니다."

#. assets_dev/engine/data_tables/items.txt record=1651 field=Name status=translated
msgctxt "engine:items.txt:1651:Name"
msgid "True Crossbow"
msgstr "정교한 석궁"

#. assets_dev/engine/data_tables/items.txt record=1651 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1651:NotIdentifiedName"
msgid "Crossbow"
msgstr "석궁"

#. assets_dev/engine/data_tables/items.txt record=1651 field=Notes status=translated
msgctxt "engine:items.txt:1651:Notes"
msgid "Equipped with a hand crank and shaft sights, these exceptional crossbows are superior to all that have come before.  Just where they are coming from is a mystery at this time…"
msgstr "수동 크랭크와 샤프트 조준기를 장착한 이 탁월한 석궁은 이전의 어떤 석궁보다 뛰어납니다. 하지만 이 석궁이 어디에서 왔는지는 현재로서는 미스터리입니다…"

#. assets_dev/engine/data_tables/items.txt record=1652 field=Name status=translated
msgctxt "engine:items.txt:1652:Name"
msgid "Simple Mace"
msgstr "간소한 철퇴"

#. assets_dev/engine/data_tables/items.txt record=1652 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1652:NotIdentifiedName"
msgid "Mace"
msgstr "철퇴"

#. assets_dev/engine/data_tables/items.txt record=1652 field=Notes status=translated
msgctxt "engine:items.txt:1652:Notes"
msgid "Little more than a glorified club, this common mace is made of ordinary materials and unexceptional craftsmanship."
msgstr "이 흔한 철퇴는 그저 좀 더 고급스러운 곤봉에 불과하며, 평범한 재료와 특별할 것 없는 솜씨로 만들어졌습니다."

#. assets_dev/engine/data_tables/items.txt record=1653 field=Name status=translated
msgctxt "engine:items.txt:1653:Name"
msgid "Wicked Mace"
msgstr "사악한 철퇴"

#. assets_dev/engine/data_tables/items.txt record=1653 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1653:NotIdentifiedName"
msgid "Mace"
msgstr "철퇴"

#. assets_dev/engine/data_tables/items.txt record=1653 field=Notes status=translated
msgctxt "engine:items.txt:1653:Notes"
msgid "Solidly designed to inflict fatal injuries, even through armor.  The balance is a little top heavy, but the craftsmanship is good."
msgstr "갑옷을 뚫고도 치명적인 부상을 입힐 수 있도록 견고하게 설계되었습니다. 무게 중심이 약간 위쪽에 쏠려 있지만, 만듦새는 훌륭합니다."

#. assets_dev/engine/data_tables/items.txt record=1654 field=Name status=translated
msgctxt "engine:items.txt:1654:Name"
msgid "Thunder Mace"
msgstr "천둥 철퇴"

#. assets_dev/engine/data_tables/items.txt record=1654 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1654:NotIdentifiedName"
msgid "Mace"
msgstr "철퇴"

#. assets_dev/engine/data_tables/items.txt record=1654 field=Notes status=translated
msgctxt "engine:items.txt:1654:Notes"
msgid "This mace is one of thousands turned out by the Heavenly Forges before the Silence.  But that was more than a thousand years ago, and not many remain."
msgstr "이 철퇴는 침묵의 시대 이전에 천상의 대장간에서 만들어진 수천 개의 철퇴 중 하나입니다. 하지만 그것은 천 년도 더 전의 일이고, 지금은 얼마 남지 않았습니다."

#. assets_dev/engine/data_tables/items.txt record=1655 field=Name status=translated
msgctxt "engine:items.txt:1655:Name"
msgid "Wonder Mace"
msgstr "경이로운 철퇴"

#. assets_dev/engine/data_tables/items.txt record=1655 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1655:NotIdentifiedName"
msgid "Mace"
msgstr "철퇴"

#. assets_dev/engine/data_tables/items.txt record=1655 field=Notes status=translated
msgctxt "engine:items.txt:1655:Notes"
msgid "Only magic could make such an ungainly weapon so light and yet hit so hard."
msgstr "마법만이 이처럼 투박한 무기를 그토록 가볍게 만들면서도 강력한 타격을 가할 수 있을 것이다."

#. assets_dev/engine/data_tables/items.txt record=1656 field=Name status=translated
msgctxt "engine:items.txt:1656:Name"
msgid "Death Mace"
msgstr "죽음의 철퇴"

#. assets_dev/engine/data_tables/items.txt record=1656 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1656:NotIdentifiedName"
msgid "Mace"
msgstr "철퇴"

#. assets_dev/engine/data_tables/items.txt record=1656 field=Notes status=translated
msgctxt "engine:items.txt:1656:Notes"
msgid "Constructed by the Necromancer's guild just prior to their fall during the Succession War, these unusual weapons are almost always enchanted with powerful magics."
msgstr "계승 전쟁 중 네크로맨서 길드가 몰락하기 직전에 제작된 이 특이한 무기들은 거의 예외 없이 강력한 마법으로 강화되어 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1657 field=Name status=translated
msgctxt "engine:items.txt:1657:Name"
msgid "Massive Hammer"
msgstr "거대한 망치"

#. assets_dev/engine/data_tables/items.txt record=1657 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1657:NotIdentifiedName"
msgid "Hammer"
msgstr "망치"

#. assets_dev/engine/data_tables/items.txt record=1657 field=Notes status=translated
msgctxt "engine:items.txt:1657:Notes"
msgid "A graceless and unimaginative weapon, hammers are slow, but hit very hard.  This one is of common construction and materials."
msgstr "투박하고 상상력이 부족한 무기인 망치는 속도는 느리지만 매우 강력한 타격을 가할 수 있습니다. 이 망치는 흔한 구조와 재료로 만들어졌습니다."

#. assets_dev/engine/data_tables/items.txt record=1658 field=Name status=translated
msgctxt "engine:items.txt:1658:Name"
msgid "Dark Hammer"
msgstr "어둠의 망치"

#. assets_dev/engine/data_tables/items.txt record=1658 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1658:NotIdentifiedName"
msgid "Hammer"
msgstr "망치"

#. assets_dev/engine/data_tables/items.txt record=1658 field=Notes status=translated
msgctxt "engine:items.txt:1658:Notes"
msgid "A step up in construction quality, these hammers are commonly wielded by humanoid monsters.  Since everyone knows most monsters don't make weapons, the question 'from where are they getting them?' arises…"
msgstr "제작 품질이 한 단계 향상된 이 망치는 주로 인간형 괴물들이 휘두릅니다. 대부분의 괴물들이 무기를 만들지 않는다는 것은 누구나 아는 사실이기에, '도대체 저 망치들은 어디서 구하는 걸까?'라는 의문이 생깁니다."

#. assets_dev/engine/data_tables/items.txt record=1659 field=Name status=translated
msgctxt "engine:items.txt:1659:Name"
msgid "Holy Hammer"
msgstr "성스러운 망치"

#. assets_dev/engine/data_tables/items.txt record=1659 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1659:NotIdentifiedName"
msgid "Hammer"
msgstr "망치"

#. assets_dev/engine/data_tables/items.txt record=1659 field=Notes status=translated
msgctxt "engine:items.txt:1659:Notes"
msgid "Magically constructed, these hammers are the property of the Church of the Moon in Karigor."
msgstr "마법으로 만들어진 이 망치들은 카리고르에 있는 달의 교회의 소유물입니다."

#. assets_dev/engine/data_tables/items.txt record=165 field=Name status=translated
msgctxt "engine:items.txt:165:Name"
msgid "Wizard Wand of Blades"
msgstr "마법사의 칼날 마법봉"

#. assets_dev/engine/data_tables/items.txt record=165 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:165:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=165 field=Notes status=translated
msgctxt "engine:items.txt:165:Notes"
msgid "A wand of highly polished thornbark wrapped with platinum wire. To use it, you must equip it like a weapon."
msgstr "매끄럽게 광택 처리된 가시나무 껍질에 백금선을 감싼 지팡이. 사용하려면 무기처럼 장착해야 한다."

#. assets_dev/engine/data_tables/items.txt record=1660 field=Name status=translated
msgctxt "engine:items.txt:1660:Name"
msgid "Root Club"
msgstr "뿌리 곤봉"

#. assets_dev/engine/data_tables/items.txt record=1660 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1660:NotIdentifiedName"
msgid "Club"
msgstr "곤봉"

#. assets_dev/engine/data_tables/items.txt record=1660 field=Notes status=translated
msgctxt "engine:items.txt:1660:Notes"
msgid "A primitive weapon usable by even the stupidest of monsters.  You're not thinking of using this, are you?"
msgstr "가장 멍청한 괴물조차도 사용할 수 있는 원시적인 무기군. 설마 이걸 쓰려는 건 아니겠지?"

#. assets_dev/engine/data_tables/items.txt record=1661 field=Name status=translated
msgctxt "engine:items.txt:1661:Name"
msgid "Spiked Club"
msgstr "가시 박힌 곤봉"

#. assets_dev/engine/data_tables/items.txt record=1661 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1661:NotIdentifiedName"
msgid "Club"
msgstr "곤봉"

#. assets_dev/engine/data_tables/items.txt record=1661 field=Notes status=translated
msgctxt "engine:items.txt:1661:Notes"
msgid "An improvement over the simple club, this spiked club will inflict nastier wounds."
msgstr "단순한 곤봉보다 훨씬 강력한 이 뾰족한 곤봉은 더 심한 상처를 입힐 것입니다."

#. assets_dev/engine/data_tables/items.txt record=1662 field=Name status=translated
msgctxt "engine:items.txt:1662:Name"
msgid "Killer Club"
msgstr "살상용 곤봉"

#. assets_dev/engine/data_tables/items.txt record=1662 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1662:NotIdentifiedName"
msgid "Club"
msgstr "곤봉"

#. assets_dev/engine/data_tables/items.txt record=1662 field=Notes status=translated
msgctxt "engine:items.txt:1662:Notes"
msgid "King of the club family.  If this weapon had a knob or ball on the end, it would be a mace.  There is evidence of real craftsmanship in this club, but you can see no true identifying marks that would indicate who created it."
msgstr "곤봉류의 왕이라 할 수 있는 무기입니다. 만약 끝에 손잡이나 공 모양의 장식이 있었다면 철퇴였을 것입니다. 이 곤봉에는 뛰어난 장인 정신이 깃들어 있지만, 누가 만들었는지 알 수 있는 확실한 표식은 없습니다."

#. assets_dev/engine/data_tables/items.txt record=1663 field=Name status=translated
msgctxt "engine:items.txt:1663:Name"
msgid "Staff"
msgstr "지팡이"

#. assets_dev/engine/data_tables/items.txt record=1663 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1663:NotIdentifiedName"
msgid "Staff"
msgstr "지팡이"

#. assets_dev/engine/data_tables/items.txt record=1663 field=Notes status=translated
msgctxt "engine:items.txt:1663:Notes"
msgid "The staff is the traditional weapon of the oppressed.  This one is unremarkable, and the ruby at the end of it is actually just colored glass."
msgstr "지팡이는 억압받는 자들의 전통적인 무기입니다. 이 지팡이는 특별할 것 없고, 끝에 달린 루비는 사실 색깔 있는 유리 조각일 뿐입니다."

#. assets_dev/engine/data_tables/items.txt record=1664 field=Name status=translated
msgctxt "engine:items.txt:1664:Name"
msgid "Emerald Staff"
msgstr "에메랄드 지팡이"

#. assets_dev/engine/data_tables/items.txt record=1664 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1664:NotIdentifiedName"
msgid "Staff"
msgstr "지팡이"

#. assets_dev/engine/data_tables/items.txt record=1664 field=Notes status=translated
msgctxt "engine:items.txt:1664:Notes"
msgid "Magically light and hard, this staff is made of a rare wood stripped from the Elves during the Timber War in 600 A.S.  The emerald at the end of it is real, and probably serves as a magical reservoir from which the staff draws its strength."
msgstr "마법처럼 가볍고 단단한 이 지팡이는 서기 600년 목재 전쟁 당시 엘프들에게서 빼앗은 희귀한 나무로 만들어졌습니다. 지팡이 끝에 박힌 에메랄드는 진짜이며, 아마도 지팡이가 힘을 끌어내는 마법의 저장소 역할을 하는 것으로 추정됩니다."

#. assets_dev/engine/data_tables/items.txt record=1665 field=Name status=translated
msgctxt "engine:items.txt:1665:Name"
msgid "Power Staff"
msgstr "힘의 지팡이"

#. assets_dev/engine/data_tables/items.txt record=1665 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1665:NotIdentifiedName"
msgid "Staff"
msgstr "지팡이"

#. assets_dev/engine/data_tables/items.txt record=1665 field=Notes status=translated
msgctxt "engine:items.txt:1665:Notes"
msgid "This staff, along with others of its kind, was found in the treasure room of the Necromancer's guild after their disastrous defeat by Roland at the end of the Succession War."
msgstr "이 지팡이는 다른 유사한 지팡이들과 함께 계승 전쟁 말기에 롤랜드에게 참패한 네크로맨서 길드의 보물창고에서 발견되었습니다."

#. assets_dev/engine/data_tables/items.txt record=1666 field=Name status=translated
msgctxt "engine:items.txt:1666:Name"
msgid "Blaster"
msgstr "블래스터"

#. assets_dev/engine/data_tables/items.txt record=1666 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1666:NotIdentifiedName"
msgid "Ancient Weapon"
msgstr "고대 무기"

#. assets_dev/engine/data_tables/items.txt record=1666 field=Notes status=translated
msgctxt "engine:items.txt:1666:Notes"
msgid "A weapon of awesome power, clearly created during the Time of Wonders.  "
msgstr "엄청난 위력을 지닌 무기로, 틀림없이 경이의 시대에 만들어졌을 것이다.  "

#. assets_dev/engine/data_tables/items.txt record=1667 field=Name status=translated
msgctxt "engine:items.txt:1667:Name"
msgid "Blaster Rifle"
msgstr "블래스터 소총"

#. assets_dev/engine/data_tables/items.txt record=1667 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1667:NotIdentifiedName"
msgid "Ancient Weapon"
msgstr "고대 무기"

#. assets_dev/engine/data_tables/items.txt record=1667 field=Notes status=translated
msgctxt "engine:items.txt:1667:Notes"
msgid "The finest of personal weapons made during the Time of Wonders, this Blaster Rifle can deal death faster than any weapon you have ever seen."
msgstr "경이의 시대에 만들어진 최고의 개인 화기인 이 블래스터 소총은 당신이 지금까지 본 어떤 무기보다도 빠르게 적을 처치할 수 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1668 field=Name status=translated
msgctxt "engine:items.txt:1668:Name"
msgid "Leather Armor"
msgstr "가죽 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1668 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1668:NotIdentifiedName"
msgid "Leather Armor"
msgstr "가죽 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1668 field=Notes status=translated
msgctxt "engine:items.txt:1668:Notes"
msgid "Lightest and most easily made among the armors, leather armor offers the least protection.  This particular suit is of average quality."
msgstr "가죽 갑옷은 갑옷 중에서 가장 가볍고 제작하기 쉽지만, 보호력은 가장 떨어집니다. 이 갑옷은 평균적인 품질입니다."

#. assets_dev/engine/data_tables/items.txt record=1669 field=Name status=translated
msgctxt "engine:items.txt:1669:Name"
msgid "Reinforced Leather"
msgstr "강화 가죽 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1669 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1669:NotIdentifiedName"
msgid "Leather Armor"
msgstr "가죽 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1669 field=Notes status=translated
msgctxt "engine:items.txt:1669:Notes"
msgid "Studded leather offers more protection than regular leather armor at the expense of being stiffer and weighing more.  This particular suit is well made."
msgstr "징이 박힌 가죽은 일반 가죽 갑옷보다 보호력이 뛰어나지만, 더 뻣뻣하고 무겁습니다. 이 갑옷은 특히 잘 만들어졌습니다."

#. assets_dev/engine/data_tables/items.txt record=166 field=Name status=translated
msgctxt "engine:items.txt:166:Name"
msgid "Wizard Wand of Berzerking"
msgstr "마법사의 광폭화 마법봉"

#. assets_dev/engine/data_tables/items.txt record=166 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:166:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=166 field=Notes status=translated
msgctxt "engine:items.txt:166:Notes"
msgid "A wand of highly polished thornbark wrapped with platinum wire. To use it, you must equip it like a weapon."
msgstr "매끄럽게 광택 처리된 가시나무 껍질에 백금선을 감싼 지팡이. 사용하려면 무기처럼 장착해야 한다."

#. assets_dev/engine/data_tables/items.txt record=1670 field=Name status=translated
msgctxt "engine:items.txt:1670:Name"
msgid "Enchanted Leather"
msgstr "마법의 가죽 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1670 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1670:NotIdentifiedName"
msgid "Leather Armor"
msgstr "가죽 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1670 field=Notes status=translated
msgctxt "engine:items.txt:1670:Notes"
msgid "A subtly enchanted suit of armor that is much stronger than its weight would suggest. Shoulder and waist pads offer added protection with no cost to freedom of movement."
msgstr "은은한 마법이 깃든 갑옷으로, 무게에 비해 훨씬 강력한 내구성을 자랑합니다. 어깨와 허리 보호대는 움직임의 자유를 제한하지 않으면서도 추가적인 보호 기능을 제공합니다."

#. assets_dev/engine/data_tables/items.txt record=1671 field=Name status=translated
msgctxt "engine:items.txt:1671:Name"
msgid "Dragon Leather"
msgstr "드래곤 가죽 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1671 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1671:NotIdentifiedName"
msgid "Leather Armor"
msgstr "가죽 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1671 field=Notes status=translated
msgctxt "engine:items.txt:1671:Notes"
msgid "Standard issue leather armor for officers in the Regnan Navy.  All such leather armor receives enchantments to strengthen and lighten it during its creation in the Regnan Armories. This particular suit is a somewhat heavier than usual variation with a bit more body coverage."
msgstr "레그나 해군 장교용 표준 가죽 갑옷입니다. 모든 가죽 갑옷은 레그나 무기고에서 제작될 때 강화 및 경량화 마법이 부여됩니다. 이 갑옷은 일반적인 갑옷보다 약간 더 무겁고 신체를 더 많이 덮는 형태입니다."

#. assets_dev/engine/data_tables/items.txt record=1672 field=Name status=translated
msgctxt "engine:items.txt:1672:Name"
msgid "Imperial Leather"
msgstr "제국 가죽 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1672 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1672:NotIdentifiedName"
msgid "Leather Armor"
msgstr "가죽 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1672 field=Notes status=translated
msgctxt "engine:items.txt:1672:Notes"
msgid "An extremely rare suit of leather armor created during the conflicts between the Church of the Moon and the Church of the Sun roughly 80 years ago.  These suits provide the finest protection available with leather armor."
msgstr "약 80년 전 달의 교단과 태양의 교단 간의 분쟁 중에 제작된 극히 희귀한 가죽 갑옷입니다. 이 갑옷은 가죽 갑옷으로서 최고의 보호력을 제공합니다."

#. assets_dev/engine/data_tables/items.txt record=1673 field=Name status=translated
msgctxt "engine:items.txt:1673:Name"
msgid "Chain Mail"
msgstr "사슬 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1673 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1673:NotIdentifiedName"
msgid "Chain Mail"
msgstr "사슬 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1673 field=Notes status=translated
msgctxt "engine:items.txt:1673:Notes"
msgid "Chain mail is an armor formed of small, interlocking loops of metal.  This suit is low quality:  the metal used is plain iron, there are only two layers of rings, and it is heavy and stiff for its size. Despite beginning to corrode, it has so far remained intact."
msgstr "사슬 갑옷은 작은 금속 고리들을 서로 맞물려 만든 갑옷입니다. 이 갑옷은 질이 좋지 않습니다. 사용된 금속은 평범한 철이고, 고리는 두 겹으로만 되어 있으며, 크기에 비해 무겁고 뻣뻣합니다. 부식이 시작되었음에도 불구하고 아직까지는 온전한 상태를 유지하고 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1674 field=Name status=translated
msgctxt "engine:items.txt:1674:Name"
msgid "Basic Steel Chain Mail"
msgstr "기본 강철 사슬 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1674 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1674:NotIdentifiedName"
msgid "Chain Mail"
msgstr "사슬 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1674 field=Notes status=translated
msgctxt "engine:items.txt:1674:Notes"
msgid "A superior suit of chain mail, the metal used in this suit is steel, and the former owner was careful to keep the suit well oiled and free of rust. Its coverage of areas below the waist could have been better, though."
msgstr "최고급 사슬 갑옷인 이 갑옷은 강철로 만들어졌으며, 이전 소유자는 갑옷에 기름칠을 잘 하고 녹이 슬지 않도록 세심하게 관리했습니다. 다만 허리 아래 부분을 덮는 부분이 좀 더 촘촘했으면 좋았을 것입니다."

#. assets_dev/engine/data_tables/items.txt record=1675 field=Name status=translated
msgctxt "engine:items.txt:1675:Name"
msgid "Noble Chain Mail"
msgstr "귀족의 사슬 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1675 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1675:NotIdentifiedName"
msgid "Chain Mail"
msgstr "사슬 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1675 field=Notes status=translated
msgctxt "engine:items.txt:1675:Notes"
msgid "Cavalry officer's chain mail from the reign of Taledon V of Karigor, Divine High Priest and High Holy Conduit of the Church of the Sun, circa 870 A.S.  The armor is high quality chain, enchanted to lighten and strengthen the metal."
msgstr "태양 교회의 최고 사제이자 대성스러운 통로였던 카리고르의 탈레돈 5세 통치 시대(서기 870년경)의 기병 장교용 사슬 갑옷입니다. 이 갑옷은 고급 사슬로 만들어졌으며, 금속을 가볍고 강하게 만드는 마법이 걸려 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1676 field=Name status=translated
msgctxt "engine:items.txt:1676:Name"
msgid "Royal Chain Mail"
msgstr "왕실 사슬 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1676 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1676:NotIdentifiedName"
msgid "Chain Mail"
msgstr "사슬 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1676 field=Notes status=translated
msgctxt "engine:items.txt:1676:Notes"
msgid "Highly enchanted armor worn by elvish nobility and royalty during the Timber Wars of the seventh and eighth centuries."
msgstr "7세기와 8세기 목재 전쟁 당시 엘프 귀족과 왕족이 착용했던 강력한 마법이 걸린 갑옷."

#. assets_dev/engine/data_tables/items.txt record=1677 field=Name status=translated
msgctxt "engine:items.txt:1677:Name"
msgid "Majestic Chain Mail"
msgstr "장엄한 사슬 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1677 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1677:NotIdentifiedName"
msgid "Chain Mail"
msgstr "사슬 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1677 field=Notes status=translated
msgctxt "engine:items.txt:1677:Notes"
msgid "A model of armor from before the Silence -- one could see it worn by the Governor and his closest associates as a badge of office. The formula for creating these suits is quite old, in fact it was adjusted not long before the Forges broke down. As such, this chain mail is superior to most other such armors in the world today -- though still surpassed by suits created in the years just before the Silence."
msgstr "침묵의 시대 이전의 갑옷 모형입니다. 총독과 그의 측근들이 직위를 상징하는 표식으로 착용했던 것입니다. 이 갑옷을 만드는 제조법은 아주 오래되었으며, 실제로 대장간이 붕괴되기 직전에 수정되었습니다. 따라서 이 사슬 갑옷은 오늘날 세계의 다른 갑옷들보다 우수하지만, 침묵의 시대 직전에 만들어진 갑옷보다는 여전히 떨어집니다."

#. assets_dev/engine/data_tables/items.txt record=1678 field=Name status=translated
msgctxt "engine:items.txt:1678:Name"
msgid "Plate Mail"
msgstr "판금 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1678 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1678:NotIdentifiedName"
msgid "Plate Armor"
msgstr "판금 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1678 field=Notes status=translated
msgctxt "engine:items.txt:1678:Notes"
msgid "Composed of interlocking plates and joints, plate armor is the best unenchanted armor available.  It is, however, heavy and slows the movements of the wearer.  This particular suit is of average quality and the smith unknown."
msgstr "서로 맞물리는 판금으로 구성된 판금 갑옷은 마법이 부여되지 않은 갑옷 중 최고의 성능을 자랑합니다. 하지만 무거워 착용자의 움직임을 둔화시킵니다. 이 갑옷은 평균적인 품질이며 제작자는 알려지지 않았습니다."

#. assets_dev/engine/data_tables/items.txt record=1679 field=Name status=translated
msgctxt "engine:items.txt:1679:Name"
msgid "Steel Plate Mail"
msgstr "강철 판금 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1679 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1679:NotIdentifiedName"
msgid "Plate Armor"
msgstr "판금 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1679 field=Notes status=translated
msgctxt "engine:items.txt:1679:Notes"
msgid "Well constructed plates of steel work together to form an overall excellent suit of armor.  A foundry stamp under the right arm indicates it was forged recently in Kelebrim."
msgstr "정교하게 제작된 강철판들이 서로 맞물려 훌륭한 갑옷을 이룬다. 오른쪽 팔 아래에 찍힌 주조 공장 도장은 이 갑옷이 최근 켈레브림에서 제작되었음을 나타낸다."

#. assets_dev/engine/data_tables/items.txt record=167 field=Name status=translated
msgctxt "engine:items.txt:167:Name"
msgid "Serpent Wand of Blasting"
msgstr "뱀 폭발 마법봉"

#. assets_dev/engine/data_tables/items.txt record=167 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:167:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=167 field=Notes status=translated
msgctxt "engine:items.txt:167:Notes"
msgid "Made from the braided bodies of three snakes, this wand pulses like a slow heartbeat. To use it you must equip it like a weapon."
msgstr "세 마리 뱀의 몸을 엮어 만든 이 지팡이는 마치 느린 심장 박동처럼 맥동합니다. 사용하려면 무기처럼 장착해야 합니다."

#. assets_dev/engine/data_tables/items.txt record=1680 field=Name status=translated
msgctxt "engine:items.txt:1680:Name"
msgid "Golden Plate Mail"
msgstr "황금 판금 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1680 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1680:NotIdentifiedName"
msgid "Plate Armor"
msgstr "판금 갑옷"

#. assets_dev/engine/data_tables/items.txt record=1680 field=Notes status=translated
msgctxt "engine:items.txt:1680:Notes"
msgid "This suit of plate armor was forged in the Mekorig foundry eighteen years after the death of Mekorig the Blind.  A masterwork, the armor is almost as easy to wear as ordinary clothes, and is probably the best armor available in the world."
msgstr "이 판금 갑옷은 장님 메코리그가 죽은 지 18년 후에 메코리그 주조소에서 제작되었습니다. 걸작인 이 갑옷은 일반 옷처럼 입기 편하며, 아마도 세상에서 가장 뛰어난 갑옷일 것입니다."

#. assets_dev/engine/data_tables/items.txt record=1681 field=Name status=translated
msgctxt "engine:items.txt:1681:Name"
msgid "Kite Shield"
msgstr "연꼴 방패"

#. assets_dev/engine/data_tables/items.txt record=1681 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1681:NotIdentifiedName"
msgid "Large Shield"
msgstr "대형 방패"

#. assets_dev/engine/data_tables/items.txt record=1681 field=Notes status=translated
msgctxt "engine:items.txt:1681:Notes"
msgid "Formed of stretched hides over a wooden frame, this simple shield provides basic protection against physical attacks."
msgstr "나무 틀에 가죽을 씌워 만든 이 단순한 방패는 물리적 공격으로부터 기본적인 보호를 제공합니다."

#. assets_dev/engine/data_tables/items.txt record=1682 field=Name status=translated
msgctxt "engine:items.txt:1682:Name"
msgid "Tower Shield"
msgstr "대형 방패"

#. assets_dev/engine/data_tables/items.txt record=1682 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1682:NotIdentifiedName"
msgid "Large Shield"
msgstr "대형 방패"

#. assets_dev/engine/data_tables/items.txt record=1682 field=Notes status=translated
msgctxt "engine:items.txt:1682:Notes"
msgid "The simplicity of the heraldic design on this shield leads one to believe it was created either by barbarians or goblins.  It is made of sturdy materials and should stand up reasonably well in combat."
msgstr "이 방패에 새겨진 문장의 단순함을 보면 야만인이나 고블린이 만들었을 것이라고 짐작할 수 있다. 튼튼한 재질로 만들어져 전투에서 꽤 잘 견딜 것으로 보인다."

#. assets_dev/engine/data_tables/items.txt record=1683 field=Name status=translated
msgctxt "engine:items.txt:1683:Name"
msgid "Castle Shield"
msgstr "성채 방패"

#. assets_dev/engine/data_tables/items.txt record=1683 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1683:NotIdentifiedName"
msgid "Large Shield"
msgstr "대형 방패"

#. assets_dev/engine/data_tables/items.txt record=1683 field=Notes status=translated
msgctxt "engine:items.txt:1683:Notes"
msgid "This shield is made of wood framed by iron.  It is somewhat heavy for its size, but it should see you through a battle safely--as long as  you're not backstabbed."
msgstr "이 방패는 철제 틀에 나무를 덧댄 구조입니다. 크기에 비해 다소 무겁지만, 뒤에서 칼에 찔리지 않는 한 전투에서 안전하게 지켜줄 것입니다."

#. assets_dev/engine/data_tables/items.txt record=1684 field=Name status=translated
msgctxt "engine:items.txt:1684:Name"
msgid "Celestial Shield"
msgstr "천상의 방패"

#. assets_dev/engine/data_tables/items.txt record=1684 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1684:NotIdentifiedName"
msgid "Large Shield"
msgstr "대형 방패"

#. assets_dev/engine/data_tables/items.txt record=1684 field=Notes status=translated
msgctxt "engine:items.txt:1684:Notes"
msgid "Made of a lightweight metal, this shield has a foundry stamp from the Kelebrim armory.  Though light, the material is very strong, and the metal is welded almost seamlessly.  "
msgstr "이 방패는 가벼운 금속으로 만들어졌으며, 켈레브림 무기고의 주조 도장이 찍혀 있습니다. 가볍지만 재질은 매우 견고하며, 금속은 거의 이음새 없이 용접되어 있습니다.  "

#. assets_dev/engine/data_tables/items.txt record=1685 field=Name status=translated
msgctxt "engine:items.txt:1685:Name"
msgid "Olympian Shield"
msgstr "올림포스의 방패"

#. assets_dev/engine/data_tables/items.txt record=1685 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1685:NotIdentifiedName"
msgid "Large Shield"
msgstr "대형 방패"

#. assets_dev/engine/data_tables/items.txt record=1685 field=Notes status=translated
msgctxt "engine:items.txt:1685:Notes"
msgid "This round shield is a design of the long gone Phynaxian empire that once ruled southern Erathia. Forged of stalt, it is extremely sturdy and susceptible to enchantments. It's so well-made that its only downside seems to be its rather compact size for a large shield, which somewhat limits its coverage."
msgstr "이 원형 방패는 한때 에라시아 남부를 지배했던 오래전에 사라진 피낙시아 제국의 디자인입니다. 강철로 만들어져 매우 견고하며 마법 부여에 취약합니다. 워낙 잘 만들어진 방패라 단점이라면 크기가 다소 작아 방어 범위가 제한적이라는 점입니다."

#. assets_dev/engine/data_tables/items.txt record=1686 field=Name status=translated
msgctxt "engine:items.txt:1686:Name"
msgid "Splintery Buckler"
msgstr "가시투성이 소형 방패"

#. assets_dev/engine/data_tables/items.txt record=1686 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1686:NotIdentifiedName"
msgid "Small Shield"
msgstr "소형 방패"

#. assets_dev/engine/data_tables/items.txt record=1686 field=Notes status=translated
msgctxt "engine:items.txt:1686:Notes"
msgid "A small wooden shield designed to protect mostly against arrows. The wood it is made of was never properly planed, making its surface full of splinters and chips. Its remaining lifetime in combat is likely much shorter than you'd like."
msgstr "화살을 막기 위해 만들어진 작은 나무 방패입니다. 나무를 제대로 다듬지 않아 표면에 가시와 부스러기가 가득합니다. 전투에서 이 방패의 수명은 당신이 바라는 것보다 훨씬 짧을 가능성이 큽니다."

#. assets_dev/engine/data_tables/items.txt record=1687 field=Name status=translated
msgctxt "engine:items.txt:1687:Name"
msgid "Rusty Bronze Shield"
msgstr "녹슨 청동 방패"

#. assets_dev/engine/data_tables/items.txt record=1687 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1687:NotIdentifiedName"
msgid "Small Shield"
msgstr "소형 방패"

#. assets_dev/engine/data_tables/items.txt record=1687 field=Notes status=translated
msgctxt "engine:items.txt:1687:Notes"
msgid "Bronze shields are lighter than iron shields of the same size, but aren't nearly as strong."
msgstr "청동 방패는 같은 크기의 철 방패보다 가볍지만, 강도는 훨씬 떨어집니다."

#. assets_dev/engine/data_tables/items.txt record=1688 field=Name status=translated
msgctxt "engine:items.txt:1688:Name"
msgid "Steel Shield"
msgstr "강철 방패"

#. assets_dev/engine/data_tables/items.txt record=1688 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1688:NotIdentifiedName"
msgid "Small Shield"
msgstr "소형 방패"

#. assets_dev/engine/data_tables/items.txt record=1688 field=Notes status=translated
msgctxt "engine:items.txt:1688:Notes"
msgid "Since this shield is made of tempered steel, it should resist all but the most unusual of enchanted weapons."
msgstr "이 방패는 강화강철로 만들어졌으므로, 아주 특이한 마법 무기를 제외하고는 모든 공격에 견딜 수 있을 것입니다."

#. assets_dev/engine/data_tables/items.txt record=1689 field=Name status=translated
msgctxt "engine:items.txt:1689:Name"
msgid "Spirit Shield"
msgstr "영혼 방패"

#. assets_dev/engine/data_tables/items.txt record=1689 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1689:NotIdentifiedName"
msgid "Small Shield"
msgstr "소형 방패"

#. assets_dev/engine/data_tables/items.txt record=1689 field=Notes status=translated
msgctxt "engine:items.txt:1689:Notes"
msgid "Spirit shields are ordinary steel shields enchanted through a ritualistic process that can have powerful, albeit unpredictable results.  The process is time consuming and requires the undivided attention of at least three masters of Spirit magic."
msgstr "영혼 방패는 일반 강철 방패에 의식적인 과정을 통해 마법을 부여한 것으로, 강력하지만 예측 불가능한 효과를 지닙니다. 이 과정은 시간이 오래 걸리고 최소 세 명의 영혼 마법사의 전적인 집중이 필요합니다."

#. assets_dev/engine/data_tables/items.txt record=168 field=Name status=translated
msgctxt "engine:items.txt:168:Name"
msgid "Serpent Wand of the Fist"
msgstr "뱀 주먹 마법봉"

#. assets_dev/engine/data_tables/items.txt record=168 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:168:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=168 field=Notes status=translated
msgctxt "engine:items.txt:168:Notes"
msgid "Made from the braided bodies of three snakes, this wand pulses like a slow heartbeat. To use it you must equip it like a weapon."
msgstr "세 마리 뱀의 몸을 엮어 만든 이 지팡이는 마치 느린 심장 박동처럼 맥동합니다. 사용하려면 무기처럼 장착해야 합니다."

#. assets_dev/engine/data_tables/items.txt record=1690 field=Name status=translated
msgctxt "engine:items.txt:1690:Name"
msgid "Astral Shield"
msgstr "아스트랄 방패"

#. assets_dev/engine/data_tables/items.txt record=1690 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1690:NotIdentifiedName"
msgid "Small Shield"
msgstr "소형 방패"

#. assets_dev/engine/data_tables/items.txt record=1690 field=Notes status=translated
msgctxt "engine:items.txt:1690:Notes"
msgid "These rare shields were turned out by the hundreds with the aid of the Heavenly Forges to combat rebel forces in the endless string of skirmishes and supply raids that tested (and finally overcame) the Governor's forces in the first century A.S.  As with all such equipment, it is light, tough, and is capable of holding the most powerful enchantments."
msgstr "이 희귀한 방패는 천상의 대장간의 도움으로 수백 개씩 생산되어, 기원후 1세기 동안 총독의 군대가 끊임없이 겪었던 소규모 전투와 보급품 약탈에서 반란군에 맞서 싸우는 데 사용되었습니다. 이러한 장비들이 그러하듯, 이 방패는 가볍고 튼튼하며 가장 강력한 마법을 담을 수 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1691 field=Name status=translated
msgctxt "engine:items.txt:1691:Name"
msgid "Wooden Helm"
msgstr "나무 투구"

#. assets_dev/engine/data_tables/items.txt record=1691 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1691:NotIdentifiedName"
msgid "Helm"
msgstr "투구"

#. assets_dev/engine/data_tables/items.txt record=1691 field=Notes status=translated
msgctxt "engine:items.txt:1691:Notes"
msgid "An ordinary helm.  This one is made of hides stretched over wood.  There's no fur or padding on the inside, so your head will probably ring like a bell when struck a solid blow."
msgstr "평범한 투구입니다. 나무 위에 가죽을 씌워 만들었죠. 안쪽에는 털이나 솜이 없어서 세게 치면 머리가 종처럼 쨍쨍 울릴 겁니다."

#. assets_dev/engine/data_tables/items.txt record=1692 field=Name status=translated
msgctxt "engine:items.txt:1692:Name"
msgid "Steel Helm"
msgstr "강철 투구"

#. assets_dev/engine/data_tables/items.txt record=1692 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1692:NotIdentifiedName"
msgid "Helm"
msgstr "투구"

#. assets_dev/engine/data_tables/items.txt record=1692 field=Notes status=translated
msgctxt "engine:items.txt:1692:Notes"
msgid "This is a common steel helm.  The design is a good one and has been used for centuries by warriors all around the world.  Best guess is this helm is 50-75 years old."
msgstr "이것은 흔히 볼 수 있는 강철 투구입니다. 디자인이 훌륭해서 수 세기 동안 전 세계 전사들이 사용해 왔습니다. 이 투구는 대략 50년에서 75년 정도 된 것으로 추정됩니다."

#. assets_dev/engine/data_tables/items.txt record=1693 field=Name status=translated
msgctxt "engine:items.txt:1693:Name"
msgid "Guardian Helm"
msgstr "수호자의 투구"

#. assets_dev/engine/data_tables/items.txt record=1693 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1693:NotIdentifiedName"
msgid "Helm"
msgstr "투구"

#. assets_dev/engine/data_tables/items.txt record=1693 field=Notes status=translated
msgctxt "engine:items.txt:1693:Notes"
msgid "This helm design has been used by the Elves of Erathia since before the Silence. Its wing ornaments belie superior strength and add a sense of distinction for the Elven leaders who got to go into battle wearing these helms."
msgstr "이 투구 디자인은 에라시아의 엘프들이 침묵의 시대 이전부터 사용해 온 것입니다. 날개 장식은 뛰어난 힘을 암시하며, 이 투구를 쓰고 전투에 나서는 엘프 지도자들에게 특별한 위엄을 더해줍니다."

#. assets_dev/engine/data_tables/items.txt record=1694 field=Name status=translated
msgctxt "engine:items.txt:1694:Name"
msgid "Defender Helm"
msgstr "방어자의 투구"

#. assets_dev/engine/data_tables/items.txt record=1694 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1694:NotIdentifiedName"
msgid "Helm"
msgstr "투구"

#. assets_dev/engine/data_tables/items.txt record=1694 field=Notes status=translated
msgctxt "engine:items.txt:1694:Notes"
msgid "Half made from the skull of the ferocious Mogred beast in Karigor, these helms grow more uncommon every year as the Mogreds approach extinction.  The red stripes around the horns of the helm are highly receptive to enchantment."
msgstr "카리고르에 서식하는 흉포한 모그레드 괴물의 두개골로 반쯤 만들어진 이 투구는 모그레드 종족이 멸종 위기에 처함에 따라 해마다 점점 더 희귀해지고 있습니다. 투구 뿔 주변의 붉은 줄무늬는 마법 부여에 매우 효과적입니다."

#. assets_dev/engine/data_tables/items.txt record=1695 field=Name status=translated
msgctxt "engine:items.txt:1695:Name"
msgid "Angelic Helm"
msgstr "천사의 투구"

#. assets_dev/engine/data_tables/items.txt record=1695 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1695:NotIdentifiedName"
msgid "Helm"
msgstr "투구"

#. assets_dev/engine/data_tables/items.txt record=1695 field=Notes status=translated
msgctxt "engine:items.txt:1695:Notes"
msgid "These helms are extremely rare and no one knows where they originate, but they almost certainly come from the Time of Wonders.  An extremely fine inscription inside the helm says  'Property of Ship's Store, VARN MCMIV'."
msgstr "이 투구는 극히 희귀하며 그 기원은 알려지지 않았지만, 거의 확실히 경이의 시대에 만들어진 유물일 것입니다. 투구 안쪽에는 '선박창 소유, VARN MCMIV'라는 매우 정교한 명문이 새겨져 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1696 field=Name status=translated
msgctxt "engine:items.txt:1696:Name"
msgid "Cloth Hat"
msgstr "천 모자"

#. assets_dev/engine/data_tables/items.txt record=1696 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1696:NotIdentifiedName"
msgid "Hat"
msgstr "모자"

#. assets_dev/engine/data_tables/items.txt record=1696 field=Notes status=translated
msgctxt "engine:items.txt:1696:Notes"
msgid "A common hat.  The material is a blend of cotton and wool, and the feather is from a duck."
msgstr "흔히 볼 수 있는 모자입니다. 소재는 면과 양모 혼방이며, 깃털은 오리털입니다."

#. assets_dev/engine/data_tables/items.txt record=1697 field=Name status=translated
msgctxt "engine:items.txt:1697:Name"
msgid "Dandy Hat"
msgstr "멋쟁이 모자"

#. assets_dev/engine/data_tables/items.txt record=1697 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1697:NotIdentifiedName"
msgid "Hat"
msgstr "모자"

#. assets_dev/engine/data_tables/items.txt record=1697 field=Notes status=translated
msgctxt "engine:items.txt:1697:Notes"
msgid "Quite fashionable and stylish, these hats are in vogue amongst the upper classes and those seeking to emulate them."
msgstr "세련되고 스타일리시한 이 모자들은 상류층과 그들을 따라하고 싶어하는 사람들 사이에서 유행하고 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1698 field=Name status=translated
msgctxt "engine:items.txt:1698:Name"
msgid "Wizard Cap"
msgstr "마법사의 모자"

#. assets_dev/engine/data_tables/items.txt record=1698 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1698:NotIdentifiedName"
msgid "Hat"
msgstr "모자"

#. assets_dev/engine/data_tables/items.txt record=1698 field=Notes status=translated
msgctxt "engine:items.txt:1698:Notes"
msgid "Don't laugh--while silly--even ridiculous--in appearance, many sorcerers spend quite a bit of time enchanting hats like this with powerful magics.  The conical shape and 'eyes' in the front of the hat are peculiarly attractive to creatures of the spirit world, and that property makes the hat easier to enchant."
msgstr "웃지 마세요. 겉보기엔 우스꽝스럽고 심지어는 우스꽝스러워 보일지 몰라도, 많은 마법사들이 이런 모자에 강력한 마법을 걸어 마법을 부여하는 데 상당한 시간을 투자합니다. 원뿔 모양과 모자 앞쪽의 '눈'은 정령들에게 특히 매력적이며, 이러한 특성 덕분에 마법을 걸기가 더 쉽습니다."

#. assets_dev/engine/data_tables/items.txt record=1699 field=Name status=translated
msgctxt "engine:items.txt:1699:Name"
msgid "Wreath Crown"
msgstr "화환 왕관"

#. assets_dev/engine/data_tables/items.txt record=1699 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1699:NotIdentifiedName"
msgid "Crown"
msgstr "왕관"

#. assets_dev/engine/data_tables/items.txt record=1699 field=Notes status=translated
msgctxt "engine:items.txt:1699:Notes"
msgid "This is a poorly wrought crown, the kind that goblins or low budget actors might create to mock royalty.  It offers no real head protection, although it may carry some small enchantment."
msgstr "이것은 조잡하게 만들어진 왕관으로, 고블린이나 저예산 배우들이 왕족을 조롱하기 위해 만들어낸 것과 같은 종류입니다. 머리를 제대로 보호해주지는 못하지만, 약간의 마법이 깃들어 있을지도 모릅니다."

#. assets_dev/engine/data_tables/items.txt record=169 field=Name status=translated
msgctxt "engine:items.txt:169:Name"
msgid "Serpent Wand of Rocks"
msgstr "뱀 바위 마법봉"

#. assets_dev/engine/data_tables/items.txt record=169 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:169:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=169 field=Notes status=translated
msgctxt "engine:items.txt:169:Notes"
msgid "Made from the braided bodies of three snakes, this wand pulses like a slow heartbeat. To use it you must equip it like a weapon."
msgstr "세 마리 뱀의 몸을 엮어 만든 이 지팡이는 마치 느린 심장 박동처럼 맥동합니다. 사용하려면 무기처럼 장착해야 합니다."

#. assets_dev/engine/data_tables/items.txt record=16 field=Name status=translated
msgctxt "engine:items.txt:16:Name"
msgid "Rusty Cutlass"
msgstr "녹슨 커틀러스"

#. assets_dev/engine/data_tables/items.txt record=16 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:16:NotIdentifiedName"
msgid "Cutlass"
msgstr "커틀러스"

#. assets_dev/engine/data_tables/items.txt record=16 field=Notes status=translated
msgctxt "engine:items.txt:16:Notes"
msgid "This weapon may once have been of some quality, though it would be hard to tell through the apparent years of corrosion."
msgstr "이 무기는 한때 꽤 품질이 좋았을지도 모르지만, 오랜 세월 동안 심하게 부식된 모습 때문에 이를 알아내기는 어려울 것이다."

#. assets_dev/engine/data_tables/items.txt record=1700 field=Name status=translated
msgctxt "engine:items.txt:1700:Name"
msgid "Regal Crown"
msgstr "왕의 왕관"

#. assets_dev/engine/data_tables/items.txt record=1700 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1700:NotIdentifiedName"
msgid "Crown"
msgstr "왕관"

#. assets_dev/engine/data_tables/items.txt record=1700 field=Notes status=translated
msgctxt "engine:items.txt:1700:Notes"
msgid "A large, imperfect sapphire is inset in the center of this delicate silver crown.  Extremely fine hammer marks suggest this crown was made by dwarven hands."
msgstr "이 섬세한 은제 왕관 중앙에는 크고 흠집이 있는 사파이어가 박혀 있습니다. 매우 정교한 망치 자국은 이 왕관이 드워프의 손으로 만들어졌음을 암시합니다."

#. assets_dev/engine/data_tables/items.txt record=1701 field=Name status=translated
msgctxt "engine:items.txt:1701:Name"
msgid "Almighty Crown"
msgstr "전능의 왕관"

#. assets_dev/engine/data_tables/items.txt record=1701 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1701:NotIdentifiedName"
msgid "Crown"
msgstr "왕관"

#. assets_dev/engine/data_tables/items.txt record=1701 field=Notes status=translated
msgctxt "engine:items.txt:1701:Notes"
msgid "Crowns of this sort are typically created with the use of magic to enhance their susceptibility to magic.  If found with no enchantments whatsoever, the crown was probably left unfinished for some reason. "
msgstr "이런 종류의 왕관은 일반적으로 마법을 사용하여 마법에 대한 저항력을 높이도록 만들어집니다. 만약 아무런 마법도 걸려 있지 않다면, 어떤 이유로든 미완성 상태로 남겨진 것일 가능성이 높습니다. "

#. assets_dev/engine/data_tables/items.txt record=1702 field=Name status=translated
msgctxt "engine:items.txt:1702:Name"
msgid "Crude Leather Belt"
msgstr "조잡한 가죽 허리띠"

#. assets_dev/engine/data_tables/items.txt record=1702 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1702:NotIdentifiedName"
msgid "Belt"
msgstr "허리띠"

#. assets_dev/engine/data_tables/items.txt record=1702 field=Notes status=translated
msgctxt "engine:items.txt:1702:Notes"
msgid "A common strip of leather used to hold up your pants."
msgstr "바지를 고정하는 데 흔히 사용되는 가죽 끈."

#. assets_dev/engine/data_tables/items.txt record=1703 field=Name status=translated
msgctxt "engine:items.txt:1703:Name"
msgid "Mercenary Belt"
msgstr "용병의 허리띠"

#. assets_dev/engine/data_tables/items.txt record=1703 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1703:NotIdentifiedName"
msgid "Belt"
msgstr "허리띠"

#. assets_dev/engine/data_tables/items.txt record=1703 field=Notes status=translated
msgctxt "engine:items.txt:1703:Notes"
msgid "A wide leather belt with a big, flashy buckle of a kind favored by bandits and mercenaries.  Both mercenaries and bandits like to have charms or minor enchantments placed on them as battle aids."
msgstr "도적이나 용병들이 선호하는 크고 화려한 버클이 달린 넓은 가죽 벨트. 용병과 도적들은 전투에 도움이 되도록 벨트에 부적이나 작은 마법을 거는 것을 좋아한다."

#. assets_dev/engine/data_tables/items.txt record=1704 field=Name status=translated
msgctxt "engine:items.txt:1704:Name"
msgid "Vanguard Belt"
msgstr "선봉대의 허리띠"

#. assets_dev/engine/data_tables/items.txt record=1704 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1704:NotIdentifiedName"
msgid "Belt"
msgstr "허리띠"

#. assets_dev/engine/data_tables/items.txt record=1704 field=Notes status=translated
msgctxt "engine:items.txt:1704:Notes"
msgid "Cured dragonhide and polished bronze are fastened together to form a belt of unusual strength and resistance to magic.  Although difficult to work with, these belts can offer excellent protection against magic once an enchantment is successfully laid upon them."
msgstr "가공된 용가죽과 광택이 나는 청동을 엮어 만든 이 벨트는 비범한 강도와 마법 저항을 지니고 있습니다. 다루기는 어렵지만, 일단 마법을 성공적으로 걸면 마법으로부터 탁월한 보호력을 제공합니다."

#. assets_dev/engine/data_tables/items.txt record=1705 field=Name status=translated
msgctxt "engine:items.txt:1705:Name"
msgid "Warlord Belt"
msgstr "군벌의 허리띠"

#. assets_dev/engine/data_tables/items.txt record=1705 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1705:NotIdentifiedName"
msgid "Belt"
msgstr "허리띠"

#. assets_dev/engine/data_tables/items.txt record=1705 field=Notes status=translated
msgctxt "engine:items.txt:1705:Notes"
msgid "Made of silver and the hide of some unknown creature, this belt is studded with vertical strips of a golden alloy.  The buckle is a single, large opal inset in a platinum base."
msgstr "은과 정체를 알 수 없는 생물의 가죽으로 만들어진 이 벨트는 금 합금으로 된 세로 줄무늬가 박혀 있다. 버클은 백금 바탕에 커다란 오팔 하나가 박혀 있다."

#. assets_dev/engine/data_tables/items.txt record=1706 field=Name status=translated
msgctxt "engine:items.txt:1706:Name"
msgid "Sovereign Belt"
msgstr "군주의 허리띠"

#. assets_dev/engine/data_tables/items.txt record=1706 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1706:NotIdentifiedName"
msgid "Belt"
msgstr "허리띠"

#. assets_dev/engine/data_tables/items.txt record=1706 field=Notes status=translated
msgctxt "engine:items.txt:1706:Notes"
msgid "Though soft and flexible, the material of this belt is made up of extremely fine strands of white gold.  The white gold is braided together by a process too exacting for human hands, and the ruby set into the buckle was perfectly cut by a process long lost in time."
msgstr "부드럽고 유연한 이 벨트는 매우 가는 백금 가닥으로 만들어졌습니다. 백금은 인간의 손으로는 도저히 엮을 수 없는 정교한 공정을 거쳐 엮였으며, 버클에 박힌 루비는 오래전에 사라진 전통적인 세공 기법으로 완벽하게 가공되었습니다."

#. assets_dev/engine/data_tables/items.txt record=1707 field=Name status=translated
msgctxt "engine:items.txt:1707:Name"
msgid "Leather Cloak"
msgstr "가죽 망토"

#. assets_dev/engine/data_tables/items.txt record=1707 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1707:NotIdentifiedName"
msgid "Cloak"
msgstr "망토"

#. assets_dev/engine/data_tables/items.txt record=1707 field=Notes status=translated
msgctxt "engine:items.txt:1707:Notes"
msgid "A used leather cloak.  It smells faintly of mothballs and dust."
msgstr "낡은 가죽 망토. 희미하게 나프탈렌과 먼지 냄새가 난다."

#. assets_dev/engine/data_tables/items.txt record=1708 field=Name status=translated
msgctxt "engine:items.txt:1708:Name"
msgid "Phantom Cloak"
msgstr "유령 망토"

#. assets_dev/engine/data_tables/items.txt record=1708 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1708:NotIdentifiedName"
msgid "Cloak"
msgstr "망토"

#. assets_dev/engine/data_tables/items.txt record=1708 field=Notes status=translated
msgctxt "engine:items.txt:1708:Notes"
msgid "Indigo dye from the Regnan Archipelago was used to stain this wool cloak the color of a summer night's sky."
msgstr "레그나 군도에서 생산된 인디고 염료를 사용하여 이 양모 망토를 여름밤 하늘색으로 물들였습니다."

#. assets_dev/engine/data_tables/items.txt record=1709 field=Name status=translated
msgctxt "engine:items.txt:1709:Name"
msgid "Elven Cloak"
msgstr "엘프 망토"

#. assets_dev/engine/data_tables/items.txt record=1709 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1709:NotIdentifiedName"
msgid "Cloak"
msgstr "망토"

#. assets_dev/engine/data_tables/items.txt record=1709 field=Notes status=translated
msgctxt "engine:items.txt:1709:Notes"
msgid "Woven from plant fibers found in the forests of Erathia, these cloaks are the traditional garb of the Elven Rangers."
msgstr "에라시아 숲에서 발견되는 식물 섬유로 짜여진 이 망토는 엘프 레인저들의 전통 복장입니다."

#. assets_dev/engine/data_tables/items.txt record=170 field=Name status=translated
msgctxt "engine:items.txt:170:Name"
msgid "Serpent Wand of Paralysis"
msgstr "뱀 마비 마법봉"

#. assets_dev/engine/data_tables/items.txt record=170 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:170:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=170 field=Notes status=translated
msgctxt "engine:items.txt:170:Notes"
msgid "Made from the braided bodies of three snakes, this wand pulses like a slow heartbeat. To use it you must equip it like a weapon."
msgstr "세 마리 뱀의 몸을 엮어 만든 이 지팡이는 마치 느린 심장 박동처럼 맥동합니다. 사용하려면 무기처럼 장착해야 합니다."

#. assets_dev/engine/data_tables/items.txt record=1710 field=Name status=translated
msgctxt "engine:items.txt:1710:Name"
msgid "Cardinal Cloak"
msgstr "추기경의 망토"

#. assets_dev/engine/data_tables/items.txt record=1710 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1710:NotIdentifiedName"
msgid "Cloak"
msgstr "망토"

#. assets_dev/engine/data_tables/items.txt record=1710 field=Notes status=translated
msgctxt "engine:items.txt:1710:Notes"
msgid "A cloak formerly worn by high officials of the Church of the Sun of Karigor prior to the dissolution of the Church in 1083 A.S.  Nearly all these cloaks were enchanted in one way or another."
msgstr "이 망토는 기원전 1083년 카리고르 태양교회가 해산되기 전까지 교회 고위 관리들이 착용했던 것입니다. 이 망토들은 거의 모두 어떤 식으로든 마법이 걸려 있었습니다."

#. assets_dev/engine/data_tables/items.txt record=1711 field=Name status=translated
msgctxt "engine:items.txt:1711:Name"
msgid "Doom's Day Cloak"
msgstr "종말의 망토"

#. assets_dev/engine/data_tables/items.txt record=1711 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1711:NotIdentifiedName"
msgid "Cloak"
msgstr "망토"

#. assets_dev/engine/data_tables/items.txt record=1711 field=Notes status=translated
msgctxt "engine:items.txt:1711:Notes"
msgid "A cloak formerly worn by high officials of the Church of the Moon of Karigor prior to the dissolution of the Church in 1083 A.S.  Nearly all these cloaks were enchanted in one way or another."
msgstr "이 망토는 기원전 1083년 카리고르 달의 교회가 해산되기 전까지 교회의 고위 관리들이 착용했던 것입니다. 이 망토들은 거의 모두 어떤 식으로든 마법이 걸려 있었습니다."

#. assets_dev/engine/data_tables/items.txt record=1712 field=Name status=translated
msgctxt "engine:items.txt:1712:Name"
msgid "Gauntlets"
msgstr "건틀릿"

#. assets_dev/engine/data_tables/items.txt record=1712 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1712:NotIdentifiedName"
msgid "Gauntlets"
msgstr "건틀릿"

#. assets_dev/engine/data_tables/items.txt record=1712 field=Notes status=translated
msgctxt "engine:items.txt:1712:Notes"
msgid "A steel plated gauntlet of simple make and design."
msgstr "단순한 구조와 디자인의 강철판 장갑."

#. assets_dev/engine/data_tables/items.txt record=1713 field=Name status=translated
msgctxt "engine:items.txt:1713:Name"
msgid "Knight Gauntlets"
msgstr "기사의 건틀릿"

#. assets_dev/engine/data_tables/items.txt record=1713 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1713:NotIdentifiedName"
msgid "Gauntlets"
msgstr "건틀릿"

#. assets_dev/engine/data_tables/items.txt record=1713 field=Notes status=translated
msgctxt "engine:items.txt:1713:Notes"
msgid "This gauntlet is an improvement over the simple, inflexible steel gauntlets commonly worn by goblins and brigands.  The back of the hand and wrist are solid, while the jointing around the fingers is made of chain links to improve dexterity."
msgstr "이 건틀릿은 고블린과 산적들이 흔히 착용하는 단순하고 뻣뻣한 강철 건틀릿을 개선한 것입니다. 손등과 손목 부분은 단단하게 제작되었고, 손가락 관절 부분은 사슬 고리로 만들어져 손놀림을 향상시켰습니다."

#. assets_dev/engine/data_tables/items.txt record=1714 field=Name status=translated
msgctxt "engine:items.txt:1714:Name"
msgid "Paladin Gauntlets"
msgstr "성기사 건틀릿"

#. assets_dev/engine/data_tables/items.txt record=1714 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1714:NotIdentifiedName"
msgid "Gauntlets"
msgstr "건틀릿"

#. assets_dev/engine/data_tables/items.txt record=1714 field=Notes status=translated
msgctxt "engine:items.txt:1714:Notes"
msgid "While lacking in flexibility, this gauntlet has reinforced joints over the knuckles and at the base of the wrist."
msgstr "유연성은 부족하지만, 이 장갑은 손가락 관절과 손목 아랫부분에 강화된 관절이 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1715 field=Name status=translated
msgctxt "engine:items.txt:1715:Name"
msgid "Cavalier Gauntlets"
msgstr "중기병의 건틀릿"

#. assets_dev/engine/data_tables/items.txt record=1715 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1715:NotIdentifiedName"
msgid "Gauntlets"
msgstr "건틀릿"

#. assets_dev/engine/data_tables/items.txt record=1715 field=Notes status=translated
msgctxt "engine:items.txt:1715:Notes"
msgid "A high quality gauntlet, it offers both flexibility and protection.  The joints are reinforced, yet are 'soft' enough to permit nearly normal hand motion."
msgstr "고품질 장갑으로 유연성과 보호 기능을 모두 제공합니다. 관절 부분은 강화되었지만, 거의 정상적인 손 움직임을 허용할 만큼 충분히 부드럽습니다."

#. assets_dev/engine/data_tables/items.txt record=1716 field=Name status=translated
msgctxt "engine:items.txt:1716:Name"
msgid "Ultimate Gauntlets"
msgstr "궁극의 건틀릿"

#. assets_dev/engine/data_tables/items.txt record=1716 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1716:NotIdentifiedName"
msgid "Gauntlets"
msgstr "건틀릿"

#. assets_dev/engine/data_tables/items.txt record=1716 field=Notes status=translated
msgctxt "engine:items.txt:1716:Notes"
msgid "Dwarven smiths created this masterpiece of gauntlet design.  Except for the extra bulk, there seems little difference between this gauntlet and a velvet glove.  Clever sliding and rotating plates at the joints and wrist permit full normal hand motion while providing continuous protection at all times."
msgstr "드워프 대장장이들이 만들어낸 이 걸작 건틀릿은 두께가 다소 두껍다는 점을 제외하면 벨벳 장갑과 거의 차이가 없어 보입니다. 관절과 손목 부분에 정교하게 설계된 슬라이딩 및 회전식 판 덕분에 손의 움직임은 자유로우면서도 항상 완벽한 보호 기능을 제공합니다."

#. assets_dev/engine/data_tables/items.txt record=1717 field=Name status=translated
msgctxt "engine:items.txt:1717:Name"
msgid "Old Leather Boots"
msgstr "낡은 가죽 장화"

#. assets_dev/engine/data_tables/items.txt record=1717 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1717:NotIdentifiedName"
msgid "Boots"
msgstr "장화"

#. assets_dev/engine/data_tables/items.txt record=1717 field=Notes status=translated
msgctxt "engine:items.txt:1717:Notes"
msgid "Common traveler's boots made with leather and hobnailed. Their previous owner didn't maintain them very well, and the leather appears discolored and warped in places."
msgstr "가죽으로 만들어지고 징이 박힌 흔한 여행자용 부츠입니다. 이전 주인이 관리를 잘 하지 않아 가죽이 부분적으로 변색되고 변형되었습니다."

#. assets_dev/engine/data_tables/items.txt record=1718 field=Name status=translated
msgctxt "engine:items.txt:1718:Name"
msgid "Steel Boots"
msgstr "강철 장화"

#. assets_dev/engine/data_tables/items.txt record=1718 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1718:NotIdentifiedName"
msgid "Boots"
msgstr "장화"

#. assets_dev/engine/data_tables/items.txt record=1718 field=Notes status=translated
msgctxt "engine:items.txt:1718:Notes"
msgid "Heavy steel boots made for solid foot protection in battle.  They are uncomfortable to walk in and have a tendency to rust on the inside."
msgstr "전투에서 발을 단단히 보호하기 위해 제작된 무거운 강철 부츠. 착용감이 불편하고 안쪽이 녹슬기 쉽다."

#. assets_dev/engine/data_tables/items.txt record=1719 field=Name status=translated
msgctxt "engine:items.txt:1719:Name"
msgid "Armored Boots"
msgstr "장갑 장화"

#. assets_dev/engine/data_tables/items.txt record=1719 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1719:NotIdentifiedName"
msgid "Boots"
msgstr "장화"

#. assets_dev/engine/data_tables/items.txt record=1719 field=Notes status=translated
msgctxt "engine:items.txt:1719:Notes"
msgid "The interior of these steel plated boots is made of leather and cloth to soften the sharp edges on the metal plates.  They are a bit heavy and exhausting to wear for extended periods."
msgstr "이 철판 부츠의 내부는 날카로운 금속판 모서리를 부드럽게 하기 위해 가죽과 천으로 만들어졌습니다. 하지만 다소 무겁고 장시간 착용하면 피로감을 줄 수 있습니다."

#. assets_dev/engine/data_tables/items.txt record=171 field=Name status=translated
msgctxt "engine:items.txt:171:Name"
msgid "Serpent Wand of Clouds"
msgstr "뱀 구름 마법봉"

#. assets_dev/engine/data_tables/items.txt record=171 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:171:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=171 field=Notes status=translated
msgctxt "engine:items.txt:171:Notes"
msgid "Made from the braided bodies of three snakes, this wand pulses like a slow heartbeat. To use it you must equip it like a weapon."
msgstr "세 마리 뱀의 몸을 엮어 만든 이 지팡이는 마치 느린 심장 박동처럼 맥동합니다. 사용하려면 무기처럼 장착해야 합니다."

#. assets_dev/engine/data_tables/items.txt record=1720 field=Name status=translated
msgctxt "engine:items.txt:1720:Name"
msgid "Sterling Boots"
msgstr "순은 장화"

#. assets_dev/engine/data_tables/items.txt record=1720 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1720:NotIdentifiedName"
msgid "Boots"
msgstr "장화"

#. assets_dev/engine/data_tables/items.txt record=1720 field=Notes status=translated
msgctxt "engine:items.txt:1720:Notes"
msgid "Polished silver boots with velvet interiors, these boots are lighter than steel boots and far more comfortable.  They look pretty snappy, too."
msgstr "광택이 나는 은색 부츠에 벨벳 안감이 더해진 이 부츠는 안전화보다 가볍고 훨씬 편안합니다. 게다가 꽤 멋스러워 보이기도 합니다."

#. assets_dev/engine/data_tables/items.txt record=1721 field=Name status=translated
msgctxt "engine:items.txt:1721:Name"
msgid "Ultimate Boots"
msgstr "궁극의 장화"

#. assets_dev/engine/data_tables/items.txt record=1721 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1721:NotIdentifiedName"
msgid "Boots"
msgstr "장화"

#. assets_dev/engine/data_tables/items.txt record=1721 field=Notes status=translated
msgctxt "engine:items.txt:1721:Notes"
msgid "Dragonhide boots reinforced with molded horn strips and stalt metal rivets.  Soft and light, they provide unparalleled foot protection."
msgstr "드래곤가죽 부츠는 몰딩 처리된 뿔띠와 견고한 금속 리벳으로 보강되었습니다. 부드럽고 가벼우면서도 탁월한 발 보호 기능을 제공합니다."

#. assets_dev/engine/data_tables/items.txt record=1722 field=Name status=translated
msgctxt "engine:items.txt:1722:Name"
msgid "Fine Ring"
msgstr "고급 반지"

#. assets_dev/engine/data_tables/items.txt record=1722 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1722:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=1722 field=Notes status=translated
msgctxt "engine:items.txt:1722:Notes"
msgid "A small golden ring with a quarter carat diamond.  The style is simple and elegant."
msgstr "0.25캐럿 다이아몬드가 세팅된 작은 금반지입니다. 심플하면서도 우아한 디자인입니다."

#. assets_dev/engine/data_tables/items.txt record=1723 field=Name status=translated
msgctxt "engine:items.txt:1723:Name"
msgid "Sparkling Ring"
msgstr "반짝이는 반지"

#. assets_dev/engine/data_tables/items.txt record=1723 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1723:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=1723 field=Notes status=translated
msgctxt "engine:items.txt:1723:Notes"
msgid "Two amethysts adorn this plain platinum ring."
msgstr "심플한 플래티넘 반지 위에 자수정 두 개가 장식되어 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1724 field=Name status=translated
msgctxt "engine:items.txt:1724:Name"
msgid "Lunar Ring"
msgstr "달빛 반지"

#. assets_dev/engine/data_tables/items.txt record=1724 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1724:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=1724 field=Notes status=translated
msgctxt "engine:items.txt:1724:Notes"
msgid "A gold ring with a large moonstone set in the center.  These rings typically carry an enchantment."
msgstr "중앙에 커다란 월장석이 박힌 금반지. 이러한 반지에는 보통 마법이 깃들어 있다."

#. assets_dev/engine/data_tables/items.txt record=1725 field=Name status=translated
msgctxt "engine:items.txt:1725:Name"
msgid "Witch Ring"
msgstr "마녀의 반지"

#. assets_dev/engine/data_tables/items.txt record=1725 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1725:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=1725 field=Notes status=translated
msgctxt "engine:items.txt:1725:Notes"
msgid "Rings such as this one were worn by the Witch's guild to signify membership during their heyday between 550-800 A.S."
msgstr "이와 같은 반지는 마녀 길드가 전성기를 누리던 서기 550년에서 800년 사이에 길드 회원임을 나타내기 위해 착용했습니다."

#. assets_dev/engine/data_tables/items.txt record=1726 field=Name status=translated
msgctxt "engine:items.txt:1726:Name"
msgid "Blessed Ring"
msgstr "축복받은 반지"

#. assets_dev/engine/data_tables/items.txt record=1726 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1726:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=1726 field=Notes status=translated
msgctxt "engine:items.txt:1726:Notes"
msgid "The three pearls mounted on a gold base glimmer a faint blue when held out in the sun, offering insight as to the source of their magic."
msgstr "금빛 받침대에 박힌 세 개의 진주는 햇빛에 비추면 은은한 푸른빛을 띠는데, 이는 진주에 담긴 신비로움의 근원을 짐작하게 해준다."

#. assets_dev/engine/data_tables/items.txt record=1727 field=Name status=translated
msgctxt "engine:items.txt:1727:Name"
msgid "Valuable Ring"
msgstr "값진 반지"

#. assets_dev/engine/data_tables/items.txt record=1727 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1727:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=1727 field=Notes status=translated
msgctxt "engine:items.txt:1727:Notes"
msgid "A large star sapphire flanked by two smaller rubies decorate an otherwise plain gold band."
msgstr "커다란 스타 사파이어 양쪽에 작은 루비 두 개가 자리 잡고 있는 심플한 금반지입니다."

#. assets_dev/engine/data_tables/items.txt record=1728 field=Name status=translated
msgctxt "engine:items.txt:1728:Name"
msgid "Precious Ring"
msgstr "귀중한 반지"

#. assets_dev/engine/data_tables/items.txt record=1728 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1728:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=1728 field=Notes status=translated
msgctxt "engine:items.txt:1728:Notes"
msgid "Three gems, symmetrically equal in size and quality adorn a hammered gold band.  The center gem is a ruby, and the two flanking gems are purple topazes."
msgstr "크기와 품질이 대칭을 이루는 세 개의 보석이 망치로 두드려 만든 금띠를 장식하고 있습니다. 가운데 보석은 루비이고, 양쪽의 두 보석은 보라색 토파즈입니다."

#. assets_dev/engine/data_tables/items.txt record=1729 field=Name status=translated
msgctxt "engine:items.txt:1729:Name"
msgid "Ethereal Ring"
msgstr "에테르 반지"

#. assets_dev/engine/data_tables/items.txt record=1729 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1729:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=1729 field=Notes status=translated
msgctxt "engine:items.txt:1729:Notes"
msgid "A hammered white gold ring with a large central diamond and two small pearls, light doesn't fall upon it normally.  The ring glitters and fades unpredictably, as though it were lit by an invisible sun shining in an unseen, yet parallel world.  "
msgstr "커다란 다이아몬드와 두 개의 작은 진주가 박힌, 망치로 두드려 만든 백금 반지. 빛이 반지 위로 비추면 마치 보이지 않는 태양이 비추는 듯 불규칙적으로 반짝였다가 사라지기를 반복한다.  "

#. assets_dev/engine/data_tables/items.txt record=172 field=Name status=translated
msgctxt "engine:items.txt:172:Name"
msgid "Necrotic Wand of Implosion"
msgstr "사령 내파 마법봉"

#. assets_dev/engine/data_tables/items.txt record=172 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:172:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=172 field=Notes status=translated
msgctxt "engine:items.txt:172:Notes"
msgid "A unicorn horn capped with a gold set ruby and crowned with a sculpted skull, this wand could only be the creation of the Necromancers' Guild. To use it you must equip it like a weapon."
msgstr "금으로 장식된 루비가 박힌 유니콘 뿔과 조각된 해골 장식이 얹힌 이 지팡이는 오직 네크로맨서 길드만이 만들 수 있는 것이다. 사용하려면 무기처럼 장착해야 한다."

#. assets_dev/engine/data_tables/items.txt record=1730 field=Name status=translated
msgctxt "engine:items.txt:1730:Name"
msgid "Exquisite Ring"
msgstr "정교한 반지"

#. assets_dev/engine/data_tables/items.txt record=1730 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1730:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=1730 field=Notes status=translated
msgctxt "engine:items.txt:1730:Notes"
msgid "Three opals rimmed with a strange red metal are set in a perfect ring of stalt--a very rare metal found only in southern Erathia."
msgstr "특이한 붉은 금속으로 테두리가 둘러진 세 개의 오팔이 강철로 만든 완벽한 고리에 박혀 있는데, 이 강철은 에라시아 남부에서만 발견되는 매우 희귀한 금속입니다."

#. assets_dev/engine/data_tables/items.txt record=1731 field=Name status=translated
msgctxt "engine:items.txt:1731:Name"
msgid "Scarab Ring"
msgstr "스카라베 반지"

#. assets_dev/engine/data_tables/items.txt record=1731 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1731:NotIdentifiedName"
msgid "Ring"
msgstr "반지"

#. assets_dev/engine/data_tables/items.txt record=1731 field=Notes status=translated
msgctxt "engine:items.txt:1731:Notes"
msgid "A gold band adorned with the shell of a rare beetle found only in the deserts of Enroth.  Treated properly by an alchemist, these shells can be made to hold the mightiest of enchantments."
msgstr "엔로스 사막에서만 발견되는 희귀한 딱정벌레의 껍데기로 장식된 금띠. 연금술사가 제대로 처리하면 이 껍데기에는 가장 강력한 마법을 담을 수 있다."

#. assets_dev/engine/data_tables/items.txt record=1732 field=Name status=translated
msgctxt "engine:items.txt:1732:Name"
msgid "Turquoise Amulet"
msgstr "터키석 부적"

#. assets_dev/engine/data_tables/items.txt record=1732 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1732:NotIdentifiedName"
msgid "Amulet"
msgstr "부적"

#. assets_dev/engine/data_tables/items.txt record=1732 field=Notes status=translated
msgctxt "engine:items.txt:1732:Notes"
msgid "A turquoise stone bracketed by a bronze chain and clasp makes for an inexpensive, yet charming amulet."
msgstr "청동 사슬과 잠금장치로 둘러싸인 터키석은 저렴하면서도 매력적인 부적입니다."

#. assets_dev/engine/data_tables/items.txt record=1733 field=Name status=translated
msgctxt "engine:items.txt:1733:Name"
msgid "Gothic Amulet"
msgstr "고딕 부적"

#. assets_dev/engine/data_tables/items.txt record=1733 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1733:NotIdentifiedName"
msgid "Amulet"
msgstr "부적"

#. assets_dev/engine/data_tables/items.txt record=1733 field=Notes status=translated
msgctxt "engine:items.txt:1733:Notes"
msgid "This bizarre amulet was probably created by some alchemist with a distorted understanding of magic.  The shape and symmetry help to maintain whatever enchantment he put in it."
msgstr "이 기묘한 부적은 아마도 마법에 대한 왜곡된 이해를 가진 연금술사가 만들었을 것이다. 그 모양과 대칭은 그가 걸어놓은 마법을 유지하는 데 도움이 된다."

#. assets_dev/engine/data_tables/items.txt record=1734 field=Name status=translated
msgctxt "engine:items.txt:1734:Name"
msgid "Claw Amulet"
msgstr "발톱 부적"

#. assets_dev/engine/data_tables/items.txt record=1734 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1734:NotIdentifiedName"
msgid "Amulet"
msgstr "부적"

#. assets_dev/engine/data_tables/items.txt record=1734 field=Notes status=translated
msgctxt "engine:items.txt:1734:Notes"
msgid "The ossified foot of some unknown beast or monster has been inset with a huge, imperfect purple topaz.  It's not pretty, but it's certainly magical."
msgstr "정체를 알 수 없는 짐승이나 괴물의 뼈로 굳어진 발에 크고 불완전한 보라색 토파즈가 박혀 있다. 보기에는 예쁘지 않지만, 분명 마법적인 의미를 지니고 있다."

#. assets_dev/engine/data_tables/items.txt record=1735 field=Name status=translated
msgctxt "engine:items.txt:1735:Name"
msgid "Ancient Amulet"
msgstr "고대 부적"

#. assets_dev/engine/data_tables/items.txt record=1735 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1735:NotIdentifiedName"
msgid "Amulet"
msgstr "부적"

#. assets_dev/engine/data_tables/items.txt record=1735 field=Notes status=translated
msgctxt "engine:items.txt:1735:Notes"
msgid "This amulet is composed of two pieces:  the front piece is an ancient, perfectly cut rectangle of a strong, stainless metal.  The backing is a much more recent gold chain and clasp.  Careful inspection of the front piece reveals it to be a plaque displaying the name of some long dead soldier or worker.  Symbols on the front probably indicate status and rank."
msgstr "이 부적은 두 부분으로 구성되어 있습니다. 앞면은 단단하고 녹슬지 않는 금속으로 만들어진, 완벽하게 조각된 고대의 직사각형 조각입니다. 뒷면은 훨씬 최근에 만들어진 금 사슬과 걸쇠입니다. 앞면을 자세히 살펴보면 오래전에 사망한 군인이나 노동자의 이름이 새겨진 명판임을 알 수 있습니다. 앞면에 새겨진 문양은 아마도 신분과 계급을 나타내는 것으로 보입니다."

#. assets_dev/engine/data_tables/items.txt record=1736 field=Name status=translated
msgctxt "engine:items.txt:1736:Name"
msgid "Ruby Star Amulet"
msgstr "루비 별 부적"

#. assets_dev/engine/data_tables/items.txt record=1736 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1736:NotIdentifiedName"
msgid "Amulet"
msgstr "부적"

#. assets_dev/engine/data_tables/items.txt record=1736 field=Notes status=translated
msgctxt "engine:items.txt:1736:Notes"
msgid "A perfect ruby cut in a star shape and bracketed by a golden clasp give this amulet its name.  When viewed in dim light, a fiery spark can be seen dancing in the center of the gem."
msgstr "별 모양으로 완벽하게 커팅된 루비와 금색 걸쇠가 이 부적에 이름을 붙여주었습니다. 어두운 곳에서 보면 보석 중앙에서 불꽃 같은 광채가 춤추는 것을 볼 수 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1737 field=Name status=translated
msgctxt "engine:items.txt:1737:Name"
msgid "Sparkling Wand of Fire"
msgstr "반짝이는 화염 마법봉"

#. assets_dev/engine/data_tables/items.txt record=1737 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1737:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=1737 field=Notes status=translated
msgctxt "engine:items.txt:1737:Notes"
msgid "A rod of blue metal and wood capped with a blue headstone.  To use this wand, you must equip it as though you were equipping a weapon."
msgstr "푸른색 금속과 나무로 만들어진 지팡이 끝에는 푸른색 묘비가 얹혀 있습니다. 이 지팡이를 사용하려면 무기를 장착하듯이 장착해야 합니다."

#. assets_dev/engine/data_tables/items.txt record=1738 field=Name status=translated
msgctxt "engine:items.txt:1738:Name"
msgid "Sparkling Wand of Sparks"
msgstr "반짝이는 전기 불꽃 마법봉"

#. assets_dev/engine/data_tables/items.txt record=1738 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1738:NotIdentifiedName"
msgid "Wand"
msgstr "마법봉"

#. assets_dev/engine/data_tables/items.txt record=1738 field=Notes status=translated
msgctxt "engine:items.txt:1738:Notes"
msgid "A rod of blue metal and wood capped with a blue headstone.  To use this wand, you must equip it as though you were equipping a weapon."
msgstr "푸른색 금속과 나무로 만들어진 지팡이 끝에는 푸른색 묘비가 얹혀 있습니다. 이 지팡이를 사용하려면 무기를 장착하듯이 장착해야 합니다."

#. assets_dev/engine/data_tables/items.txt record=1739 field=Name status=translated
msgctxt "engine:items.txt:1739:Name"
msgid "Sparkling Wand of Poison"
msgstr "반짝이는 독 마법봉"

