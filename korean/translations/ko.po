msgstr "제한 구역 - 출입 금지."

#. assets_dev/worlds/mm6/_legacy/events/CD1.STR record=9 field=Text status=translated
msgctxt "world:mm6:CD1.STR:9"
msgid "\"Etched into the tree a message reads:                                                                                                                                                                                                                              The first is half the forth plus one, better hurry or you'll be done!\""
msgstr "나무에 글이 새겨져 있습니다. 첫째는 넷째의 절반에 하나를 더한 것. 서두르지 않으면 끝장이다!"

