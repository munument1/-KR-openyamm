msgid "Jelly"
msgstr "젤리"

#. assets_dev/engine/data_tables/items.txt record=635 field=Notes status=translated
msgctxt "engine:items.txt:635:Notes"
msgid "A jar of royal wasp jelly."
msgstr "왕벌 젤리 한 병."

#. assets_dev/engine/data_tables/items.txt record=636 field=Name status=translated
msgctxt "engine:items.txt:636:Name"
msgid "Dragonbane Flower"
msgstr "드래곤베인 꽃"

#. assets_dev/engine/data_tables/items.txt record=636 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:636:NotIdentifiedName"
msgid "Dragonbane Flower"
msgstr "드래곤베인 꽃"

#. assets_dev/engine/data_tables/items.txt record=636 field=Notes status=translated
msgctxt "engine:items.txt:636:Notes"
msgid "Quest Item: A fresh dragonbane flower. The petals are thick and waxy."
msgstr "퀘스트 아이템: 싱싱한 용독꽃 한 송이. 꽃잎은 두껍고 윤기가 난다."

#. assets_dev/engine/data_tables/items.txt record=637 field=Name status=translated
msgctxt "engine:items.txt:637:Name"
msgid "Bone of Doom"
msgstr "파멸의 뼈"

#. assets_dev/engine/data_tables/items.txt record=637 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:637:NotIdentifiedName"
msgid "Bone"
msgstr "뼈"

#. assets_dev/engine/data_tables/items.txt record=637 field=Notes status=translated
msgctxt "engine:items.txt:637:Notes"
msgid "Quest Item: The arm bone of the legendary necromancer, Zacharia. It is infused with the death magician's evil energy."
msgstr "퀘스트 아이템: 전설적인 강령술사 자카리아의 팔뼈. 이 뼈에는 죽음의 마법사의 사악한 기운이 깃들어 있다."

#. assets_dev/engine/data_tables/items.txt record=638 field=Name status=translated
msgctxt "engine:items.txt:638:Name"
msgid "Druid Circlet of Power"
msgstr "드루이드의 힘의 머리장식"

#. assets_dev/engine/data_tables/items.txt record=638 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:638:NotIdentifiedName"
msgid "Circlet"
msgstr "머리장식"

#. assets_dev/engine/data_tables/items.txt record=638 field=Notes status=translated
msgctxt "engine:items.txt:638:Notes"
msgid "A legendary item rumored to be from the time of the Ancients.  Only someone with the power of a Grand Druid can wear this item."
msgstr "고대 시대부터 전해 내려온다는 전설적인 아이템. 오직 대드루이드의 힘을 가진 자만이 이 아이템을 착용할 수 있다."

#. assets_dev/engine/data_tables/items.txt record=639 field=Name status=translated
msgctxt "engine:items.txt:639:Name"
msgid "Arcane Key"
msgstr "신비의 열쇠"

#. assets_dev/engine/data_tables/items.txt record=639 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:639:NotIdentifiedName"
msgid "Key"
msgstr "열쇠"

#. assets_dev/engine/data_tables/items.txt record=639 field=Notes status=translated
msgctxt "engine:items.txt:639:Notes"
msgid "Quest Item: A gem containing an unfocused magical energy."
msgstr "퀘스트 아이템: 집중되지 않은 마법 에너지를 담고 있는 보석."

#. assets_dev/engine/data_tables/items.txt record=63 field=Name status=translated
msgctxt "engine:items.txt:63:Name"
msgid "Hunting Crossbow"
msgstr "사냥용 석궁"

#. assets_dev/engine/data_tables/items.txt record=63 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:63:NotIdentifiedName"
msgid "Crossbow"
msgstr "석궁"

#. assets_dev/engine/data_tables/items.txt record=63 field=Notes status=translated
msgctxt "engine:items.txt:63:Notes"
msgid "Built for use in the field, this medium crossbow is designed for hunting, but is equally effective as a battle weapon."
msgstr "야외 사용을 위해 제작된 이 중형 석궁은 사냥용으로 설계되었지만, 전투 무기로서도 동일하게 효과적입니다."

#. assets_dev/engine/data_tables/items.txt record=640 field=Name status=translated
msgctxt "engine:items.txt:640:Name"
msgid "Wyvern Horn"
msgstr "와이번 뿔"

#. assets_dev/engine/data_tables/items.txt record=640 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:640:NotIdentifiedName"
msgid "Horn"
msgstr "뿔"

#. assets_dev/engine/data_tables/items.txt record=640 field=Notes status=translated
msgctxt "engine:items.txt:640:Notes"
msgid "A horn taken from a wyvern."
msgstr "와이번에게서 얻은 뿔."

#. assets_dev/engine/data_tables/items.txt record=641 field=Name status=translated
msgctxt "engine:items.txt:641:Name"
msgid "Ogre Key"
msgstr "오우거 열쇠"

#. assets_dev/engine/data_tables/items.txt record=641 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:641:NotIdentifiedName"
msgid "Key"
msgstr "열쇠"

#. assets_dev/engine/data_tables/items.txt record=641 field=Notes status=translated
msgctxt "engine:items.txt:641:Notes"
msgid "Quest Item: A gem containing an unfocused magical energy."
msgstr "퀘스트 아이템: 집중되지 않은 마법 에너지를 담고 있는 보석."

#. assets_dev/engine/data_tables/items.txt record=642 field=Name status=translated
msgctxt "engine:items.txt:642:Name"
msgid "Pirate Hat"
msgstr "해적 모자"

#. assets_dev/engine/data_tables/items.txt record=642 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:642:NotIdentifiedName"
msgid "Hat"
msgstr "모자"

#. assets_dev/engine/data_tables/items.txt record=642 field=Notes status=translated
msgctxt "engine:items.txt:642:Notes"
msgid "Quest Item: A sea raider captain's hat. Inside the band are stitched the words \"D. P. Stanley.\""
msgstr "퀘스트 아이템: 해적 선장의 모자. 모자 안쪽 띠에는 \"D. P. 스탠리\"라는 글자가 수놓아져 있다."

#. assets_dev/engine/data_tables/items.txt record=643 field=Name status=translated
msgctxt "engine:items.txt:643:Name"
msgid "Tobersk Fruit"
msgstr "토베르스크 과일"

#. assets_dev/engine/data_tables/items.txt record=643 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:643:NotIdentifiedName"
msgid "Fruit"
msgstr "과일"

#. assets_dev/engine/data_tables/items.txt record=643 field=Notes status=translated
msgctxt "engine:items.txt:643:Notes"
msgid "The fruit of the tobersk bush which only grows on the Dagger Wound Islands. It is the main export item of the islands' Lizardmen."
msgstr "단검상 제도에서만 자라는 토베르스크 관목의 열매. 이 열매는 섬에 사는 도마뱀 인간들의 주요 수출품이다."

#. assets_dev/engine/data_tables/items.txt record=644 field=Name status=translated
msgctxt "engine:items.txt:644:Name"
msgid "Tobersk Pulp"
msgstr "토베르스크 펄프"

#. assets_dev/engine/data_tables/items.txt record=644 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:644:NotIdentifiedName"
msgid "Pulp"
msgstr "과육"

#. assets_dev/engine/data_tables/items.txt record=644 field=Notes status=translated
msgctxt "engine:items.txt:644:Notes"
msgid "Pulp made from Dagger Wound Islands grown tobersk fruit."
msgstr "대거 운드 제도에서 재배한 토베르스크 열매로 만든 펄프."

#. assets_dev/engine/data_tables/items.txt record=645 field=Name status=translated
msgctxt "engine:items.txt:645:Name"
msgid "Tobersk Brandy"
msgstr "토베르스크 브랜디"

#. assets_dev/engine/data_tables/items.txt record=645 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:645:NotIdentifiedName"
msgid "Brandy"
msgstr "브랜디"

#. assets_dev/engine/data_tables/items.txt record=645 field=Notes status=translated
msgctxt "engine:items.txt:645:Notes"
msgid "Brandy made from the processed pulp of Dagger Wound Islands grown tobersk fruit."
msgstr "대거 운드 제도에서 재배한 토베르스크 열매의 가공된 과육으로 만든 브랜디."

#. assets_dev/engine/data_tables/items.txt record=646 field=Name status=translated
msgctxt "engine:items.txt:646:Name"
msgid "Heartwood of Jadame"
msgstr "제이덤의 심재"

#. assets_dev/engine/data_tables/items.txt record=646 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:646:NotIdentifiedName"
msgid "Wood"
msgstr "목재"

#. assets_dev/engine/data_tables/items.txt record=646 field=Notes status=translated
msgctxt "engine:items.txt:646:Notes"
msgid "The cooler climate of the Murmurwood forest causes the trees there to grow with a tight grain. These lumbered planks are of the clear grained heartwood."
msgstr "머머우드 숲의 서늘한 기후 덕분에 그곳의 나무들은 촘촘한 나뭇결을 가지며 자랍니다. 이 목재 판재는 나뭇결이 선명한 심재로 만들어졌습니다."

#. assets_dev/engine/data_tables/items.txt record=647 field=Name status=translated
msgctxt "engine:items.txt:647:Name"
msgid "Flawed Amulets"
msgstr "결함 있는 부적"

#. assets_dev/engine/data_tables/items.txt record=647 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:647:NotIdentifiedName"
msgid "Crate"
msgstr "나무 상자"

#. assets_dev/engine/data_tables/items.txt record=647 field=Notes status=translated
msgctxt "engine:items.txt:647:Notes"
msgid "A crate of from the Shadowspire artificers. Small flaws in workmanship have made them incapable of holding enchantments."
msgstr "섀도스파이어 장인들이 만든 상자입니다. 제작상의 작은 결함 때문에 마법을 걸 수 없습니다."

#. assets_dev/engine/data_tables/items.txt record=648 field=Name status=translated
msgctxt "engine:items.txt:648:Name"
msgid "Dried Sunfish"
msgstr "말린 개복치"

#. assets_dev/engine/data_tables/items.txt record=648 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:648:NotIdentifiedName"
msgid "Crate"
msgstr "나무 상자"

#. assets_dev/engine/data_tables/items.txt record=648 field=Notes status=translated
msgctxt "engine:items.txt:648:Notes"
msgid "A crate of dried sunfish harvested from the Ifarine Sea. Some find the chewy, salty fish a delicacy."
msgstr "이파린 해에서 잡은 말린 붕어 한 상자. 어떤 사람들은 쫄깃하고 짭짤한 이 생선을 진미로 여긴다."

#. assets_dev/engine/data_tables/items.txt record=649 field=Name status=translated
msgctxt "engine:items.txt:649:Name"
msgid "Silver Dust of the Sea"
msgstr "바다의 은가루"

#. assets_dev/engine/data_tables/items.txt record=649 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:649:NotIdentifiedName"
msgid "Crate"
msgstr "나무 상자"

#. assets_dev/engine/data_tables/items.txt record=649 field=Notes status=translated
msgctxt "engine:items.txt:649:Notes"
msgid "A crate full of bagged Silver Dust. Made by the Necromancers' Guild, it is said to have value to some sea travelers."
msgstr "은가루가 자루에 담겨 가득 담긴 상자. 강령술사 길드에서 만든 이 은가루는 일부 해상 여행자들에게 가치가 있다고 전해진다."

#. assets_dev/engine/data_tables/items.txt record=64 field=Name status=translated
msgctxt "engine:items.txt:64:Name"
msgid "Caravaner's Crossbow"
msgstr "대상단원의 석궁"

#. assets_dev/engine/data_tables/items.txt record=64 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:64:NotIdentifiedName"
msgid "Crossbow"
msgstr "석궁"

#. assets_dev/engine/data_tables/items.txt record=64 field=Notes status=translated
msgctxt "engine:items.txt:64:Notes"
msgid "The Merchants of Alvar like to see their caravan guards well armed. This well-crafted heavy crossbow has a cranked drawing mechanism."
msgstr "알바르의 상인들은 대상 호위병들이 잘 무장되어 있는 것을 선호합니다. 이 정교하게 제작된 중형 석궁은 크랭크식 장전 장치를 갖추고 있습니다."

#. assets_dev/engine/data_tables/items.txt record=650 field=Name status=translated
msgctxt "engine:items.txt:650:Name"
msgid "Forged Vouchers"
msgstr "위조 전표"

#. assets_dev/engine/data_tables/items.txt record=650 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:650:NotIdentifiedName"
msgid "Vouchers"
msgstr "상품권"

#. assets_dev/engine/data_tables/items.txt record=650 field=Notes status=translated
msgctxt "engine:items.txt:650:Notes"
msgid "Forged credit documents used by the ogre mage Zog to embezzle gold from Alvarian merchant customers."
msgstr "오우거 마법사 조그가 알바르 상인 고객들의 금화를 횡령하기 위해 사용한 위조 신용 서류."

#. assets_dev/engine/data_tables/items.txt record=651 field=Name status=translated
msgctxt "engine:items.txt:651:Name"
msgid "Ground Wyvern Horn"
msgstr "간 와이번 뿔"

#. assets_dev/engine/data_tables/items.txt record=651 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:651:NotIdentifiedName"
msgid "Ground Wyvern Horn"
msgstr "와이번 뿔 가루"

#. assets_dev/engine/data_tables/items.txt record=651 field=Notes status=translated
msgctxt "engine:items.txt:651:Notes"
msgid "A powerful potion reagent used by the Necromancers of Shadowspire."
msgstr "섀도스파이어의 네크로맨서들이 사용하는 강력한 물약 제조 재료."

#. assets_dev/engine/data_tables/items.txt record=652 field=Name status=translated
msgctxt "engine:items.txt:652:Name"
msgid "Prophecies of the Snake"
msgstr "뱀의 예언"

#. assets_dev/engine/data_tables/items.txt record=652 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:652:NotIdentifiedName"
msgid "Book"
msgstr "책"

#. assets_dev/engine/data_tables/items.txt record=652 field=Notes status=translated
msgctxt "engine:items.txt:652:Notes"
msgid "Quest Item: One of many books of prophecy circulating recently, the Prophecies of the Snake may indeed tell the future of Jadame."
msgstr "퀘스트 아이템: 최근 유포되고 있는 여러 예언서 중 하나인 '뱀의 예언'은 제이덤의 미래를 예언하고 있을지도 모릅니다."

#. assets_dev/engine/data_tables/items.txt record=653 field=Name status=translated
msgctxt "engine:items.txt:653:Name"
msgid "Ogre Ear"
msgstr "오우거 귀"

#. assets_dev/engine/data_tables/items.txt record=653 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:653:NotIdentifiedName"
msgid "Ear"
msgstr "귀"

#. assets_dev/engine/data_tables/items.txt record=653 field=Notes status=translated
msgctxt "engine:items.txt:653:Notes"
msgid "Used to keep track of kills, some bounty hunters collect these gruesome reminders of battles past."
msgstr "일부 현상금 사냥꾼들은 사살 횟수를 기록하기 위해 과거 전투의 끔찍한 흔적들을 수집하기도 합니다."

#. assets_dev/engine/data_tables/items.txt record=654 field=Name status=translated
msgctxt "engine:items.txt:654:Name"
msgid "Wasp Stingers"
msgstr "말벌 침"

#. assets_dev/engine/data_tables/items.txt record=654 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:654:NotIdentifiedName"
msgid "Stinger"
msgstr "독침"

#. assets_dev/engine/data_tables/items.txt record=654 field=Notes status=translated
msgctxt "engine:items.txt:654:Notes"
msgid "The stinger of a giant wasp."
msgstr "거대 말벌의 침."

#. assets_dev/engine/data_tables/items.txt record=655 field=Name status=translated
msgctxt "engine:items.txt:655:Name"
msgid "Green Apple"
msgstr "녹색 사과"

#. assets_dev/engine/data_tables/items.txt record=655 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:655:NotIdentifiedName"
msgid "Apple"
msgstr "사과"

#. assets_dev/engine/data_tables/items.txt record=655 field=Notes status=translated
msgctxt "engine:items.txt:655:Notes"
msgid "Jadamean green apples are crunchy, slightly tart and a good source of nutrition.  (To use the apple, pick it up and left-click over a character's portrait in the inventory screen.)"
msgstr "제이덤산 녹색 사과는 아삭하고 약간 새콤하며 영양이 풍부합니다. (사과를 사용하려면 사과를 집어 인벤토리 화면에서 캐릭터 초상화를 왼쪽 클릭하십시오.)"

#. assets_dev/engine/data_tables/items.txt record=656 field=Name status=translated
msgctxt "engine:items.txt:656:Name"
msgid "Horseshoe"
msgstr "편자"

#. assets_dev/engine/data_tables/items.txt record=656 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:656:NotIdentifiedName"
msgid "Horseshoe"
msgstr "편자"

#. assets_dev/engine/data_tables/items.txt record=656 field=Notes status=translated
msgctxt "engine:items.txt:656:Notes"
msgid "This flawless horseshoe is made of silver. To use, pick the horseshoe up and right-click over a character's portrait."
msgstr "이 흠잡을 데 없는 말굽은 은으로 만들어졌습니다. 사용하려면 말굽을 집어 들고 캐릭터 초상화 위에서 마우스 오른쪽 버튼을 클릭하세요."

#. assets_dev/engine/data_tables/items.txt record=657 field=Name status=translated
msgctxt "engine:items.txt:657:Name"
msgid "Enchanted Amulet"
msgstr "마법의 부적"

#. assets_dev/engine/data_tables/items.txt record=657 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:657:NotIdentifiedName"
msgid "Amulet"
msgstr "부적"

#. assets_dev/engine/data_tables/items.txt record=657 field=Notes status=translated
msgctxt "engine:items.txt:657:Notes"
msgid "A pretty bauble favored by the Pirates of Regna for it appearance, not for any magical enchantment it may have."
msgstr "레그나 해적들이 좋아하는 예쁜 장신구로, 마법적인 효능 때문이 아니라 외형적인 아름다움 때문입니다."

#. assets_dev/engine/data_tables/items.txt record=658 field=Name status=translated
msgctxt "engine:items.txt:658:Name"
msgid "Wheel of Frelandeau"
msgstr "프렐랑도 치즈 한 덩이"

#. assets_dev/engine/data_tables/items.txt record=658 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:658:NotIdentifiedName"
msgid "Cheese"
msgstr "치즈"

#. assets_dev/engine/data_tables/items.txt record=658 field=Notes status=translated
msgctxt "engine:items.txt:658:Notes"
msgid "Quest Item: A wheel of prized unicorn's-milk frelandeau cheese. Sliced onto crackers, it is the perfect compliment to a snifter of fine tobersk brandy."
msgstr "퀘스트 아이템: 귀한 유니콘 젖으로 만든 프렐란도 치즈 한 덩어리. 크래커 위에 얇게 썰어 얹으면 고급 토베르스크 브랜디 한 잔과 완벽한 조화를 이룹니다."

#. assets_dev/engine/data_tables/items.txt record=659 field=Name status=translated
msgctxt "engine:items.txt:659:Name"
msgid "Log of Eldenbrie"
msgstr "엘덴브리 치즈 덩어리"

#. assets_dev/engine/data_tables/items.txt record=659 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:659:NotIdentifiedName"
msgid "Cheese"
msgstr "치즈"

#. assets_dev/engine/data_tables/items.txt record=659 field=Notes status=translated
msgctxt "engine:items.txt:659:Notes"
msgid "Quest Item: A log of Vori eldenbrie cheese. Though many have tried to duplicate its subtle, smoky flavor, only the master Frost Giant cheese masters of the frozen Vori wastes know the secrets of its formulation."
msgstr "퀘스트 아이템: 보리 엘덴브리 치즈 한 덩어리. 수많은 이들이 은은한 훈연향을 가진 이 치즈를 흉내 내려 했지만, 얼어붙은 보리 황무지의 서리 거인 치즈 장인들만이 그 제조법을 알고 있다."

#. assets_dev/engine/data_tables/items.txt record=65 field=Name status=translated
msgctxt "engine:items.txt:65:Name"
msgid "Regnan Crossbow"
msgstr "레그나 석궁"

#. assets_dev/engine/data_tables/items.txt record=65 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:65:NotIdentifiedName"
msgid "Crossbow"
msgstr "석궁"

#. assets_dev/engine/data_tables/items.txt record=65 field=Notes status=translated
msgctxt "engine:items.txt:65:Notes"
msgid "The pirates of Regna Island have spent centuries perfecting their crossbow design. The resulting weapon has a crystal lensed sight and bowstaves of pure stalt - which would make the bow impossible to cock if not for the crank draw of erudine alloy."
msgstr "레그나 섬의 해적들은 수 세기 동안 석궁 설계를 완성하는 데 매진해 왔습니다. 그 결과 탄생한 무기는 수정 렌즈 조준경과 순수 강철로 만들어진 활대를 갖추고 있는데, 만약 에루딘 합금으로 만든 크랭크식 활시위가 없었다면 활을 당기는 것 자체가 불가능했을 것입니다."

#. assets_dev/engine/data_tables/items.txt record=660 field=Name status=translated
msgctxt "engine:items.txt:660:Name"
msgid "Ball of Dunduck"
msgstr "던덕 치즈 덩이"

#. assets_dev/engine/data_tables/items.txt record=660 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:660:NotIdentifiedName"
msgid "Cheese"
msgstr "치즈"

#. assets_dev/engine/data_tables/items.txt record=660 field=Notes status=translated
msgctxt "engine:items.txt:660:Notes"
msgid "Quest Item: A ball of dunduck cheese. Made in small batches by the goblins of Erathia, most consider it an acquired taste."
msgstr "퀘스트 아이템: 던덕 치즈 한 덩어리. 에라시아의 고블린들이 소량씩 만드는 이 치즈는 호불호가 갈리는 맛으로 알려져 있습니다."

#. assets_dev/engine/data_tables/items.txt record=661 field=Name status=translated
msgctxt "engine:items.txt:661:Name"
msgid "Emperor Thorn's Key"
msgstr "쏜 황제의 열쇠"

#. assets_dev/engine/data_tables/items.txt record=661 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:661:NotIdentifiedName"
msgid "Key"
msgstr "열쇠"

#. assets_dev/engine/data_tables/items.txt record=661 field=Notes status=translated
msgctxt "engine:items.txt:661:Notes"
msgid "Quest Item: The key you took from the Unicorn King's body."
msgstr "퀘스트 아이템: 유니콘 왕의 시체에서 가져온 열쇠."

#. assets_dev/engine/data_tables/items.txt record=662 field=Name status=translated
msgctxt "engine:items.txt:662:Name"
msgid "Cannonball of Dominion"
msgstr "도미니언의 포탄"

#. assets_dev/engine/data_tables/items.txt record=662 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:662:NotIdentifiedName"
msgid "Cannonball"
msgstr "포탄"

#. assets_dev/engine/data_tables/items.txt record=662 field=Notes status=translated
msgctxt "engine:items.txt:662:Notes"
msgid "Quest Item: The strange cannonball you took from the Regnan fortress. It is unlike any ammunition you've seen before."
msgstr "퀘스트 아이템: 레그나 요새에서 가져온 이상한 포탄. 지금까지 본 적 없는 형태의 탄약입니다."

#. assets_dev/engine/data_tables/items.txt record=663 field=Name status=translated
msgctxt "engine:items.txt:663:Name"
msgid "Infused Metal Rod"
msgstr "마력이 주입된 금속 막대"

#. assets_dev/engine/data_tables/items.txt record=663 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:663:NotIdentifiedName"
msgid "Metal Rod"
msgstr "금속 막대"

#. assets_dev/engine/data_tables/items.txt record=663 field=Notes status=translated
msgctxt "engine:items.txt:663:Notes"
msgid "Metal stick."
msgstr "금속 막대."

#. assets_dev/engine/data_tables/items.txt record=664 field=Name status=translated
msgctxt "engine:items.txt:664:Name"
msgid "Large Round Crystal"
msgstr "커다란 구형 수정"

#. assets_dev/engine/data_tables/items.txt record=664 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:664:NotIdentifiedName"
msgid "Round crystal"
msgstr "둥근 수정"

#. assets_dev/engine/data_tables/items.txt record=664 field=Notes status=translated
msgctxt "engine:items.txt:664:Notes"
msgid "Large smooth and perfectly round crystal."
msgstr "크고 매끄럽고 완벽하게 둥근 크리스탈."

#. assets_dev/engine/data_tables/items.txt record=665 field=Name status=translated
msgctxt "engine:items.txt:665:Name"
msgid "Whisp wrappings"
msgstr "위스프 싸개"

#. assets_dev/engine/data_tables/items.txt record=665 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:665:NotIdentifiedName"
msgid "Whisp wrappings"
msgstr "위스프 붕대"

#. assets_dev/engine/data_tables/items.txt record=665 field=Notes status=translated
msgctxt "engine:items.txt:665:Notes"
msgid "Pieces of rotten cloth."
msgstr "썩은 천 조각들."

#. assets_dev/engine/data_tables/items.txt record=666 field=Name status=translated
msgctxt "engine:items.txt:666:Name"
msgid "Telelocator"
msgstr "텔레로케이터"

#. assets_dev/engine/data_tables/items.txt record=666 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:666:NotIdentifiedName"
msgid "Telelocator"
msgstr "텔레로케이터"

#. assets_dev/engine/data_tables/items.txt record=666 field=Notes status=translated
msgctxt "engine:items.txt:666:Notes"
msgid "Metal stick with smooth gem on top of it."
msgstr "매끄러운 보석이 꼭대기에 박힌 금속 막대."

#. assets_dev/engine/data_tables/items.txt record=667 field=Name status=translated
msgctxt "engine:items.txt:667:Name"
