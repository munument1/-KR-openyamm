msgctxt "engine:english/skill_des.txt:Bodybuilding:Expert"
msgid "Double effect of skill"
msgstr "기술 효과 2배"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Bodybuilding field=GrandMaster status=translated
msgctxt "engine:english/skill_des.txt:Bodybuilding:GrandMaster"
msgid "Quintuple effect of skill"
msgstr "기술 효과 5배"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Bodybuilding field=Master status=translated
msgctxt "engine:english/skill_des.txt:Bodybuilding:Master"
