#. assets_dev/engine/data_tables/english/skill_des.txt record=Fire field=GrandMaster status=translated
msgctxt "engine:english/skill_des.txt:Fire:GrandMaster"
msgid "Effects vary per spell"
msgstr "주문마다 효과가 다름"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Fire field=Master status=translated
