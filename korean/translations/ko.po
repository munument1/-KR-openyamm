msgstr "기술 수치에 따라 회복 시간 감소"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Axe field=GrandMaster status=translated
msgctxt "engine:english/skill_des.txt:Axe:GrandMaster"
msgid "Chance to halve the Armor Class of the target."
msgstr "대상의 방어력을 절반으로 낮출 확률 부여"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Axe field=Master status=translated
msgctxt "engine:english/skill_des.txt:Axe:Master"
msgid "Skill added to Attack Damage"
msgstr "공격 피해에 기술 수치 추가"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Axe field=Normal status=translated
msgctxt "engine:english/skill_des.txt:Axe:Normal"
msgid "Skill added to Attack Bonus"
msgstr "공격 보너스에 기술 수치 추가"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Blaster field=Description status=translated
msgctxt "engine:english/skill_des.txt:Blaster:Description"
msgid "A weapon from before the Silence, their making has long since been lost.  Expert and master blasters gain double and triple accuracy with these awesome weapons."
msgstr "블래스터는 '침묵' 이전 시대의 무기로, 그 제작 기술은 오래전에 사라졌습니다. 전문가는 이 강력한 무기의 명중 보너스를 두 배로, 마스터는 세 배로 높입니다."

#. assets_dev/engine/data_tables/english/skill_des.txt record=Blaster field=DisplayName status=translated
msgctxt "engine:english/skill_des.txt:Blaster:DisplayName"
msgid "Blaster"
msgstr "블래스터"

