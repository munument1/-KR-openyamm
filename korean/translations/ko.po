#. assets_dev/engine/data_tables/items.txt record=686 field=Name status=translated
msgctxt "engine:items.txt:686:Name"
msgid "Iron-laced ore"
msgstr "철 함유 광석"

#. assets_dev/engine/data_tables/items.txt record=686 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:686:NotIdentifiedName"
msgid "Lump of Ore"
msgstr "광석 덩어리"

#. assets_dev/engine/data_tables/items.txt record=686 field=Notes status=translated
msgctxt "engine:items.txt:686:Notes"
msgid "A small chunk of iron-laced ore.  In the hands of a skilled craftsman, this could make a weapon, an amulet, a ring, armor, or almost any other useful item."
msgstr "철이 함유된 작은 광석 덩어리. 숙련된 장인의 손에 들어가면 이것으로 무기, 부적, 반지, 갑옷 또는 거의 모든 유용한 물건을 만들 수 있다."

#. assets_dev/engine/data_tables/items.txt record=687 field=Name status=translated
msgctxt "engine:items.txt:687:Name"
msgid "Siertal-laced ore"
msgstr "시에르탈 함유 광석"

#. assets_dev/engine/data_tables/items.txt record=687 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:687:NotIdentifiedName"
msgid "Lump of Ore"
msgstr "광석 덩어리"

#. assets_dev/engine/data_tables/items.txt record=687 field=Notes status=translated
msgctxt "engine:items.txt:687:Notes"
msgid "A small chunk of siertal-laced ore.  Stronger and lighter than steel, in the hands of a skilled craftsman siertal could make an exceptional weapon, an amulet, a ring, armor, or almost any other useful item."
msgstr "시에르탈이 함유된 작은 광석 조각. 강철보다 강하고 가벼운 시에르탈은 숙련된 장인의 손에서 뛰어난 무기, 부적, 반지, 갑옷 또는 거의 모든 유용한 물건을 만들 수 있습니다."

#. assets_dev/engine/data_tables/items.txt record=688 field=Name status=translated
msgctxt "engine:items.txt:688:Name"
msgid "Phylt-laced ore"
msgstr "필트 함유 광석"

#. assets_dev/engine/data_tables/items.txt record=688 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:688:NotIdentifiedName"
msgid "Lump of Ore"
msgstr "광석 덩어리"

#. assets_dev/engine/data_tables/items.txt record=688 field=Notes status=translated
msgctxt "engine:items.txt:688:Notes"
msgid "A small chunk of phylt-laced ore.  Phylt is often used in steel alloys to increase the durability and enchantability of steel.  In the hands of a skilled craftsman phylt could make a weapon, an amulet, a ring, armor, or almost any other useful item."
msgstr "필트가 함유된 작은 광석 조각입니다. 필트는 강철 합금에 자주 사용되어 강철의 내구성과 마법 부여 가능성을 높입니다. 숙련된 장인의 손에서 필트는 무기, 부적, 반지, 갑옷 또는 거의 모든 유용한 물건을 만들 수 있습니다."

#. assets_dev/engine/data_tables/items.txt record=689 field=Name status=translated
msgctxt "engine:items.txt:689:Name"
msgid "Kergar-laced ore"
msgstr "케르가르 함유 광석"

#. assets_dev/engine/data_tables/items.txt record=689 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:689:NotIdentifiedName"
msgid "Lump of Ore"
msgstr "광석 덩어리"

#. assets_dev/engine/data_tables/items.txt record=689 field=Notes status=translated
msgctxt "engine:items.txt:689:Notes"
msgid "A small chunk of kergar-laced ore.  Kergar shares many properties of steel, but is much easier to enchant.  In the hands of a skilled craftsman kergar could easily make a magical weapon, an amulet, a ring, armor, or almost any other item."
msgstr "케르가르가 함유된 작은 광석 조각입니다. 케르가르는 강철과 많은 특성을 공유하지만, 마법을 부여하기가 훨씬 쉽습니다. 숙련된 장인의 손에서 케르가르는 마법 무기, 부적, 반지, 갑옷 또는 거의 모든 다른 아이템을 쉽게 만들 수 있습니다."

#. assets_dev/engine/data_tables/items.txt record=68 field=Name status=translated
msgctxt "engine:items.txt:68:Name"
msgid "Temple Mace"
msgstr "신전 철퇴"

#. assets_dev/engine/data_tables/items.txt record=68 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:68:NotIdentifiedName"
msgid "Mace"
msgstr "철퇴"

#. assets_dev/engine/data_tables/items.txt record=68 field=Notes status=translated
msgctxt "engine:items.txt:68:Notes"
msgid "The sunray corona circling the head of this well made mace serves as a devotional declaration for Temple of the Sun clerics; it also greatly increases the damage of its blows. "
msgstr "정교하게 제작된 이 철퇴의 머리 부분을 둘러싼 햇살 모양의 코로나는 태양 신전 성직자들의 헌신적인 신앙심을 상징하며, 동시에 철퇴의 공격력을 크게 증가시킵니다. "

#. assets_dev/engine/data_tables/items.txt record=690 field=Name status=translated
msgctxt "engine:items.txt:690:Name"
msgid "Erudine-laced ore"
msgstr "에루딘 함유 광석"

#. assets_dev/engine/data_tables/items.txt record=690 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:690:NotIdentifiedName"
msgid "Lump of Ore"
msgstr "광석 덩어리"

#. assets_dev/engine/data_tables/items.txt record=690 field=Notes status=translated
msgctxt "engine:items.txt:690:Notes"
msgid "A small chunk of erudine-laced ore.  A rare magical ore found in few regions of Erathia, in the hands of a skilled craftsman erudine could make a powerful weapon, an amulet, a ring, armor, or almost any other item."
msgstr "에루딘이 함유된 작은 광석 조각. 에라시아의 몇몇 지역에서만 발견되는 희귀한 마법 광석인 에루딘은 숙련된 장인의 손에서 강력한 무기, 부적, 반지, 갑옷 또는 거의 모든 다른 물건을 만들 수 있습니다."

#. assets_dev/engine/data_tables/items.txt record=691 field=Name status=translated
msgctxt "engine:items.txt:691:Name"
msgid "Stalt-laced ore"
msgstr "스탈트 함유 광석"

#. assets_dev/engine/data_tables/items.txt record=691 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:691:NotIdentifiedName"
msgid "Lump of Ore"
msgstr "광석 덩어리"

#. assets_dev/engine/data_tables/items.txt record=691 field=Notes status=translated
msgctxt "engine:items.txt:691:Notes"
msgid "A small chunk of stalt-laced ore.  Easy to enchant and as hard as obsidian, in the hands of a skilled craftsman stalt could make an incredibly powerful weapon, an amulet, a ring, armor, or almost any other item."
msgstr "작은 덩어리의 철광석 조각으로, 마법 부여가 쉽고 흑요석만큼 단단합니다. 숙련된 장인의 손에서 철광석은 엄청나게 강력한 무기, 부적, 반지, 갑옷 또는 거의 모든 다른 아이템을 만들 수 있습니다."

