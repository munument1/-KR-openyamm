#. assets_dev/engine/data_tables/items.txt record=79 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:79:NotIdentifiedName"
msgid "Staff"
msgstr "지팡이"

#. assets_dev/engine/data_tables/items.txt record=79 field=Notes status=translated
msgctxt "engine:items.txt:79:Notes"
msgid "Many dangers face the Jadamean traveler. Even the least battle-minded carry some sort of weapon. These iron ended walking sticks are a common choice."
msgstr "제이덤 여행자는 수많은 위험에 직면합니다. 전투에 그다지 관심이 없는 사람조차도 어떤 형태로든 무기를 휴대합니다. 이 철제 지팡이는 흔히 선택되는 무기 중 하나입니다."

#. assets_dev/engine/data_tables/items.txt record=7 field=Name status=translated
msgctxt "engine:items.txt:7:Name"
msgid "Dark Elven Bastard Sword"
msgstr "다크 엘프 바스타드 소드"

#. assets_dev/engine/data_tables/items.txt record=7 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:7:NotIdentifiedName"
msgid "Two-Handed Sword"
msgstr "양손검"

#. assets_dev/engine/data_tables/items.txt record=7 field=Notes status=translated
msgctxt "engine:items.txt:7:Notes"
msgid "Often carried by Elven caravan guards, these slightly under-proportioned blades are nearly, but not quite, light enough to brandish single-handedly."
msgstr "엘프 대상 호위병들이 흔히 휴대하는 이 검은 크기가 약간 작지만, 한 손으로 휘두르기에 거의 충분할 정도로 가볍지는 않습니다."

#. assets_dev/engine/data_tables/items.txt record=800 field=Name status=translated
msgctxt "engine:items.txt:800:Name"
