#. assets_dev/worlds/mm6/_legacy/events/ZDDB04.STR record=1 field=Text status=translated
msgctxt "world:mm6:ZDDB04.STR:1"
msgid "Bench"
msgstr "벤치"

#. assets_dev/worlds/mm6/_legacy/events/ZDDB04.STR record=2 field=Text status=translated
msgctxt "world:mm6:ZDDB04.STR:2"
msgid "You find a small wooden dowl."
msgstr "작은 나무못을 찾았습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB05.STR record=1 field=Text status=translated
msgctxt "world:mm6:ZDDB05.STR:1"
msgid "Crumbling boulder."
msgstr "부서져 가는 바위."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB05.STR record=2 field=Text status=translated
msgctxt "world:mm6:ZDDB05.STR:2"
msgid "The vent brings in fresh air."
msgstr "환기구에서 신선한 공기가 들어옵니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB05.STR record=3 field=Text status=translated
msgctxt "world:mm6:ZDDB05.STR:3"
msgid "Poisonous spores force you back."
msgstr "독성 포자 때문에 뒤로 물러납니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB05.STR record=5 field=Text status=translated
msgctxt "world:mm6:ZDDB05.STR:5"
msgid "The air smells stale and makes you cough."
msgstr "공기가 탁해 기침이 납니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB05.STR record=6 field=Text status=translated
msgctxt "world:mm6:ZDDB05.STR:6"
msgid "\"A small nymph comes out of a hole in the floor thanking you for clearing the spores, he shakes your hand vigorously then disappears down the hole (which somehow disappears after him). +500 experience.\""
msgstr "작은 님프가 바닥 구멍에서 나와 포자를 치워 준 것에 감사하며 힘차게 악수합니다. 그러고는 구멍 속으로 사라지는데, 이상하게도 구멍도 함께 사라집니다. 경험치 +500."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB05.STR record=7 field=Text status=translated
msgctxt "world:mm6:ZDDB05.STR:7"
msgid "Small switch."
msgstr "작은 스위치."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=1 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:1"
msgid "The mine shakes and shifts around you."
msgstr "광산이 주위에서 흔들리고 뒤틀립니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=10 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:10"
msgid "Some loose debris overhead falls on you."
msgstr "머리 위의 느슨한 잔해가 떨어집니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=11 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:11"
msgid "The vein dried up."
msgstr "광맥이 고갈되었습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=12 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:12"
msgid "You were fast enough to dodge the bigger rocks."
msgstr "재빨리 움직여 큰 바위들을 피했습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=13 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:13"
msgid "Even though the water is dirty it still refreshes."
msgstr "물은 더럽지만 그래도 상쾌해집니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=14 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:14"
msgid "The dirty water leaves a bad taste in your mouth."
msgstr "더러운 물 때문에 입안에 나쁜 맛이 남습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=15 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:15"
msgid "The doors seem stuck."
msgstr "문들이 걸린 것 같습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=16 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:16"
msgid "The switch is locked in place."
msgstr "스위치가 제자리에 고정되어 있습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=17 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:17"
msgid "Boulders."
msgstr "바위 더미."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=18 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:18"
msgid "This cave-in blocks any further access into the mine."
msgstr "낙석 때문에 광산 안쪽으로 더 들어갈 수 없습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=19 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:19"
msgid "Small rocks and debris fall from above. "
msgstr "작은 돌과 잔해가 위에서 떨어집니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=2 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:2"
msgid "Looks like an earthquake hit this mine."
msgstr "이 광산에 지진이 난 것 같습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=3 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:3"
msgid "Water filled barrel."
msgstr "물이 든 통."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=8 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:8"
msgid "As you pull the lever rocks fall from above."
msgstr "레버를 당기자 위에서 돌이 떨어집니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB06.STR record=9 field=Text status=translated
msgctxt "world:mm6:ZDDB06.STR:9"
msgid "You mine the gold with no problem."
msgstr "문제없이 금을 채굴합니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB07.STR record=1 field=Text status=translated
msgctxt "world:mm6:ZDDB07.STR:1"
msgid "There is a strong smell of gas pervading the air."
msgstr "공기 중에 강한 가스 냄새가 퍼져 있습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB07.STR record=11 field=Text status=translated
msgctxt "world:mm6:ZDDB07.STR:11"
msgid "A voice hisses -Walk the path of the snake-."
msgstr "목소리가 쉭쉭거리며 말합니다. \"뱀의 길을 걸어라.\""

#. assets_dev/worlds/mm6/_legacy/events/ZDDB07.STR record=12 field=Text status=translated
msgctxt "world:mm6:ZDDB07.STR:12"
msgid "\"A voice whispers -I am the spirit of the swamp, congratulations, take what you may and leave in peace-\""
msgstr "목소리가 속삭입니다. 나는 늪의 정령이다. 축하한다. 원하는 것을 가져가고 평안히 떠나라."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB07.STR record=2 field=Text status=translated
msgctxt "world:mm6:ZDDB07.STR:2"
msgid "Small glittering pool."
msgstr "작게 반짝이는 연못."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB07.STR record=3 field=Text status=translated
msgctxt "world:mm6:ZDDB07.STR:3"
msgid "The water cools you down."
msgstr "물이 몸을 식혀 줍니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB07.STR record=5 field=Text status=translated
msgctxt "world:mm6:ZDDB07.STR:5"
msgid "The torches Ignite and so does the swamp gas."
msgstr "횃불에 불이 붙으며 늪 가스도 함께 타오릅니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB07.STR record=6 field=Text status=translated
msgctxt "world:mm6:ZDDB07.STR:6"
msgid "Hundreds of snakes crawl out of the floor and bite you."
msgstr "수백 마리의 뱀이 바닥에서 기어 나와 물어뜯습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB07.STR record=7 field=Text status=translated
msgctxt "world:mm6:ZDDB07.STR:7"
msgid "Swamp gas forces you back couching and gagging."
msgstr "늪 가스 때문에 기침과 구역질을 하며 뒤로 물러납니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB07.STR record=8 field=Text status=translated
msgctxt "world:mm6:ZDDB07.STR:8"
msgid "\"You drink the water, with no effect.\""
msgstr "물을 마시지만 아무 효과도 없습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB07.STR record=9 field=Text status=translated
msgctxt "world:mm6:ZDDB07.STR:9"
msgid "The switch does not work."
msgstr "스위치가 작동하지 않습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=1 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:1"
msgid "Shard filled caskets."
msgstr "수정 조각이 든 관."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=10 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:10"
msgid "Someone has gone to a lot of trouble carving all these murals"
msgstr "누군가 이 벽화들을 새기는 데 엄청난 공을 들였습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=11 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:11"
msgid " This razor sharp crystal is too immature to harvest."
msgstr "이 면도날처럼 날카로운 수정은 아직 채굴하기에 너무 덜 자랐습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=12 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:12"
msgid "You study the mural and get a good feeling inside."
msgstr "벽화를 살펴보자 마음이 편안해집니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=13 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:13"
msgid "Carved mural."
msgstr "새겨진 벽화."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=15 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:15"
msgid "The cabinet is filled with old and broken harvesting tools."
msgstr "장 안에는 낡고 부서진 채굴 도구가 가득합니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=2 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:2"
msgid "Barrel is filled with crystal shards (worthless)."
msgstr "통에는 가치 없는 수정 조각이 가득합니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=3 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:3"
msgid "Table with implements atop."
msgstr "도구가 놓인 탁자."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=4 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:4"
msgid "You see a scattered of refining tools and small crystal shavings."
msgstr "정제 도구와 작은 수정 부스러기가 흩어져 있습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=5 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:5"
msgid "Sacks."
msgstr "자루."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=6 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:6"
msgid "The sacks are filled with flawed crystal shards (worthless)."
msgstr "자루에는 가치 없는 불량 수정 조각이 들어 있습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=8 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:8"
msgid "You mine the crystal in its raw form (+300 gold)."
msgstr "원석 상태의 수정을 채굴합니다. (금화 +300)"

#. assets_dev/worlds/mm6/_legacy/events/ZDDB08.STR record=9 field=Text status=translated
msgctxt "world:mm6:ZDDB08.STR:9"
msgid "You refine the crystal you harvested (+200 to its value)."
msgstr "채굴한 수정을 정제합니다. (가치 +200)"

#. assets_dev/worlds/mm6/_legacy/events/ZDDB10.STR record=12 field=Text status=translated
msgctxt "world:mm6:ZDDB10.STR:12"
msgid "You flip the switch and hear grating off in the distance."
msgstr "스위치를 젖히자 멀리서 긁히는 소리가 들립니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB10.STR record=18 field=Text status=translated
msgctxt "world:mm6:ZDDB10.STR:18"
msgid "Something slimey moves behind this brick wall."
msgstr "이 벽돌 벽 뒤에서 끈적한 무언가가 움직입니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB10.STR record=19 field=Text status=translated
msgctxt "world:mm6:ZDDB10.STR:19"
msgid "Wall with missing bricks."
msgstr "벽돌이 빠진 벽."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB10.STR record=2 field=Text status=translated
msgctxt "world:mm6:ZDDB10.STR:2"
msgid "With some muscle you move the switch down."
msgstr "힘을 써 스위치를 아래로 내립니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB10.STR record=27 field=Text status=translated
msgctxt "world:mm6:ZDDB10.STR:27"
msgid "You get a bad feeling from the bones."
msgstr "뼈에서 불길한 느낌이 듭니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB10.STR record=28 field=Text status=translated
msgctxt "world:mm6:ZDDB10.STR:28"
msgid "Iron Maiden"
msgstr "아이언 메이든"

#. assets_dev/worlds/mm6/_legacy/events/ZDDB10.STR record=29 field=Text status=translated
msgctxt "world:mm6:ZDDB10.STR:29"
msgid "There's nothing but spikes in the Iron maiden."
msgstr "아이언 메이든 안에는 가시밖에 없습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB10.STR record=30 field=Text status=translated
msgctxt "world:mm6:ZDDB10.STR:30"
msgid "You search the Burial niche and find some gold."
msgstr "매장 벽감을 뒤져 금화를 찾았습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB10.STR record=31 field=Text status=translated
msgctxt "world:mm6:ZDDB10.STR:31"
msgid "The bones seems to charge with electricity !!."
msgstr "뼈에 전기가 차오르는 것 같습니다!"

#. assets_dev/worlds/mm6/_legacy/events/ZDDB10.STR record=32 field=Text status=translated
msgctxt "world:mm6:ZDDB10.STR:32"
msgid "These are really old bones...really old."
msgstr "정말 오래된 뼈입니다... 아주 오래됐습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB10.STR record=33 field=Text status=translated
msgctxt "world:mm6:ZDDB10.STR:33"
msgid "You gain knowledge from these ancient bones."
msgstr "이 고대의 뼈에서 지식을 얻습니다."

#. assets_dev/worlds/mm6/_legacy/events/ZDDB10.STR record=34 field=Text status=translated
