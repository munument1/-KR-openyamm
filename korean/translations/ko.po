msgctxt "engine:items.txt:634:Notes"
msgid "Quest Item: A well crafted instrument."
msgstr "퀘스트 아이템: 정교하게 제작된 악기."

#. assets_dev/engine/data_tables/items.txt record=635 field=Name status=translated
msgctxt "engine:items.txt:635:Name"
msgid "Royal Wasp Jelly"
msgstr "왕실 말벌 젤리"

#. assets_dev/engine/data_tables/items.txt record=635 field=NotIdentifiedName status=translated
