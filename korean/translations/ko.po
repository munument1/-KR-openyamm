msgctxt "engine:items.txt:623:Name"
msgid "Gem of Restoration"
msgstr "복원의 보석"

#. assets_dev/engine/data_tables/items.txt record=623 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:623:NotIdentifiedName"
msgid "Gem"
msgstr "보석"

#. assets_dev/engine/data_tables/items.txt record=623 field=Notes status=translated
msgctxt "engine:items.txt:623:Notes"
msgid "Quest Item: This large ruby is of perfect quality, clear throughout with an even pigeon blood red. It contains a powerful enchantment and pulses with a slumbering heartbeat rhythm."
msgstr "퀘스트 아이템: 이 커다란 루비는 완벽한 품질을 자랑하며, 속까지 맑고 비둘기 피처럼 붉은색을 띠고 있습니다. 강력한 마법이 깃들어 있으며, 마치 잠자는 심장처럼 미세하게 맥동합니다."

#. assets_dev/engine/data_tables/items.txt record=624 field=Name status=translated
msgctxt "engine:items.txt:624:Name"
msgid "Charged connector stone"
msgstr "충전된 연결석"

#. assets_dev/engine/data_tables/items.txt record=624 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:624:NotIdentifiedName"
msgid "Gem"
msgstr "보석"

#. assets_dev/engine/data_tables/items.txt record=624 field=Notes status=translated
msgctxt "engine:items.txt:624:Notes"
msgid "Smooth half-transparent connector stone charged by time traveling."
msgstr "시간 여행을 통해 에너지를 얻은 매끄럽고 반투명한 연결석."

#. assets_dev/engine/data_tables/items.txt record=625 field=Name status=translated
msgctxt "engine:items.txt:625:Name"
msgid "Connector stone"
msgstr "연결석"

#. assets_dev/engine/data_tables/items.txt record=625 field=NotIdentifiedName status=translated
