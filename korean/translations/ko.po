#. assets_dev/engine/data_tables/english/quests.txt record=109 field=text status=translated
msgctxt "engine:quests.txt:109:text"
msgid "Find and return an Anointed Potion to Languid in the Dagger Wound Islands."
msgstr "기름 부은 약초 물약을 찾아 대거 운드 제도의 랭귀드에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1105 field=text status=translated
msgctxt "engine:quests.txt:1105:text"
msgid "Show Sulman's letter to Andover Potbello in New Sorpigal."
msgstr "뉴 소르피갈의 앤도버 팟벨로에게 설먼의 편지를 보여주십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1106 field=text status=translated
msgctxt "engine:quests.txt:1106:text"
msgid "Bring Sulman's letter to Regent Wilbur Humphrey at Castle Ironfist."
msgstr "아이언피스트 성의 섭정 윌버 험프리에게 설먼의 편지를 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1107 field=text status=translated
msgctxt "engine:quests.txt:1107:text"
msgid "Find the Combination to the vault door in Goblinwatch and return to the Town Hall in New Sorpigal."
msgstr "고블린워치의 금고문 암호를 찾아 뉴 소르피갈 시청으로 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1108 field=text status=translated
msgctxt "engine:quests.txt:1108:text"
msgid "Get the Chime of Harmony from the Temple of Baa and return to the New Sorpigal Town Hall."
msgstr "바의 신전에서 조화의 종을 되찾아 뉴 소르피갈 시청으로 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1110 field=text status=translated
msgctxt "engine:quests.txt:1110:text"
msgid "Find Lord Kilburn's Shield and return to Wilbur Humphrey in Castle Ironfist to report."
msgstr "킬번 경의 방패를 찾아 아이언피스트 성의 윌버 험프리에게 보고하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1112 field=text status=translated
msgctxt "engine:quests.txt:1112:text"
msgid "Rescue a Damsel in Distress and return with her to Wilbur Humphrey in Castle Ironfist."
msgstr "곤경에 처한 여인을 구출해 아이언피스트 성의 윌버 험프리에게 데려가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1113 field=text status=translated
msgctxt "engine:quests.txt:1113:text"
msgid "Slay Longfang Witherhide in his cave near Castle Darkmoor and return to Wilbur Humphrey in Castle Ironfist."
msgstr "다크무어 성 근처 동굴에서 롱팽 위더하이드를 처치한 뒤 아이언피스트 성의 윌버 험프리에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1114 field=text status=translated
msgctxt "engine:quests.txt:1114:text"
msgid "Entertain Nicolai."
msgstr "니콜라이를 즐겁게 해주십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1119 field=text status=translated
msgctxt "engine:quests.txt:1119:text"
msgid "Find and return Prince Nicolai to Castle Ironfist."
msgstr "니콜라이 왕자를 찾아 아이언피스트 성으로 데려오십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=111 field=text status=translated
msgctxt "engine:quests.txt:111:text"
msgid "Bring Hiss on the Dagger Wound Islands the Idol of the Snake from the Abandoned Temple."
msgstr "버려진 신전에서 뱀의 우상을 찾아 대거 운드 제도의 히스에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1120 field=text status=translated
msgctxt "engine:quests.txt:1120:text"
msgid "Find the Third Eye and bring it to Prince Nicolai in Castle Ironfist."
msgstr "제3의 눈을 찾아 아이언피스트 성의 니콜라이 왕자에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1122 field=text status=translated
msgctxt "engine:quests.txt:1122:text"
msgid "Capture the Prince of Thieves and bring him to Lord Anthony Stone at Castle Stone."
msgstr "도둑의 왕자를 붙잡아 스톤 성의 앤서니 스톤 경에게 데려가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1129 field=text status=translated
msgctxt "engine:quests.txt:1129:text"
msgid "Hire a Stonecutter and a Carpenter, bring them to Temple Stone in Free Haven to repair the Temple, and then return to Lord Anthony Stone at Castle Stone."
msgstr "석공과 목수를 고용해 프리 헤이븐의 스톤 신전으로 데려가 신전을 수리하게 한 뒤, 스톤 성의 앤서니 스톤 경에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1131 field=text status=translated
msgctxt "engine:quests.txt:1131:text"
msgid "Take the Sacred Chalice from the monks in their island temple east of Free Haven, return it to Temple Stone in Free Haven, and then return to Lord Stone at Castle Stone."
msgstr "프리 헤이븐 동쪽 섬의 신전에 있는 수도사들에게서 성배를 가져와 프리 헤이븐의 스톤 신전에 돌려놓은 뒤, 스톤 성의 스톤 경에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1134 field=text status=translated
msgctxt "engine:quests.txt:1134:text"
msgid "Find and return the Hourglass of Time to Lord Albert Newton in Mist."
msgstr "시간의 모래시계를 찾아 안개 섬의 앨버트 뉴턴 경에게 돌려주십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1135 field=text status=translated
msgctxt "engine:quests.txt:1135:text"
msgid "Drink from the Fountain of Magic and return to Lord Albert Newton in Mist."
msgstr "마법의 샘물을 마신 뒤 안개 섬의 앨버트 뉴턴 경에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1136 field=text status=translated
msgctxt "engine:quests.txt:1136:text"
msgid "Retrieve the Crystal of Terrax and return to Lord Albert Newton in Mist."
msgstr "테락스의 수정을 되찾아 안개 섬의 앨버트 뉴턴 경에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1137 field=text status=translated
msgctxt "engine:quests.txt:1137:text"
msgid "Destroy the Devil's Outpost and return to Lord Osric Temper at Castle Temper."
msgstr "데빌 전초기지를 파괴한 뒤 템퍼 성의 오스릭 템퍼 경에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1138 field=text status=translated
msgctxt "engine:quests.txt:1138:text"
msgid "Get Knight's nomination from Chadwick and return to Lord Osric Temper at Castle Temper."
msgstr "채드윅에게서 기사 추천서를 받아 템퍼 성의 오스릭 템퍼 경에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1139 field=text status=translated
msgctxt "engine:quests.txt:1139:text"
msgid "Defeat the Warlord and bring proof to Osric Temper"
msgstr "전쟁군주를 쓰러뜨리고 증거를 오스릭 템퍼에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=113 field=text status=translated
msgctxt "engine:quests.txt:113:text"
msgid "Bring Thistle on the Dagger Wound Islands the basic ingredients for a potion of Pure Speed."
msgstr "순수한 속도 물약의 기본 재료를 대거 운드 제도의 시슬에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1140 field=text status=translated
msgctxt "engine:quests.txt:1140:text"
msgid "Fix the prices of all 9 stables in the Kingdom and return to Lady Fleise in Silver Cove."
msgstr "왕국의 아홉 마구간 요금을 모두 바로잡은 뒤 실버 코브의 플라이스 부인에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1142 field=text status=translated
msgctxt "engine:quests.txt:1142:text"
msgid "Visit the Altar of the Sun in the circle of stones north of Silver Cove on an equinox or solstice (HINT:  March 20th is an equinox)."
msgstr "춘분·추분 또는 하지·동짓날에 실버 코브 북쪽 돌기둥 원의 태양 제단을 방문하십시오. (힌트: 3월 20일은 춘분입니다.)"

#. assets_dev/engine/data_tables/english/quests.txt record=1143 field=text status=translated
msgctxt "engine:quests.txt:1143:text"
msgid "Visit the Altar of the Moon in the Temple of the Moon at midnight of a full moon."
msgstr "보름달이 뜬 자정에 달의 신전에 있는 달의 제단을 방문하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1144 field=text status=translated
msgctxt "engine:quests.txt:1144:text"
msgid "End winter for Lord Stromgard at Castle Stromgard, and return to him with the good news."
msgstr "스트롬가드 성의 스트롬가드 경을 위해 겨울을 끝낸 뒤 좋은 소식을 전하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1145 field=text status=translated
msgctxt "engine:quests.txt:1145:text"
msgid "Retrieve the key to the Dragon Towers from Icewind Keep south of Whitecap, and bring it to Lord Stromgard at Castle Stromgard."
msgstr "화이트 캡 남쪽 아이스윈드 요새에서 드래곤 탑의 열쇠를 되찾아 스트롬가드 성의 스트롬가드 경에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1146 field=text status=translated
msgctxt "engine:quests.txt:1146:text"
msgid "Reset all of the Dragon Towers at each town and return to Lord Stromgard in Castle Stromgard."
msgstr "각 마을의 드래곤 탑을 모두 재설정한 뒤 스트롬가드 성의 스트롬가드 경에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1148 field=text status=translated
msgctxt "engine:quests.txt:1148:text"
msgid "Kill Snergle in Snergle's Caverns and return with his axe to Avinril Smythers at The Haunt tavern in the Mire of the Damned."
msgstr "저주받은 늪의 스너글 동굴에서 스너글을 처치하고 그의 도끼를 가져와 '더 혼트' 선술집의 애빈릴 스미더스에게 전달하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1149 field=text status=translated
msgctxt "engine:quests.txt:1149:text"
msgid "Storm the Silver Helm Outpost near Mist and return with evidence of their corruption to the Constable of Mist."
msgstr "안개 섬 근처의 실버 헬름 전초기지를 습격하고 부패의 증거를 안개 섬의 치안관에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1150 field=text status=translated
msgctxt "engine:quests.txt:1150:text"
msgid "Retrieve the candelabra from the Abandoned Temple for Andover Potbello in New Sorpigal."
msgstr "버려진 신전에서 촛대를 되찾아 뉴 소르피갈의 앤도버 팟벨로에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1152 field=text status=translated
msgctxt "engine:quests.txt:1152:text"
msgid "Retrieve the harp from the Dragoon's Caverns south of Castle Ironfist and return it to Andrew Besper in Castle Ironfist."
msgstr "아이언피스트 성 남쪽 드라군 동굴에서 하프를 되찾아 아이언피스트 성의 앤드루 베스퍼에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1153 field=text status=translated
msgctxt "engine:quests.txt:1153:text"
msgid "Retrieve Ethric's skull from his tomb west of Free Haven for Gabriel Cartman in Free Haven."
msgstr "프리 헤이븐 서쪽 에스릭의 무덤에서 그의 두개골을 되찾아 프리 헤이븐의 가브리엘 카트먼에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1154 field=text status=translated
msgctxt "engine:quests.txt:1154:text"
msgid "Kill the Queen of the Spiders in the Abandoned Temple in New Sorpigal and return with her heart to Buford T. Allman in New Sorpigal."
msgstr "뉴 소르피갈의 버려진 신전에서 거미 여왕을 처치하고 심장을 뉴 소르피갈의 뷰퍼드 T. 올먼에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1155 field=text status=translated
msgctxt "engine:quests.txt:1155:text"
msgid "Deface the altar in the Monolith west of Silver Cove and return to Eleanor Vanderbilt in Silver Cove."
msgstr "실버 코브 서쪽 모놀리스의 제단을 훼손한 뒤 실버 코브의 엘리너 밴더빌트에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1158 field=text status=translated
msgctxt "engine:quests.txt:1158:text"
msgid "Destroy the crystal in the Temple of the Fist and return to Winston Schezar in Bootleg Bay."
msgstr "주먹의 신전에 있는 수정을 파괴한 뒤 부틀렉 베이의 윈스턴 셰자르에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=115 field=text status=translated
msgctxt "engine:quests.txt:115:text"
msgid "Bring Rihansi in Alvar the basic ingredients for a potion of Pure Luck."
msgstr "순수한 운 물약의 기본 재료를 알바르의 리한시에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1160 field=text status=translated
msgctxt "engine:quests.txt:1160:text"
msgid "Rescue Emmanuel from the Temple of the Snake near Blackshire and return him to Joanne Cravitz in Blackshire."
msgstr "블랙셔 근처 뱀의 신전에서 에마뉘엘을 구출해 블랙셔의 조앤 크래비츠에게 데려가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1161 field=text status=translated
msgctxt "engine:quests.txt:1161:text"
msgid "Find the lost artifact in the Dragoons' Keep near Castle Temper and return it to Zoltan Phelps in Free Haven."
msgstr "템퍼 성 근처 드라군 요새에서 잃어버린 유물을 찾아 프리 헤이븐의 졸탄 펠프스에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1162 field=text status=translated
msgctxt "engine:quests.txt:1162:text"
msgid "Rescue Sharry from the Shadow Guild Hideout and return with her to Frank Fairchild in New Sorpigal."
msgstr "섀도 길드 은신처에서 셰리를 구출해 뉴 소르피갈의 프랭크 페어차일드에게 데려가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1163 field=text status=translated
msgctxt "engine:quests.txt:1163:text"
msgid "Rescue Angela from the Abandoned Temple and return her to Violet Dawson in New Sorpigal."
msgstr "버려진 신전에서 앤절라를 구출해 뉴 소르피갈의 바이올렛 도슨에게 데려가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1164 field=text status=translated
msgctxt "engine:quests.txt:1164:text"
msgid "Rescue Sherell from the cannibals on the islands east of Free Haven and return with her to Carlo Tormini in Free Haven."
msgstr "프리 헤이븐 동쪽 섬의 식인종들에게서 셰렐을 구출해 프리 헤이븐의 카를로 토르미니에게 데려가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1165 field=text status=translated
msgctxt "engine:quests.txt:1165:text"
msgid "Destroy the Werewolf's altar in the Lair of the Wolf and return to Maria Trepan in Blackshire."
msgstr "늑대 소굴에 있는 늑대인간의 제단을 파괴한 뒤 블랙셔의 마리아 트레판에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1167 field=text status=translated
msgctxt "engine:quests.txt:1167:text"
msgid "Find the Pearl of Putrescence in the Lair of the Wolf and bring it to the Ghost of Balthasar, also in the Lair of the Wolf."
msgstr "늑대 소굴에서 부패의 진주를 찾아 같은 곳에 있는 발타자르의 유령에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1168 field=text status=translated
msgctxt "engine:quests.txt:1168:text"
msgid "Retrieve the jewelled egg from Castle Kriegspire and return it to Emil Lime in Kriegspire village."
msgstr "크리그스파이어 성에서 보석 장식 알을 되찾아 크리그스파이어 마을의 에밀 라임에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1169 field=text status=translated
msgctxt "engine:quests.txt:1169:text"
msgid "Unward the doors in the Hall of the Fire Lord and return to the Lord of Fire, also in the Hall of the Fire Lord."
msgstr "불의 군주 전당의 문에 걸린 봉인을 해제한 뒤 같은 곳에 있는 불의 군주에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=117 field=text status=translated
msgctxt "engine:quests.txt:117:text"
msgid "Deliver fake report to the Dread Pirate Stanley in the Pirate's Rest Tavern on the Island of Regna."
msgstr "가짜 보고서를 레그나 섬 파이리츠 레스트 선술집의 공포의 해적 스탠리에게 전달하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1186 field=text status=translated
msgctxt "engine:quests.txt:1186:text"
msgid "Find Memory Crystal Alpha in the Supreme Temple of Baa and restore it to a module altar at the Oracle beneath the High Council.."
msgstr "바의 최고 신전에서 기억 수정 알파를 찾아 최고 평의회 아래 오라클의 모듈 제단에 복원하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1187 field=text status=translated
msgctxt "engine:quests.txt:1187:text"
msgid "Find Memory Crystal Beta in Castle Alamos and restore it to a module altar at the Oracle beneath the High Council."
msgstr "알라모스 성에서 기억 수정 베타를 찾아 최고 평의회 아래 오라클의 모듈 제단에 복원하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1188 field=text status=translated
msgctxt "engine:quests.txt:1188:text"
msgid "Find Memory Crystal Delta in Castle Darkmoor and restore it to a module altar at the Oracle beneath the High Council."
msgstr "다크무어 성에서 기억 수정 델타를 찾아 최고 평의회 아래 오라클의 모듈 제단에 복원하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1189 field=text status=translated
msgctxt "engine:quests.txt:1189:text"
msgid "Find Memory Crystal Epsilon in Castle Kriegspire and restore it to a module altar at the Oracle beneath the High Council."
msgstr "크리그스파이어 성에서 기억 수정 엡실론을 찾아 최고 평의회 아래 오라클의 모듈 제단에 복원하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1190 field=text status=translated
msgctxt "engine:quests.txt:1190:text"
msgid "Retrieve the Control Cube from the Tomb of Varn in Dragonsand and return to the Oracle beneath the High Council."
msgstr "드래곤샌드의 VARN 무덤에서 제어 큐브를 되찾아 최고 평의회 아래 오라클로 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=119 field=text status=translated
msgctxt "engine:quests.txt:119:text"
msgid "Rescue Arion Hunter's daughter from Ogre Fortress in Alvar."
msgstr "알바르의 오우거 요새에서 아리온 헌터의 딸을 구출하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=11 field=text status=translated
msgctxt "engine:quests.txt:11:text"
msgid "Report to Bastian Loudrin, the merchant guildmaster in Alvar."
msgstr "알바르의 상인 길드장 바스티안 라우드린에게 보고하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=121 field=text status=translated
msgctxt "engine:quests.txt:121:text"
msgid "Bring Talion in the Ironsand Desert the basic ingredients for a potion of Pure Endurance."
msgstr "순수한 체력 물약의 기본 재료를 아이언샌드 사막의 탈리온에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1224 field=text status=translated
msgctxt "engine:quests.txt:1224:text"
msgid "Find a cure for Slicker Silvertongue in the Superior Temple of Baa east of Castle Kriegspire and return to Wilbur Humphrey with the good news."
msgstr "크리그스파이어 성 동쪽의 상급 바의 신전에서 슬리커 실버텅을 치료할 방법을 찾은 뒤, 좋은 소식을 아이언피스트 성의 윌버 험프리에게 전하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1225 field=text status=translated
msgctxt "engine:quests.txt:1225:text"
msgid "Bring the the letter detailing Silvertongue's treason to the High Council in Free Haven."
msgstr "실버텅의 반역 행위를 기록한 편지를 프리 헤이븐의 최고 평의회에 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1228 field=text status=translated
msgctxt "engine:quests.txt:1228:text"
msgid "Find and destroy the Book of Liches in Castle Darkmoor and return to Terry Ros in Darkmoor village."
msgstr "다크무어 성에서 리치의 책을 찾아 파괴한 뒤 다크무어 마을의 테리 로스에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=123 field=text status=translated
msgctxt "engine:quests.txt:123:text"
msgid "Bring Kelvin in Shadowspire the basic ingredients for a potion of Pure Intellect."
msgstr "순수한 지능 물약의 기본 재료를 섀도스파이어의 켈빈에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1243 field=text status=translated
msgctxt "engine:quests.txt:1243:text"
msgid "Place the statuettes in Sweet Water, Kriegspire, Dragonsand, Mire of the Damned, and Bootleg Bay and return to Twillen in Blackshire."
msgstr "스위트 워터, 크리그스파이어, 드래곤샌드, 저주받은 자들의 수렁, 부틀렉 베이에 조각상들을 놓은 뒤 블랙셔의 트윌렌에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1259 field=text status=translated
msgctxt "engine:quests.txt:1259:text"
msgid "Obtain Arcane Magic from Archibald in the Royal Library in Castle Ironfist"
msgstr "아이언피스트 성 왕립 도서관에 있는 아치볼드에게서 비전 마법을 얻으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=125 field=text status=translated
msgctxt "engine:quests.txt:125:text"
msgid "Bring Castigeir in Murmurwoods the basic ingredients for a potion of Pure Personality."
msgstr "순수한 인격 물약의 기본 재료를 머머우즈의 카스티기어에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=127 field=text status=translated
msgctxt "engine:quests.txt:127:text"
msgid "Recover the shield, Eclipse, for Lathius in Ravenshore."
msgstr "레이븐쇼어의 라시우스를 위해 방패 '일식'을 되찾으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=129 field=text status=translated
msgctxt "engine:quests.txt:129:text"
msgid "Kill all Ogres in the Alvar canyon area and in Ogre Fortress and return to Keldon in Alvar."
msgstr "알바르 협곡과 오우거 요새의 모든 오우거를 처치한 뒤 알바르의 켈던에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=132 field=text status=translated
msgctxt "engine:quests.txt:132:text"
msgid "Bring Galvinus in Ravage Roaming the basic ingredients for a potion of Pure Accuracy."
msgstr "순수한 적중률 물약의 기본 재료를 라비지 로밍의 갈비누스에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=135 field=text status=translated
msgctxt "engine:quests.txt:135:text"
msgid "Find the Prophecies of the Snake for Pascella Tisk."
msgstr "파스셀라 티스크를 위해 뱀의 예언서를 찾으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=137 field=text status=translated
msgctxt "engine:quests.txt:137:text"
msgid "Find Isthric the Tongue, brother of Rohtnax.  Return to Rohtnax in the village of Blood Drop on Dagger Wound Island."
msgstr "로트낵스의 형제인 혀의 이스트릭을 찾으십시오. 대거 운드 섬 블러드 드롭 마을의 로트낵스에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=139 field=text status=translated
msgctxt "engine:quests.txt:139:text"
msgid "Kill all Dire Wolves in Ravenshore. Return to Maddigan in Ravenshore."
msgstr "레이븐쇼어의 모든 다이어 울프를 처치한 뒤 레이븐쇼어의 매디건에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=13 field=text status=translated
msgctxt "engine:quests.txt:13:text"
msgid "Form an alliance among the major factions of Jadame."
msgstr "제이덤의 주요 세력들로 동맹을 결성하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=142 field=text status=translated
msgctxt "engine:quests.txt:142:text"
msgid "Deliver Fire Resistance Potions to the six southernmost houses of Rust.  Return to Hobert in Rust."
msgstr "러스트 최남단의 집 여섯 채에 화염 저항 물약을 전달한 뒤 러스트의 호버트에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=14 field=text status=translated
msgctxt "engine:quests.txt:14:text"
msgid "Form an alliance with the Necromancers' Guild in Shadowspire."
msgstr "섀도스파이어의 강령술사 길드와 동맹을 맺으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=150 field=text status=translated
msgctxt "engine:quests.txt:150:text"
msgid "Find a Dragonbane Flower for Calindril in Garrote Gorge."
msgstr "가로트 협곡의 칼린드릴을 위해 드래곤베인 꽃을 찾으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=152 field=text status=translated
msgctxt "engine:quests.txt:152:text"
msgid "Find a Dragonbane Flower for the Balion Tearwing in the Garrote Gorge Dragon Caves."
msgstr "가로트 협곡 드래곤 동굴의 발리온 티어윙을 위해 드래곤베인 꽃을 찾으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=154 field=text status=translated
msgctxt "engine:quests.txt:154:text"
msgid "Kill all the Dragons in the Garrote Gorge wilderness area. Return to Avalon in Garrote Gorge."
msgstr "가로트 협곡 야외 지역의 모든 드래곤을 처치한 뒤 가로트 협곡의 아발론에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=157 field=text status=translated
msgctxt "engine:quests.txt:157:text"
msgid "Kill all the Dragon Hunter's in the Garrote Gorge wilderness area. Return to Jerin Flame-eye in the Garrote Gorge Dragon Caves."
msgstr "가로트 협곡 야외 지역의 모든 드래곤 사냥꾼을 처치한 뒤 드래곤 동굴의 제린 플레임아이에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=15 field=text status=translated
msgctxt "engine:quests.txt:15:text"
msgid "Form an alliance with the Temple of the Sun in Murmurwoods."
msgstr "머머우즈의 태양의 신전과 동맹을 맺으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=160 field=text status=translated
msgctxt "engine:quests.txt:160:text"
msgid "Find the Legendary Drum of Victory. Return it to Zelim in Garrote Gorge."
msgstr "전설적인 승리의 북을 찾아 가로트 협곡의 젤림에게 돌려주십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=162 field=text status=translated
msgctxt "engine:quests.txt:162:text"
msgid "Find Iseldir's Puzzle Box for Benefice of Shadowspire."
msgstr "섀도스파이어의 베네피스를 위해 이셀디어의 퍼즐 상자를 찾으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=164 field=text status=translated
msgctxt "engine:quests.txt:164:text"
msgid "Find a Vial of Grave Dirt. Return it to Halien in Shadowspire."
msgstr "무덤 흙이 든 병을 찾아 섀도스파이어의 할리엔에게 돌려주십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=166 field=text status=translated
msgctxt "engine:quests.txt:166:text"
msgid "Find the Bone of Doom for Tantilion of Shadowspire."
msgstr "섀도스파이어의 탄틸리온을 위해 파멸의 뼈를 찾으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=16 field=text status=translated
msgctxt "engine:quests.txt:16:text"
msgid "Form an alliance with the Dragon hunters of Garrote Gorge."
msgstr "가로트 협곡의 드래곤 사냥꾼들과 동맹을 맺으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1712 field=text status=translated
msgctxt "engine:quests.txt:1712:text"
msgid "Mysterious woman asked you to travel in time and fulfill destinies of other heroes. Well..."
msgstr "정체불명의 여인이 시간을 여행해 다른 영웅들의 운명을 완수해 달라고 했습니다. 뭐…"

#. assets_dev/engine/data_tables/english/quests.txt record=1713 field=text status=translated
msgctxt "engine:quests.txt:1713:text"
msgid "Enter The Controlled Breach, find Runaway Chaos and bring it to the Uneasy Origin Matter."
msgstr "통제된 균열에 들어가 도망친 혼돈을 찾아 불안정한 기원 물질에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1714 field=text status=translated
msgctxt "engine:quests.txt:1714:text"
msgid "Find your friends."
msgstr "친구들을 찾으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=1715 field=text status=translated
msgctxt "engine:quests.txt:1715:text"
msgid "Find entrance to the main Breach structure."
msgstr "균열 본체로 들어가는 입구를 찾으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=172 field=text status=translated
msgctxt "engine:quests.txt:172:text"
msgid "Challenge the Arcomage Champion in each tavern of Jadame."
msgstr "제이덤의 각 선술집에서 아르코메이지 챔피언에게 도전하십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=173 field=text status=translated
msgctxt "engine:quests.txt:173:text"
msgid "Win a game of Arcomage in all eleven taverns, then return to Tonk Blueswan in Ravenshore."
msgstr "열한 곳의 선술집에서 모두 아르코메이지에 승리한 뒤 레이븐쇼어의 통크 블루스완에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=176 field=text status=translated
msgctxt "engine:quests.txt:176:text"
msgid "Find a wheel of Frelandeau Cheese. Bring it to Asael Fromago in Alvar."
msgstr "프렐랑도 치즈 한 덩이를 찾아 알바르의 아사엘 프로마고에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=177 field=text status=translated
msgctxt "engine:quests.txt:177:text"
msgid "Find a log of Eldenbrie Cheese. Bring it to Asael Fromago in Alvar."
msgstr "엘든브리 치즈 한 덩이를 찾아 알바르의 아사엘 프로마고에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=178 field=text status=translated
msgctxt "engine:quests.txt:178:text"
msgid "Find a ball of Dunduck Cheese. Bring it to Asael Fromago in Alvar."
msgstr "던덕 치즈 한 덩이를 찾아 알바르의 아사엘 프로마고에게 가져가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=17 field=text status=translated
msgctxt "engine:quests.txt:17:text"
msgid "Form an alliance with the Dragons of Garrote Gorge."
msgstr "가로트 협곡의 드래곤들과 동맹을 맺으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=18 field=text status=translated
msgctxt "engine:quests.txt:18:text"
msgid "Form an alliance with the Minotaurs of Ravage Roaming."
msgstr "라비지 로밍의 미노타우로스들과 동맹을 맺으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=236 field=text status=translated
msgctxt "engine:quests.txt:236:text"
msgid "Find the treasure of the Dread Pirate Stanley."
msgstr "공포의 해적 스탠리의 보물을 찾으십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=25 field=text status=translated
msgctxt "engine:quests.txt:25:text"
msgid "Find a witness to the lake of fire's formation. Bring him back to the merchant guild in Alvar."
msgstr "불의 호수가 생겨난 장면을 목격한 사람을 찾아 알바르의 상인 길드로 데려오십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=26 field=text status=translated
msgctxt "engine:quests.txt:26:text"
msgid "Find the skeleton transformer in the Shadowspire Necromancers' Guild. Destroy it and return to Oskar Tyre."
msgstr "섀도스파이어 강령술사 길드에서 해골 변환기를 찾아 파괴한 뒤 오스카 타이어에게 돌아가십시오."

#. assets_dev/engine/data_tables/english/quests.txt record=284 field=text status=translated
msgctxt "engine:quests.txt:284:text"
msgid "Return to Fellmoon in Ravenshore and report your success in blackmailing the wererat smuggler, Arion Hunter."
msgstr "레이븐쇼어의 펠문에게 돌아가 웨어랫 밀수꾼 아리온 헌터를 협박하는 데 성공했다고 보고하십시오."

