#. assets_dev/engine/data_tables/items.txt record=1488 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1488:NotIdentifiedName"
msgid "Lump of Ore"
msgstr "광석 덩어리"

#. assets_dev/engine/data_tables/items.txt record=1488 field=Notes status=translated
msgctxt "engine:items.txt:1488:Notes"
msgid "A small chunk of iron-laced ore.  In the hands of a skilled craftsman, this could make a weapon, an amulet, a ring, armor, or almost any other useful item."
msgstr "철이 함유된 작은 광석 덩어리. 숙련된 장인의 손에 들어가면 이것으로 무기, 부적, 반지, 갑옷 또는 거의 모든 유용한 물건을 만들 수 있다."

#. assets_dev/engine/data_tables/items.txt record=1489 field=Name status=translated
msgctxt "engine:items.txt:1489:Name"
msgid "Siertal-laced ore"
msgstr "시에르탈 함유 광석"

#. assets_dev/engine/data_tables/items.txt record=1489 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1489:NotIdentifiedName"
msgid "Lump of Ore"
msgstr "광석 덩어리"

#. assets_dev/engine/data_tables/items.txt record=1489 field=Notes status=translated
msgctxt "engine:items.txt:1489:Notes"
msgid "A small chunk of siertal-laced ore.  Stronger and lighter than steel, in the hands of a skilled craftsman siertal could make an exceptional weapon, an amulet, a ring, armor, or almost any other useful item."
msgstr "시에르탈이 함유된 작은 광석 조각. 강철보다 강하고 가벼운 시에르탈은 숙련된 장인의 손에서 뛰어난 무기, 부적, 반지, 갑옷 또는 거의 모든 유용한 물건을 만들 수 있습니다."

#. assets_dev/engine/data_tables/items.txt record=148 field=Name status=translated
msgctxt "engine:items.txt:148:Name"
msgid "Jade Amulet"
msgstr "옥 부적"

#. assets_dev/engine/data_tables/items.txt record=148 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:148:NotIdentifiedName"
msgid "Amulet"
msgstr "부적"

#. assets_dev/engine/data_tables/items.txt record=148 field=Notes status=translated
msgctxt "engine:items.txt:148:Notes"
msgid "A large polished jade stone decorates and adds value to this simple amulet."
msgstr "큼지막하게 다듬어진 옥돌이 이 소박한 부적을 장식하고 가치를 더해줍니다."

#. assets_dev/engine/data_tables/items.txt record=1490 field=Name status=translated
msgctxt "engine:items.txt:1490:Name"
msgid "Phylt-laced ore"
msgstr "필트 함유 광석"

#. assets_dev/engine/data_tables/items.txt record=1490 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1490:NotIdentifiedName"
msgid "Lump of Ore"
msgstr "광석 덩어리"

#. assets_dev/engine/data_tables/items.txt record=1490 field=Notes status=translated
msgctxt "engine:items.txt:1490:Notes"
msgid "A small chunk of phylt-laced ore.  Phylt is often used in steel alloys to increase the durability and enchantability of steel.  In the hands of a skilled craftsman phylt could make a weapon, an amulet, a ring, armor, or almost any other useful item."
msgstr "필트가 함유된 작은 광석 조각입니다. 필트는 강철 합금에 자주 사용되어 강철의 내구성과 마법 부여 가능성을 높입니다. 숙련된 장인의 손에서 필트는 무기, 부적, 반지, 갑옷 또는 거의 모든 유용한 물건을 만들 수 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1491 field=Name status=translated
msgctxt "engine:items.txt:1491:Name"
msgid "Kergar-laced ore"
msgstr "케르가르 함유 광석"

#. assets_dev/engine/data_tables/items.txt record=1491 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1491:NotIdentifiedName"
msgid "Lump of Ore"
msgstr "광석 덩어리"

#. assets_dev/engine/data_tables/items.txt record=1491 field=Notes status=translated
msgctxt "engine:items.txt:1491:Notes"
msgid "A small chunk of kergar-laced ore.  Kergar shares many properties of steel, but is much easier to enchant.  In the hands of a skilled craftsman kergar could easily make a magical weapon, an amulet, a ring, armor, or almost any other item."
msgstr "케르가르가 함유된 작은 광석 조각입니다. 케르가르는 강철과 많은 특성을 공유하지만, 마법을 부여하기가 훨씬 쉽습니다. 숙련된 장인의 손에서 케르가르는 마법 무기, 부적, 반지, 갑옷 또는 거의 모든 다른 아이템을 쉽게 만들 수 있습니다."

#. assets_dev/engine/data_tables/items.txt record=1492 field=Name status=translated
msgctxt "engine:items.txt:1492:Name"
msgid "Erudine-laced ore"
msgstr "에루딘 함유 광석"

#. assets_dev/engine/data_tables/items.txt record=1492 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:1492:NotIdentifiedName"
msgid "Lump of Ore"
msgstr "광석 덩어리"

#. assets_dev/engine/data_tables/items.txt record=1492 field=Notes status=translated
msgctxt "engine:items.txt:1492:Notes"
msgid "A small chunk of erudine-laced ore.  A rare magical ore found in few regions of Erathia, in the hands of a skilled craftsman erudine could make a powerful weapon, an amulet, a ring, armor, or almost any other item."
msgstr "에루딘이 함유된 작은 광석 조각. 에라시아의 몇몇 지역에서만 발견되는 희귀한 마법 광석인 에루딘은 숙련된 장인의 손에서 강력한 무기, 부적, 반지, 갑옷 또는 거의 모든 다른 물건을 만들 수 있습니다."

