msgid "Gemstone"
msgstr "보석"

#. assets_dev/engine/data_tables/items.txt record=992 field=Notes status=translated
msgctxt "engine:items.txt:992:Notes"
msgid "An Antagarichan green garnet in a unique flat square step cut. As a gem quality stone it has no magical properties, so you might as well sell it."
msgstr "독특한 플랫 스퀘어 스텝 컷으로 커팅된 안타개릭산 녹색 석류석입니다. 보석으로서의 품질은 좋지만 마법적인 효능은 없으니 판매하시는 것도 괜찮습니다."

#. assets_dev/engine/data_tables/items.txt record=993 field=Name status=translated
