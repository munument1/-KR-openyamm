#. assets_dev/engine/data_tables/npc.txt record=995 field=Name status=translated
msgctxt "engine:npc.txt:995:Name"
msgid "Jules Miles"
msgstr "줄스 마일스"

#. assets_dev/engine/data_tables/npc.txt record=996 field=Name status=translated
msgctxt "engine:npc.txt:996:Name"
msgid "Ryan Treacle"
msgstr "라이언 트리클"

#. assets_dev/engine/data_tables/npc.txt record=997 field=Name status=translated
msgctxt "engine:npc.txt:997:Name"
msgid "Maria Trepan"
msgstr "마리아 트레판"

#. assets_dev/engine/data_tables/npc.txt record=998 field=Name status=translated
msgctxt "engine:npc.txt:998:Name"
msgid "Cheryl Duncan"
msgstr "셰릴 던컨"

#. assets_dev/engine/data_tables/npc.txt record=999 field=Name status=translated
msgctxt "engine:npc.txt:999:Name"
msgid "Woodrow Albright"
msgstr "우드로 올브라이트"

#. assets_dev/engine/data_tables/npc.txt record=99 field=Name status=translated
msgctxt "engine:npc.txt:99:Name"
msgid "Gibere"
msgstr "기베어"

#. assets_dev/engine/data_tables/npc.txt record=9 field=Name status=translated
msgctxt "engine:npc.txt:9:Name"
msgid "Sandro"
msgstr "산드로"

#. assets_dev/engine/data_tables/npc_greet.txt record=100 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:100:Greeting1"
msgid "What do you want?"
msgstr "무슨 용건이오?"

#. assets_dev/engine/data_tables/npc_greet.txt record=100 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:100:Greeting2"
msgid "What do you want?"
msgstr "무슨 용건이오?"

#. assets_dev/engine/data_tables/npc_greet.txt record=101 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:101:Greeting1"
msgid "Are you the new recruits? Of course you are! Why else would you be seeking me out? I'm ex-Captain Terrence, here to help you on your way to becoming proper Regnan sailors."
msgstr "새로 온 신병들이오? 물론 그렇겠지! 다른 이유로 나를 찾아왔을 리가 없으니까. 나는 전직 선장 테런스요. 그대들이 제대로 된 레그나 선원이 되도록 도와주러 왔소."

#. assets_dev/engine/data_tables/npc_greet.txt record=101 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:101:Greeting2"
msgid "Ah, the new recruits again! What can I do for you?"
msgstr "아, 신입들이 또 왔군! 무엇을 도와줄까?"

#. assets_dev/engine/data_tables/npc_greet.txt record=102 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:102:Greeting1"
msgid "How are you? What can a simple fisherwoman do for you today?"
msgstr "어떻게 지내세요? 오늘은 평범한 어부 여인이 무엇을 도와드릴까요?"

#. assets_dev/engine/data_tables/npc_greet.txt record=102 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:102:Greeting2"
msgid "How are you? What can a simple fisherwoman do for you today?"
msgstr "어떻게 지내세요? 오늘은 평범한 어부 여인이 무엇을 도와드릴까요?"

#. assets_dev/engine/data_tables/npc_greet.txt record=103 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:103:Greeting1"
msgid "Hello?\nAh, someone else who seeks a way off this accursed island!\nMy name is Simon Templar!\nI found my way into this temple as I was told it was the way out!\nLet's travel together!"
msgstr "여보세요?\n아, 이 저주받은 섬을 빠져나갈 길을 찾는 사람이 또 있군요!\n제 이름은 사이먼 템플러입니다!\n이 신전이 탈출구라는 말을 듣고 들어왔습니다!\n함께 갑시다!"

#. assets_dev/engine/data_tables/npc_greet.txt record=103 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:103:Greeting2"
msgid "Hello?\nAh, someone else who seeks a way off this accursed island!\nMy name is Simon Templar!\nI found my way into this temple as I was told it was the way out!\nLet's travel together!"
msgstr "여보세요?\n아, 이 저주받은 섬을 빠져나갈 길을 찾는 사람이 또 있군요!\n제 이름은 사이먼 템플러입니다!\n이 신전이 탈출구라는 말을 듣고 들어왔습니다!\n함께 갑시다!"

#. assets_dev/engine/data_tables/npc_greet.txt record=104 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:104:Greeting1"
msgid "Greetings, do you seek guidance from the Light?"
msgstr "안녕하시오. 빛의 인도를 구하러 왔습니까?"

#. assets_dev/engine/data_tables/npc_greet.txt record=104 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:104:Greeting2"
msgid "Greetings, do you seek guidance from the Light?"
msgstr "안녕하시오. 빛의 인도를 구하러 왔습니까?"

#. assets_dev/engine/data_tables/npc_greet.txt record=105 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:105:Greeting1"
msgid "Nooo!\nWhat…where am I? You rescued me?\nMy thanks!!"
msgstr "으아아!\n뭐지…여기가 어디죠? 당신이 저를 구해 주셨습니까?\n감사합니다!!"

#. assets_dev/engine/data_tables/npc_greet.txt record=105 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:105:Greeting2"
msgid "Nooo!\nWhat…where am I? You rescued me?\nMy thanks!!"
msgstr "으아아!\n뭐지…여기가 어디죠? 당신이 저를 구해 주셨습니까?\n감사합니다!!"

#. assets_dev/engine/data_tables/npc_greet.txt record=106 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:106:Greeting1"
msgid "Welcome!\nI can make many wondrous things from the various ores that are indigenous to Jadame."
msgstr "어서 오세요!\n제이덤에서 나는 여러 광석으로 온갖 놀라운 물건을 만들 수 있습니다."

#. assets_dev/engine/data_tables/npc_greet.txt record=106 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:106:Greeting2"
msgid "Welcome!\nI can make many wondrous things from the various ores that are indigenous to Jadame."
msgstr "어서 오세요!\n제이덤에서 나는 여러 광석으로 온갖 놀라운 물건을 만들 수 있습니다."

#. assets_dev/engine/data_tables/npc_greet.txt record=107 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:107:Greeting1"
msgid "Halt! These areas are off limits to guests! Guild members only!"
msgstr "멈추시오! 이 구역은 방문객 출입 금지입니다! 길드 회원만 들어갈 수 있습니다!"

#. assets_dev/engine/data_tables/npc_greet.txt record=107 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:107:Greeting2"
msgid "Halt! These areas are off limits to guests! Guild members only!"
msgstr "멈추시오! 이 구역은 방문객 출입 금지입니다! 길드 회원만 들어갈 수 있습니다!"

#. assets_dev/engine/data_tables/npc_greet.txt record=108 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:108:Greeting1"
msgid "You may not enter here, puny ones! Stand back or become our prey!"
msgstr "하찮은 것들아, 이곳에는 들어올 수 없다! 물러서지 않으면 우리의 먹잇감이 될 것이다!"

#. assets_dev/engine/data_tables/npc_greet.txt record=108 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:108:Greeting2"
msgid "You may not enter here, puny ones! Stand back or become our prey!"
msgstr "하찮은 것들아, 이곳에는 들어올 수 없다! 물러서지 않으면 우리의 먹잇감이 될 것이다!"

#. assets_dev/engine/data_tables/npc_greet.txt record=109 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:109:Greeting1"
msgid "Halt! Only members of our knightly brotherhood may pass this point. Others who attempt to pass will face our wrath!"
msgstr "멈추시오! 우리 기사단의 형제들만 이 지점을 통과할 수 있소. 억지로 지나가려는 자는 우리의 분노를 마주할 것이오!"

#. assets_dev/engine/data_tables/npc_greet.txt record=109 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:109:Greeting2"
msgid "Halt! Only members of our knightly brotherhood may pass this point. Others who attempt to pass will face our wrath!"
msgstr "멈추시오! 우리 기사단의 형제들만 이 지점을 통과할 수 있소. 억지로 지나가려는 자는 우리의 분노를 마주할 것이오!"

#. assets_dev/engine/data_tables/npc_greet.txt record=10 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:10:Greeting1"
msgid "Welcome to the Ravenshore guildhouse of the Merchants of Alvar. I am Elgar Fellmoon. How may I help you?"
msgstr "레이븐쇼어의 알바르 상인회관에 오신 것을 환영합니다. 저는 엘가 펠문입니다. 무엇을 도와드릴까요?"

#. assets_dev/engine/data_tables/npc_greet.txt record=10 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:10:Greeting2"
msgid "Yes?"
msgstr "네?"

#. assets_dev/engine/data_tables/npc_greet.txt record=110 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:110:Greeting1"
msgid "Stop! You may not enter the storeroom!"
msgstr "멈추시오! 창고에는 들어갈 수 없습니다!"

#. assets_dev/engine/data_tables/npc_greet.txt record=110 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:110:Greeting2"
msgid "Stop! You may not enter the storeroom!"
msgstr "멈추시오! 창고에는 들어갈 수 없습니다!"

#. assets_dev/engine/data_tables/npc_greet.txt record=111 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:111:Greeting1"
msgid "Hail! I'm Jeric Whistlebone. Welcome to my camp. We're on a hunting safari. You're welcome to look around, but don't interfere with our operation. This is no place for amateur fumbling about!"
msgstr "반갑소! 나는 제릭 휘슬본이오. 내 야영지에 온 것을 환영하오. 우리는 사냥 여행 중이오. 둘러보는 것은 좋지만 우리 작업을 방해하지 마시오. 이곳은 아마추어가 어설프게 굴 곳이 아니오!"

#. assets_dev/engine/data_tables/npc_greet.txt record=111 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:111:Greeting2"
msgid "Hello, again."
msgstr "또 오셨군요."

#. assets_dev/engine/data_tables/npc_greet.txt record=112 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:112:Greeting1"
msgid "You are back? Have you need of advice? Or are you finding the task at hand too difficult?"
msgstr "돌아왔군요? 조언이 필요합니까? 아니면 맡은 일이 너무 어렵습니까?"

#. assets_dev/engine/data_tables/npc_greet.txt record=112 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:112:Greeting2"
msgid "You are back? Have you need of advice? Or are you finding the task at hand too difficult?"
msgstr "돌아왔군요? 조언이 필요합니까? 아니면 맡은 일이 너무 어렵습니까?"

#. assets_dev/engine/data_tables/npc_greet.txt record=113 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:113:Greeting1"
msgid "Greetings. I am the Oracle of Jadame. The mysteries of the Hidden World are open to me. Through long years of training, I have gained a small measure of control over time and space. I can reach my hand through the void and bring things to me--both items and knowledge."
msgstr "안녕하시오. 나는 제이덤의 예언자요. 숨겨진 세계의 신비가 내게 열려 있소. 오랜 세월 훈련한 끝에 시간과 공간을 조금이나마 통제하게 되었소. 허공 너머로 손을 뻗어 물건과 지식을 모두 내게 가져올 수 있소."

#. assets_dev/engine/data_tables/npc_greet.txt record=113 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:113:Greeting2"
msgid "Greetings, and may the Balance always tilt in your favor."
msgstr "안녕하시오. 균형이 언제나 그대에게 유리하게 기울기를."

#. assets_dev/engine/data_tables/npc_greet.txt record=114 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:114:Greeting1"
msgid "Halt! Only guild members and their guests can pass this point. Further, any guild members with you must be at least, conscious. You have old Leland with you, but he's in no condition to oversee you."
msgstr "멈추시오! 길드 회원과 그 손님만 이곳을 통과할 수 있소. 게다가 동행한 길드 회원은 적어도 의식이 있어야 하오. 늙은 릴런드가 함께 있기는 하지만, 지금 상태로는 당신들을 감독할 수 없소."

#. assets_dev/engine/data_tables/npc_greet.txt record=114 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:114:Greeting2"
msgid "Halt! Only guild members and their guests can pass this point. Further, any guild members with you must be at least, conscious. You have old Leland with you, but he's in no condition to oversee you."
msgstr "멈추시오! 길드 회원과 그 손님만 이곳을 통과할 수 있소. 게다가 동행한 길드 회원은 적어도 의식이 있어야 하오. 늙은 릴런드가 함께 있기는 하지만, 지금 상태로는 당신들을 감독할 수 없소."

#. assets_dev/engine/data_tables/npc_greet.txt record=115 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:115:Greeting1"
msgid "Help me!"
msgstr "도와주세요!"

#. assets_dev/engine/data_tables/npc_greet.txt record=115 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:115:Greeting2"
msgid "Help me!"
msgstr "도와주세요!"

#. assets_dev/engine/data_tables/npc_greet.txt record=116 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:116:Greeting1"
msgid "I am Lord Markham, the benefactor providing the castle that is the prize of the this contest."
msgstr "나는 이 대회의 상품인 성을 제공한 후원자 마크햄 경이오."

#. assets_dev/engine/data_tables/npc_greet.txt record=116 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:116:Greeting2"
msgid "Nice to see you again, how are you doing on the hunt?"
msgstr "다시 만나 반갑습니다. 사냥은 잘되어 갑니까?"

#. assets_dev/engine/data_tables/npc_greet.txt record=117 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:117:Greeting1"
msgid "Greetings, my name is Thomas.\nI am the judge of the contest."
msgstr "안녕하시오, 내 이름은 토머스요.\n나는 대회의 심판이오."

#. assets_dev/engine/data_tables/npc_greet.txt record=117 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:117:Greeting2"
msgid "Have you collected everything on the list yet?"
msgstr "목록에 있는 물건을 모두 모았습니까?"

#. assets_dev/engine/data_tables/npc_greet.txt record=118 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:118:Greeting1"
msgid "Welcome to Emerald Island, my name is Margaret and I'll be your docent for your stay here."
msgstr "에메랄드 섬에 온 것을 환영합니다. 제 이름은 마거릿이며, 머무는 동안 안내를 맡겠습니다."

#. assets_dev/engine/data_tables/npc_greet.txt record=118 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:118:Greeting2"
msgid "What would you like to know?"
msgstr "무엇이 알고 싶습니까?"

#. assets_dev/engine/data_tables/npc_greet.txt record=119 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:119:Greeting1"
msgid "Hello, my name is Ailyssa.\nI'm the Bard in charge of overseeing the entertainment on Emerald Island for the duration of the Scavenger Hunt."
msgstr "안녕하세요, 제 이름은 알리사예요.\n보물찾기가 진행되는 동안 에메랄드 섬의 여흥을 감독하는 음유시인이에요."

#. assets_dev/engine/data_tables/npc_greet.txt record=119 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:119:Greeting2"
msgid "Hello again, how are you doing?"
msgstr "또 오셨군요. 잘 지내고 계십니까?"

#. assets_dev/engine/data_tables/npc_greet.txt record=11 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:11:Greeting1"
msgid "Have you done as I've asked of you?"
msgstr "내가 부탁한 일을 해냈소?"

#. assets_dev/engine/data_tables/npc_greet.txt record=11 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:11:Greeting2"
msgid "Have you done as I've asked of you?"
msgstr "내가 부탁한 일을 해냈소?"

#. assets_dev/engine/data_tables/npc_greet.txt record=120 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:120:Greeting1"
msgid "Hi there!\nI'm Sally.\nI don't usually see people this far from town, are you lost?"
msgstr "안녕하세요!\n저는 샐리예요.\n보통 마을에서 이렇게 먼 곳까지 나온 사람은 보지 못하는데, 길을 잃으셨나요?"

#. assets_dev/engine/data_tables/npc_greet.txt record=120 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:120:Greeting2"
msgid "Still out here?\nTown's back a ways to the south."
msgstr "아직도 여기 계시오?\n마을은 남쪽으로 좀 돌아가야 하오."

#. assets_dev/engine/data_tables/npc_greet.txt record=121 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:121:Greeting1"
msgid "Pssst…\nCome here, I have an offer for you."
msgstr "쉿…\n이리 와요. 제안할 것이 있어요."

#. assets_dev/engine/data_tables/npc_greet.txt record=121 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:121:Greeting2"
msgid "Ah, you've returned, no doubt to listen to my proposal."
msgstr "아, 돌아오셨군요. 틀림없이 제 제안을 들으러 오셨겠지요."

#. assets_dev/engine/data_tables/npc_greet.txt record=122 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:122:Greeting1"
msgid "Hello there, stranger <wink>.\nFine weather we're having, no?"
msgstr "안녕하세요, 낯선 분 <wink>.\n날씨가 참 좋지요, 그렇죠?"

#. assets_dev/engine/data_tables/npc_greet.txt record=122 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:122:Greeting2"
msgid "Did you need something, stranger?\n<whisper> Get away from me, are you trying to get caught on purpose?!"
msgstr "무슨 일이 필요합니까, 낯선 분?\n<whisper> 내게서 떨어져요. 일부러 들키려는 겁니까?!"

#. assets_dev/engine/data_tables/npc_greet.txt record=123 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:123:Greeting1"
msgid "Hello there, friend.\nMay I have a word with you?"
msgstr "안녕하세요, 친구.\n잠깐 이야기해도 될까요?"

#. assets_dev/engine/data_tables/npc_greet.txt record=123 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:123:Greeting2"
msgid "Hello again… friend."
msgstr "또 오셨군요… 친구."

#. assets_dev/engine/data_tables/npc_greet.txt record=124 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:124:Greeting1"
msgid "I don't believe we have anything to talk about."
msgstr "우리가 나눌 이야기는 없는 것 같군요."

#. assets_dev/engine/data_tables/npc_greet.txt record=124 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:124:Greeting2"
msgid "I don't believe we have anything to talk about."
msgstr "우리가 나눌 이야기는 없는 것 같군요."

#. assets_dev/engine/data_tables/npc_greet.txt record=125 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:125:Greeting1"
msgid "Hail and well met.\nI'm Brent Filiant, a contestant in Lord Markham's scavenger hunt."
msgstr "반갑습니다.\n저는 마크햄 경의 보물찾기 대회 참가자 브렌트 필리언트입니다."

#. assets_dev/engine/data_tables/npc_greet.txt record=125 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:125:Greeting2"
msgid "Greetings again, friends."
msgstr "다시 만나 반갑습니다, 친구들."

#. assets_dev/engine/data_tables/npc_greet.txt record=126 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:126:Greeting1"
msgid "Hello, I'm Carolyn.\nI handle the guild memberships for the Fire and Air Guilds here on the island."
msgstr "안녕하세요, 저는 캐럴린입니다.\n이 섬의 불과 공기 길드 가입 업무를 맡고 있습니다."

#. assets_dev/engine/data_tables/npc_greet.txt record=126 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:126:Greeting2"
msgid "Hello, I'm Carolyn.\nI handle the guild memberships for the Fire and Air Guilds here on the island."
msgstr "안녕하세요, 저는 캐럴린입니다.\n이 섬의 불과 공기 길드 가입 업무를 맡고 있습니다."

#. assets_dev/engine/data_tables/npc_greet.txt record=127 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:127:Greeting1"
msgid "I'm Roger and I sell guild memberships for the Body and Spirit Guilds on Emerald Island."
msgstr "나는 로저요. 에메랄드 섬에서 육체와 영혼 길드 회원권을 팔고 있소."

#. assets_dev/engine/data_tables/npc_greet.txt record=127 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:127:Greeting2"
msgid "I'm Roger and I sell guild memberships for the Body and Spirit Guilds on Emerald Island."
msgstr "나는 로저요. 에메랄드 섬에서 육체와 영혼 길드 회원권을 팔고 있소."

#. assets_dev/engine/data_tables/npc_greet.txt record=128 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:128:Greeting1"
msgid "Ahoy matey!\nI be William Darvees, captain of this vessel."
msgstr "어이, 선원!\n나는 이 배의 선장 윌리엄 다비스요."

#. assets_dev/engine/data_tables/npc_greet.txt record=128 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:128:Greeting2"
msgid "Aye, good to see you again, mates!"
msgstr "그래, 다시 보니 반갑군, 친구들!"

#. assets_dev/engine/data_tables/npc_greet.txt record=129 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:129:Greeting1"
msgid "Hello, my name is Donna, I live here with my daughter Sally."
msgstr "안녕하세요, 제 이름은 도나예요. 딸 샐리와 함께 이곳에 살고 있습니다."

#. assets_dev/engine/data_tables/npc_greet.txt record=129 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:129:Greeting2"
msgid "Hello again, what can I do for you?"
msgstr "또 오셨군요. 무엇을 도와드릴까요?"

#. assets_dev/engine/data_tables/npc_greet.txt record=12 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:12:Greeting1"
msgid "Okay…you've beaten my guards. Truce.I'm Arion Hunter. I suppose you could call this all my operation. What do you want?"
msgstr "좋소…내 경비병들을 쓰러뜨렸군. 휴전이오. 나는 아리온 헌터요. 이 모든 일을 내가 운영한다고 보면 되오. 원하는 게 뭐요?"

#. assets_dev/engine/data_tables/npc_greet.txt record=12 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:12:Greeting2"
msgid "What is it now?"
msgstr "이번엔 또 무슨 일이오?"

#. assets_dev/engine/data_tables/npc_greet.txt record=130 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:130:Greeting1"
msgid "Hi, I'm Grant.\nTor allows me to live in the back of his shop as long as I stay his apprentice."
msgstr "안녕하세요, 저는 그랜트예요.\n토르는 제가 계속 그의 제자로 있는 동안 상점 뒤편에서 살게 해 주고 있어요."

#. assets_dev/engine/data_tables/npc_greet.txt record=130 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:130:Greeting2"
msgid "Hi again, did you need something?"
msgstr "또 오셨군요. 무슨 일이 있습니까?"

#. assets_dev/engine/data_tables/npc_greet.txt record=131 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:131:Greeting1"
msgid "Greetings, I'm Mia.\nDo you need something?"
msgstr "안녕하시오, 나는 미아라고 하오.\n필요한 것이 있소?"

#. assets_dev/engine/data_tables/npc_greet.txt record=131 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:131:Greeting2"
msgid "Yes?\nWhat do you want?"
msgstr "네?\n무슨 용건이오?"

#. assets_dev/engine/data_tables/npc_greet.txt record=132 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:132:Greeting1"
msgid "Halt!\nYou do not have authorization to proceed.\nWe request that you refrain from disturbing the students while they work."
msgstr "멈추시오!\n당신에게는 이곳을 통과할 권한이 없습니다.\n학생들이 작업하는 동안 방해하지 말아 주십시오."

#. assets_dev/engine/data_tables/npc_greet.txt record=132 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:132:Greeting2"
msgid "Halt!\nYou do not have authorization to proceed.\nWe request that you refrain from disturbing the students while they work."
msgstr "멈추시오!\n당신에게는 이곳을 통과할 권한이 없습니다.\n학생들이 작업하는 동안 방해하지 말아 주십시오."

#. assets_dev/engine/data_tables/npc_greet.txt record=133 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:133:Greeting1"
msgid "Welcome to Emerald Island.\nI will be your guide during your stay here.\nFrom time to time I will appear to tell you about something you're about to see to help you understand your New World.\nIf you tire of my messages (I won't be offended if you do), just click on my portrait to talk to me then click on 'Tour Off' to silence me.\n"
msgstr "에메랄드 섬에 오신 것을 환영합니다.\n머무시는 동안 제가 안내를 맡겠습니다.\n때때로 제가 나타나 곧 보게 될 것들을 설명하여 새로운 세계를 이해하도록 도와드리겠습니다.\n제 안내가 지겨워져도 상심하지 않으니, 제 초상화를 눌러 말을 건 뒤 '안내 끄기'를 선택하면 안내를 중단할 수 있습니다.\n"

#. assets_dev/engine/data_tables/npc_greet.txt record=133 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:133:Greeting2"
msgid "Welcome to Emerald Island.\nI will be your guide during your stay here.\nFrom time to time I will appear to tell you about something you're about to see to help you understand your New World.\nIf you tire of my messages (I won't be offended if you do), just click on my portrait to talk to me then click on 'Tour Off' to silence me.\n"
msgstr "에메랄드 섬에 오신 것을 환영합니다.\n머무시는 동안 제가 안내를 맡겠습니다.\n때때로 제가 나타나 곧 보게 될 것들을 설명하여 새로운 세계를 이해하도록 도와드리겠습니다.\n제 안내가 지겨워져도 상심하지 않으니, 제 초상화를 눌러 말을 건 뒤 '안내 끄기'를 선택하면 안내를 중단할 수 있습니다.\n"

#. assets_dev/engine/data_tables/npc_greet.txt record=134 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:134:Greeting1"
msgid "The shop you are near is the Blacksmith shop.\nThe blacksmith only sells weapons, but this one sells many different kinds of weapons, and some of them have magical properties.\nYou can also sell weapons here, but you won't get a good deal until you have a higher merchant skill.\nTo enter, just click on the front door."
msgstr "가까이에 있는 상점은 대장간입니다.\n대장장이는 무기만 팔지만, 이곳에서는 여러 종류의 무기를 판매하며 일부는 마법 속성도 지니고 있습니다.\n무기를 이곳에 팔 수도 있지만, 상술 기술이 높아지기 전에는 좋은 값을 받기 어렵습니다.\n들어가려면 정문을 누르기만 하십시오."

#. assets_dev/engine/data_tables/npc_greet.txt record=134 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:134:Greeting2"
msgid "The shop you are near is the Blacksmith shop.\nThe blacksmith only sells weapons, but this one sells many different kinds of weapons, and some of them have magical properties.\nYou can also sell weapons here, but you won't get a good deal until you have a higher merchant skill.\nTo enter, just click on the front door."
msgstr "가까이에 있는 상점은 대장간입니다.\n대장장이는 무기만 팔지만, 이곳에서는 여러 종류의 무기를 판매하며 일부는 마법 속성도 지니고 있습니다.\n무기를 이곳에 팔 수도 있지만, 상술 기술이 높아지기 전에는 좋은 값을 받기 어렵습니다.\n들어가려면 정문을 누르기만 하십시오."

#. assets_dev/engine/data_tables/npc_greet.txt record=135 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:135:Greeting1"
msgid "The door to the west leads to the local Tavern.\nThe tavern is a safe place to sleep at night, and to buy food so you can sleep outdoors.\nYou can often meet interesting people in taverns, or catch the local gossip if you're looking for something to do.\nTo enter the tavern, just click on the front door."
msgstr "서쪽 문은 현지 선술집으로 이어집니다.\n선술집은 밤에 안전하게 잠을 자고, 야외에서 숙영할 때 필요한 식량을 살 수 있는 곳입니다.\n선술집에서는 흥미로운 사람을 만나거나, 할 일을 찾고 있다면 현지 소문을 들을 수도 있습니다.\n들어가려면 정문을 누르기만 하십시오."

#. assets_dev/engine/data_tables/npc_greet.txt record=135 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:135:Greeting2"
msgid "The door to the west leads to the local Tavern.\nThe tavern is a safe place to sleep at night, and to buy food so you can sleep outdoors.\nYou can often meet interesting people in taverns, or catch the local gossip if you're looking for something to do.\nTo enter the tavern, just click on the front door."
msgstr "서쪽 문은 현지 선술집으로 이어집니다.\n선술집은 밤에 안전하게 잠을 자고, 야외에서 숙영할 때 필요한 식량을 살 수 있는 곳입니다.\n선술집에서는 흥미로운 사람을 만나거나, 할 일을 찾고 있다면 현지 소문을 들을 수도 있습니다.\n들어가려면 정문을 누르기만 하십시오."

#. assets_dev/engine/data_tables/npc_greet.txt record=136 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:136:Greeting1"
msgid "This shop is the armor shop.\nThe armorer only sells helms, shields, and armor, but will buy nearly anything you can wear, if you don't want to make a separate stop at the magic shop.\nRemember that a character needs skill in leather, chain or plate armor to be able to wear that kind of armor, or shield skill to use a shield."
msgstr "이곳은 갑옷 상점입니다.\n갑옷 상인은 투구, 방패, 갑옷만 팔지만, 마법 상점에 따로 들르고 싶지 않다면 착용 가능한 물건 대부분을 사 줍니다.\n가죽, 사슬, 판금 갑옷을 착용하려면 해당 갑옷 기술이 필요하며, 방패를 사용하려면 방패 기술이 필요하다는 점을 기억하십시오."

#. assets_dev/engine/data_tables/npc_greet.txt record=136 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:136:Greeting2"
msgid "This shop is the armor shop.\nThe armorer only sells helms, shields, and armor, but will buy nearly anything you can wear, if you don't want to make a separate stop at the magic shop.\nRemember that a character needs skill in leather, chain or plate armor to be able to wear that kind of armor, or shield skill to use a shield."
msgstr "이곳은 갑옷 상점입니다.\n갑옷 상인은 투구, 방패, 갑옷만 팔지만, 마법 상점에 따로 들르고 싶지 않다면 착용 가능한 물건 대부분을 사 줍니다.\n가죽, 사슬, 판금 갑옷을 착용하려면 해당 갑옷 기술이 필요하며, 방패를 사용하려면 방패 기술이 필요하다는 점을 기억하십시오."

#. assets_dev/engine/data_tables/npc_greet.txt record=137 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:137:Greeting1"
msgid "This building is Carolyn Weather's private residence.\nCarolyn makes a living by brokering magic guild memberships to aspiring wizards and other spell casters.\nShe will be happy to sell membership in the local Air and Fire guilds for a small fee.\nYou don't have to buy membership in a guild if you don't want to, but remember that you must be a guild member to buy spells and learn skills at a magic guild."
msgstr "이 건물은 캐럴린 웨더스의 개인 주택입니다.\n캐럴린은 마법사가 되려는 이들과 주문 시전자들에게 마법 길드 회원권을 중개하며 생계를 꾸립니다.\n적은 비용으로 현지 공기와 불 길드의 회원권을 기꺼이 판매할 것입니다.\n원하지 않는다면 길드에 가입할 필요는 없지만, 마법 길드에서 주문을 사고 기술을 배우려면 반드시 길드 회원이어야 합니다."

#. assets_dev/engine/data_tables/npc_greet.txt record=137 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:137:Greeting2"
msgid "This building is Carolyn Weather's private residence.\nCarolyn makes a living by brokering magic guild memberships to aspiring wizards and other spell casters.\nShe will be happy to sell membership in the local Air and Fire guilds for a small fee.\nYou don't have to buy membership in a guild if you don't want to, but remember that you must be a guild member to buy spells and learn skills at a magic guild."
msgstr "이 건물은 캐럴린 웨더스의 개인 주택입니다.\n캐럴린은 마법사가 되려는 이들과 주문 시전자들에게 마법 길드 회원권을 중개하며 생계를 꾸립니다.\n적은 비용으로 현지 공기와 불 길드의 회원권을 기꺼이 판매할 것입니다.\n원하지 않는다면 길드에 가입할 필요는 없지만, 마법 길드에서 주문을 사고 기술을 배우려면 반드시 길드 회원이어야 합니다."

#. assets_dev/engine/data_tables/npc_greet.txt record=138 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:138:Greeting1"
msgid "This building is another private residence.\nRoger, the owner of the house, sells membership in the Spirit and Body magic guilds here.\nThe price is low, but you must pay if you intend to take advantage of the guild services, including spell purchases and skill teaching.\nBy the way, if you're getting tired of my messages, you can stop them by clicking on my portrait to talk to me then clicking on the 'Tour Off' topic."
msgstr "이 건물도 개인 주택입니다.\n집주인 로저는 이곳에서 영혼과 육체 마법 길드 회원권을 판매합니다.\n가격은 저렴하지만, 주문 구매와 기술 교육을 포함한 길드 서비스를 이용하려면 비용을 내야 합니다.\n그런데 제 안내가 지겨워졌다면, 제 초상화를 눌러 말을 건 뒤 '안내 끄기' 항목을 선택하여 중단할 수 있습니다."

#. assets_dev/engine/data_tables/npc_greet.txt record=138 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:138:Greeting2"
msgid "This building is another private residence.\nRoger, the owner of the house, sells membership in the Spirit and Body magic guilds here.\nThe price is low, but you must pay if you intend to take advantage of the guild services, including spell purchases and skill teaching.\nBy the way, if you're getting tired of my messages, you can stop them by clicking on my portrait to talk to me then clicking on the 'Tour Off' topic."
msgstr "이 건물도 개인 주택입니다.\n집주인 로저는 이곳에서 영혼과 육체 마법 길드 회원권을 판매합니다.\n가격은 저렴하지만, 주문 구매와 기술 교육을 포함한 길드 서비스를 이용하려면 비용을 내야 합니다.\n그런데 제 안내가 지겨워졌다면, 제 초상화를 눌러 말을 건 뒤 '안내 끄기' 항목을 선택하여 중단할 수 있습니다."

#. assets_dev/engine/data_tables/npc_greet.txt record=139 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:139:Greeting1"
msgid "This door leads to the training center of Emerald Island.\nIf you have enough experience points (gained from killing monsters and completing quests) you can come here to increase your characters' levels.\nWhen you gain a level, you'll also get some skill points to spend on improving your skills.\nYou can only spend skill points on skills that your character knows--to learn new skills, try visiting the businesses around town and see if they offer lessons in anything you're interested in."
msgstr "이 문은 에메랄드 섬의 훈련소로 이어집니다.\n몬스터를 처치하고 퀘스트를 완료해 충분한 경험치를 얻었다면 이곳에서 캐릭터의 레벨을 올릴 수 있습니다.\n레벨이 오르면 기술 향상에 쓸 수 있는 기술 점수도 받습니다.\n기술 점수는 캐릭터가 아는 기술에만 쓸 수 있습니다. 새 기술을 배우려면 마을의 여러 시설을 찾아가 관심 있는 분야를 가르치는지 확인하십시오."

#. assets_dev/engine/data_tables/npc_greet.txt record=139 field=Greeting2 status=translated
msgctxt "engine:npc_greet.txt:139:Greeting2"
msgid "This door leads to the training center of Emerald Island.\nIf you have enough experience points (gained from killing monsters and completing quests) you can come here to increase your characters' levels.\nWhen you gain a level, you'll also get some skill points to spend on improving your skills.\nYou can only spend skill points on skills that your character knows--to learn new skills, try visiting the businesses around town and see if they offer lessons in anything you're interested in."
msgstr "이 문은 에메랄드 섬의 훈련소로 이어집니다.\n몬스터를 처치하고 퀘스트를 완료해 충분한 경험치를 얻었다면 이곳에서 캐릭터의 레벨을 올릴 수 있습니다.\n레벨이 오르면 기술 향상에 쓸 수 있는 기술 점수도 받습니다.\n기술 점수는 캐릭터가 아는 기술에만 쓸 수 있습니다. 새 기술을 배우려면 마을의 여러 시설을 찾아가 관심 있는 분야를 가르치는지 확인하십시오."

#. assets_dev/engine/data_tables/npc_greet.txt record=13 field=Greeting1 status=translated
msgctxt "engine:npc_greet.txt:13:Greeting1"
msgid "Halt! None may pass into the inner chambers unless accompanied by a guild member."
msgstr "멈추시오! 길드 회원과 동행하지 않으면 안쪽 방으로 들어갈 수 없소."

