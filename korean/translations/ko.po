msgctxt "engine:npc_topic_text.txt:717:Text"
msgid "+2 Intellect permanent"
msgstr "지능 영구 +2"

#. assets_dev/engine/data_tables/npc_topic_text.txt record=718 field=Text status=translated
msgctxt "engine:npc_topic_text.txt:718:Text"
msgid "+2 Endurance permanent"
msgstr "체력 영구 +2"

#. assets_dev/engine/data_tables/npc_topic_text.txt record=719 field=Text status=translated
msgctxt "engine:npc_topic_text.txt:719:Text"
msgid "+2 Speed permanent"
msgstr "속도 영구 +2"

#. assets_dev/engine/data_tables/npc_topic_text.txt record=71 field=Text status=translated
msgctxt "engine:npc_topic_text.txt:71:Text"
msgid "What is this?\nYou ally with my mortal enemies and then seek to do me a favor?I wonder what the Dragons think of this. But so be it.\nI am in your debt for returning Ebonest to me.\nI will promote any Knights in your party to Champion, however they will never be accepted in my service.\nThe rest I will teach what I can. I do not wish to see you again!"
msgstr "이게 무슨 짓이지?\n내 숙적들과 손을 잡고서 나를 도우려는 건가? 드래곤들이 이 일을 어떻게 생각할지 궁금하군. 하지만 좋다.\n에보니스트를 돌려준 일은 빚으로 여기겠다.\n일행의 기사들은 챔피언으로 승급시키겠다. 하지만 결코 내 휘하에는 받아들이지 않겠다.\n나머지에게는 내가 가르칠 수 있는 것을 가르쳐 주지. 다시는 보고 싶지 않다!"

#. assets_dev/engine/data_tables/npc_topic_text.txt record=720 field=Text status=translated
msgctxt "engine:npc_topic_text.txt:720:Text"
msgid "+2 Luck permanent"
msgstr "운 영구 +2"

#. assets_dev/engine/data_tables/npc_topic_text.txt record=721 field=Text status=translated
msgctxt "engine:npc_topic_text.txt:721:Text"
msgid "Empty Cauldron"
msgstr "빈 가마솥"

#. assets_dev/engine/data_tables/npc_topic_text.txt record=722 field=Text status=translated
msgctxt "engine:npc_topic_text.txt:722:Text"
