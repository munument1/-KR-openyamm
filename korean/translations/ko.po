msgctxt "engine:items.txt:617:Notes"
msgid "Quest Item: A facet carved stone of dark glassy rock. When tapped it produces a high bell tone."
msgstr "퀘스트 아이템: 어둡고 유리처럼 투명한 암석으로 조각된 돌. 두드리면 높은 종소리가 납니다."

#. assets_dev/engine/data_tables/items.txt record=618 field=Name status=translated
