msgstr "공격 보너스에 기술 수치 2배 적용"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Blaster field=GrandMaster status=translated
msgctxt "engine:english/skill_des.txt:Blaster:GrandMaster"
msgid "Skill added to Attack Bonus (quintuple effect)"
msgstr "공격 보너스에 기술 수치 5배 적용"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Blaster field=Master status=translated
msgctxt "engine:english/skill_des.txt:Blaster:Master"
msgid "Skill added to Attack Bonus (triple effect)"
msgstr "공격 보너스에 기술 수치 3배 적용"

#. assets_dev/engine/data_tables/english/skill_des.txt record=Blaster field=Normal status=translated
