#. assets_dev/engine/data_tables/items.txt record=60 field=Name status=translated
msgctxt "engine:items.txt:60:Name"
msgid "Devilbone Bow"
msgstr "데빌본 활"

#. assets_dev/engine/data_tables/items.txt record=60 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:60:NotIdentifiedName"
msgid "Bow"
msgstr "활"

#. assets_dev/engine/data_tables/items.txt record=60 field=Notes status=translated
msgctxt "engine:items.txt:60:Notes"
msgid "Dark Elven bowsmiths have discovered that unusual characteristics of the Kreegan spinal column make it the best material for heavy bowstaves. A clever arrangement of composite pulleys make it possible for those of less than superhuman strength to pull these mighty weapons."
msgstr "다크 엘프 활 제작자들은 크리건족 척추의 특이한 특성 덕분에 이 재료가 무거운 활대를 만드는 데 가장 적합하다는 것을 발견했습니다. 교묘하게 설계된 복합 도르래 시스템 덕분에 초인적인 힘을 가진 자가 아니더라도 이 강력한 무기를 끌어당길 수 있습니다."

#. assets_dev/engine/data_tables/items.txt record=610 field=Name status=translated
msgctxt "engine:items.txt:610:Name"
msgid "Conflux Key"
msgstr "컨플럭스 열쇠"

#. assets_dev/engine/data_tables/items.txt record=610 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:610:NotIdentifiedName"
msgid "Key"
msgstr "열쇠"

#. assets_dev/engine/data_tables/items.txt record=610 field=Notes status=translated
msgctxt "engine:items.txt:610:Notes"
msgid "Quest Item: Using the four elemental heart gems, Xanthor made you this interplaner key of extreme power. He tells you it will open the crystal gateway which connects Ravenshore to the mysterious Plane Between Planes."
msgstr "퀘스트 아이템: 크산토르는 네 개의 원소 심장 보석을 사용하여 당신을 위해 이 강력한 차원 간 열쇠를 만들었습니다. 그는 이 열쇠가 레이븐쇼어와 신비로운 차원 사이의 영역을 연결하는 수정 관문을 열 것이라고 말합니다."

#. assets_dev/engine/data_tables/items.txt record=611 field=Name status=translated
msgctxt "engine:items.txt:611:Name"
msgid "Lost Book of Kehl"
msgstr "켈의 잃어버린 책"

#. assets_dev/engine/data_tables/items.txt record=611 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:611:NotIdentifiedName"
msgid "Book"
msgstr "책"

#. assets_dev/engine/data_tables/items.txt record=611 field=Notes status=translated
msgctxt "engine:items.txt:611:Notes"
msgid "Quest Item: The formerly \"Lost\" Book of Kehl. Some say he was the greatest necromancer of the last age. Staring at the intricately embossed cover is a disquieting experience as the design seems to writhe with evil energy."
msgstr "퀘스트 아이템: 한때 \"잃어버린\" 케흘의 책. 어떤 이들은 그가 마지막 시대의 가장 위대한 강령술사였다고 말한다. 정교하게 양각된 표지를 바라보면 섬뜩한 기운이 감돈다. 마치 사악한 기운이 꿈틀거리는 듯하다."

#. assets_dev/engine/data_tables/items.txt record=612 field=Name status=translated
msgctxt "engine:items.txt:612:Name"
msgid "Sarcophagus of Korbu"
msgstr "코르부의 석관"

#. assets_dev/engine/data_tables/items.txt record=612 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:612:NotIdentifiedName"
msgid "Sarcophagus"
msgstr "석관"

#. assets_dev/engine/data_tables/items.txt record=612 field=Notes status=translated
msgctxt "engine:items.txt:612:Notes"
msgid "Quest Item: Though painstakingly carved from a single slab of gray stone, Korbu's sarcophagus is inexplicably, much lighter in weight than seems possible. Removal of the snug fitting lid produces a powerful exhalation of myrrh and stale crypt air."
msgstr "퀘스트 아이템: 코르부의 석관은 하나의 회색 돌덩이를 정성스럽게 깎아 만들었음에도 불구하고, 이상하게도 믿을 수 없을 정도로 가볍습니다. 꽉 닫히는 뚜껑을 열면 몰약과 퀴퀴한 무덤 냄새가 강하게 풍겨 나옵니다."

#. assets_dev/engine/data_tables/items.txt record=613 field=Name status=translated
msgctxt "engine:items.txt:613:Name"
msgid "Puzzle Box"
msgstr "퍼즐 상자"

#. assets_dev/engine/data_tables/items.txt record=613 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:613:NotIdentifiedName"
msgid "Box"
msgstr "상자"

#. assets_dev/engine/data_tables/items.txt record=613 field=Notes status=translated
msgctxt "engine:items.txt:613:Notes"
msgid "Quest Item: No matter how you move the shifting panels of this small inlaid box, its lid remains shut. When you shake it, you can hear something rattling around inside. It sounds like a large nut or bead."
msgstr "퀘스트 아이템: 이 작은 상감 상자의 움직이는 판들을 아무리 움직여도 뚜껑은 닫혀 있습니다. 흔들어 보면 안에서 무언가 덜그럭거리는 소리가 들립니다. 마치 커다란 견과류나 구슬 같은 소리입니다."

#. assets_dev/engine/data_tables/items.txt record=614 field=Name status=translated
msgctxt "engine:items.txt:614:Name"
msgid "Vial of Grave Earth"
msgstr "무덤 흙 약병"

#. assets_dev/engine/data_tables/items.txt record=614 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:614:NotIdentifiedName"
msgid "Vial"
msgstr "약병"

#. assets_dev/engine/data_tables/items.txt record=614 field=Notes status=translated
msgctxt "engine:items.txt:614:Notes"
msgid "Quest Item: This is the vial of dirt you stole from the vampire crypt in Shadowspire."
msgstr "퀘스트 아이템: 이것은 당신이 섀도스파이어의 뱀파이어 무덤에서 훔친 흙이 담긴 작은 병입니다."

#. assets_dev/engine/data_tables/items.txt record=615 field=Name status=translated
msgctxt "engine:items.txt:615:Name"
msgid "Drum of Victory"
msgstr "승리의 북"

#. assets_dev/engine/data_tables/items.txt record=615 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:615:NotIdentifiedName"
msgid "Drum"
msgstr "북"

#. assets_dev/engine/data_tables/items.txt record=615 field=Notes status=translated
msgctxt "engine:items.txt:615:Notes"
msgid "Quest Item: This magical items properties are unknown to you. When you tap the drum's head with one of its sticks, the resulting beat resonates with echoes that seem to reflect from the ceiling of the sky."
msgstr "퀘스트 아이템: 이 마법 아이템의 속성은 당신에게 알려지지 않았습니다. 북채로 북면을 두드리면, 그 소리가 하늘 천장에 메아리치는 듯한 울림을 만들어냅니다."

#. assets_dev/engine/data_tables/items.txt record=616 field=Name status=translated
msgctxt "engine:items.txt:616:Name"
msgid "Anointed Herb Potion"
msgstr "축성된 약초 물약"

#. assets_dev/engine/data_tables/items.txt record=616 field=NotIdentifiedName status=translated
msgctxt "engine:items.txt:616:NotIdentifiedName"
msgid "Potion Bottle"
msgstr "물약병"

#. assets_dev/engine/data_tables/items.txt record=616 field=Notes status=translated
msgctxt "engine:items.txt:616:Notes"
msgid "Quest Item: Though possessing no magical properties, this potion's ingredients have been gathered under the most stringent ritual conditions. The thornbark powder, for example, was ground in a silver mortar from bark stripped during the peak of a high noon eclipse. The whole concoction has sat in the seer's personal shrine for more than a hundred years."
msgstr "퀘스트 아이템: 이 물약은 마법적인 효능은 없지만, 재료들은 매우 엄격한 의식 조건을 거쳐 모아졌습니다. 예를 들어 가시나무껍질 가루는 정오 일식의 절정기에 벗겨낸 나무껍질을 은제 절구에 갈아서 만든 것입니다. 이 물약 전체는 예언자의 개인 제단에 100년 넘게 보관되어 있었습니다."

#. assets_dev/engine/data_tables/items.txt record=617 field=Name status=translated
