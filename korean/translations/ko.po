msgctxt "engine:items.txt:69:NotIdentifiedName"
msgid "Mace"
msgstr "철퇴"

#. assets_dev/engine/data_tables/items.txt record=69 field=Notes status=translated
msgctxt "engine:items.txt:69:Notes"
msgid "As much a symbol of office as weapon, these finely crafted maces are carried by inner circle Sun Temple priests. Its highly decorated shaft belies the effectiveness of the gilded erudine-steel head."
msgstr "이 정교하게 제작된 철퇴는 무기이면서 동시에 직위를 상징하는 물건으로, 태양 사원의 핵심 사제들이 휴대합니다. 화려하게 장식된 자루와는 달리, 금박을 입힌 강철 철퇴는 뛰어난 위력을 자랑합니다."

#. assets_dev/engine/data_tables/items.txt record=6 field=Name status=translated
