#!/bin/sh
set -eu

data_root="${XDG_DATA_HOME:-$HOME/.local/share}"
state_dir="$data_root/openyamm"
settings_file="$state_dir/settings.ini"

mkdir -p "$state_dir/saves"

if [ ! -f "$settings_file" ]; then
    cp /app/share/openyamm/settings.ini "$settings_file"
fi

cd "$state_dir"
exec /app/bin/openyamm-bin "$@"
